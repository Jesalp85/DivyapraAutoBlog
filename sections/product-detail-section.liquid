<script>
(function() {
  const sid = '{{ section.id }}';

  /* ── Set main image (thumbnail click) ──
     Key fix: the hero <img> previously had a `srcset`, which made the browser
     ignore JS-set `.src` changes and keep re-resolving from srcset. We removed
     srcset from the hero markup, and here we also explicitly clear any srcset
     in case a theme/app injects one later, so .src always wins. ── */
  window.fdSetImage = function(thumb, sectionId) {
    const hero = document.getElementById('fd-hero-img-' + sectionId);
    if (!hero) return;
    hero.removeAttribute('srcset');
    hero.src = thumb.dataset.src;
    hero.alt = thumb.dataset.alt || '';

    const thumbsWrap = document.getElementById('fd-thumbs-' + sectionId);
    if (thumbsWrap) {
      thumbsWrap.querySelectorAll('.fd-thumb').forEach(t => t.classList.remove('fd-thumb--active'));
    }
    thumb.classList.add('fd-thumb--active');
    if (typeof thumb.scrollIntoView === 'function') {
      thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }
  };

  /* ── Qty ── */
  window.fdQtyChange = function(btn, delta, sectionId) {
    const inp = document.getElementById('fd-qty-' + sectionId);
    if (!inp) return;
    const cur = parseInt(inp.value, 10) || 1;
    inp.value = Math.max(1, cur + delta);
  };

  // Logger helper
  function logDebug(msg) {
    console.log("[FD DEBUG]", msg);
    if (window.location.href.indexOf('debug') > -1) {
      let box = document.getElementById('fd-debug-box');
      if (!box) {
        box = document.createElement('div');
        box.id = 'fd-debug-box';
        box.style.cssText = 'position:fixed;bottom:100px;left:10px;z-index:9999999;background:rgba(0,0,0,0.9);color:#0f0;padding:12px;font-family:monospace;font-size:11px;max-height:250px;overflow-y:auto;border:2px solid #0f0;border-radius:6px;width:320px;line-height:1.4;box-shadow:0 4px 20px rgba(0,0,0,0.5);';
        document.body.appendChild(box);
        
        const title = document.createElement('div');
        title.style.cssText = 'font-weight:bold;border-bottom:1px solid #0f0;margin-bottom:6px;padding-bottom:2px;';
        title.textContent = 'FD Sync Debug Logger';
        box.appendChild(title);
      }
      const item = document.createElement('div');
      item.textContent = new Date().toLocaleTimeString() + ': ' + msg;
      box.appendChild(item);
      box.scrollTop = box.scrollHeight;
    }
  }

  /* ── Re-entrancy guard to prevent variant sync infinite loops ──
     When fdSelectVariant or syncVariantToPDP runs, it sets _fdSyncing = true
     so that any change events it fires don't re-trigger the same sync path. ── */
  var _fdSyncing = false;

  /* ── Select variant ──
     Same srcset fix applied here: clear srcset before setting .src so the
     variant's image actually displays instead of being silently ignored. ── */
  window.fdSelectVariant = function(card, sectionId) {
    logDebug("fdSelectVariant called, cardId = " + (card ? card.dataset.variantId : 'null') + ", _fdSyncing = " + _fdSyncing);
    if (_fdSyncing) return; // prevent re-entrant calls
    _fdSyncing = true;
    try {
      const varId = card.dataset.variantId;
      console.log("Antigravity: fdSelectVariant called, varId =", varId);
      
      const variantsWrap = card.closest('.fd-variants') || document.getElementById('fd-variants-' + sectionId);
      logDebug("variantsWrap container found: " + !!variantsWrap);
      if (variantsWrap) {
        variantsWrap.querySelectorAll('.fd-variant-card').forEach(c => {
          c.classList.remove('fd-variant-card--active');
          c.setAttribute('aria-pressed', 'false');
        });
      }
      card.classList.add('fd-variant-card--active');
      card.setAttribute('aria-pressed', 'true');

      const sel = document.getElementById('fd-variant-select-' + sectionId);
      const inp = document.getElementById('fd-variant-input-' + sectionId);
      logDebug("sel element found: " + !!sel + ", inp element found: " + !!inp);
      if (sel) {
        sel.value = varId;
        // Dispatch change so theme scripts (price, availability) update — guard prevents loop
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      }
      if (inp) {
        inp.value = varId;
        inp.dispatchEvent(new Event('input', { bubbles: true }));
        inp.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // Update browser URL query parameter dynamically without page reload
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', varId);
        window.history.replaceState({ path: url.toString() }, '', url.toString());
        logDebug("URL variant param set to: " + varId);
      } catch(e) {
        console.warn('URL variant update failed', e);
      }

      const priceEl   = document.getElementById('fd-price-'   + sectionId) || document.querySelector('.fd-price-current');
      const compareEl = document.getElementById('fd-compare-' + sectionId) || document.querySelector('.fd-price-compare');
      if (priceEl   && card.dataset.price)   priceEl.textContent   = card.dataset.price;
      if (compareEl && card.dataset.compare) compareEl.textContent = card.dataset.compare;

      if (card.dataset.image) {
        const hero = document.getElementById('fd-hero-img-' + sectionId) || document.querySelector('.fd-hero-img, .fd-main-image img');
        logDebug("hero element found for image update: " + !!hero);
        if (hero) {
          hero.removeAttribute('srcset');
          hero.src = card.dataset.image;
          if (card.dataset.imageAlt) hero.alt = card.dataset.imageAlt;

          // Also sync the thumbnail strip's active state to the variant's image,
          // so the gallery stays visually consistent with the selected variant.
          const thumbsWrap = document.getElementById('fd-thumbs-' + sectionId) || document.querySelector('.fd-thumbs');
          if (thumbsWrap) {
            const matchingThumb = Array.from(thumbsWrap.querySelectorAll('.fd-thumb'))
              .find(t => t.dataset.src === card.dataset.image || (t.querySelector('img') && t.querySelector('img').src === card.dataset.image));
            if (matchingThumb) {
              thumbsWrap.querySelectorAll('.fd-thumb').forEach(t => t.classList.remove('fd-thumb--active'));
              matchingThumb.classList.add('fd-thumb--active');
              if (typeof matchingThumb.scrollIntoView === 'function') {
                matchingThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
              }
            }
          }
        }
      }

      const atcBtn = document.getElementById('fd-atc-btn-' + sectionId);
      if (atcBtn) {
        const available = card.dataset.available !== 'false';
        atcBtn.disabled = !available;
        atcBtn.textContent = available
          ? '{{ section.settings.add_to_cart_text }}'
          : '{{ section.settings.sold_out_text }}';
      }

      // Sync data-pid and input[name="id"] across all buttons/forms on the page
      document.querySelectorAll('[data-js-product-button-add-to-cart], .js_add_to_cart_button, .single_add_to_cart_button').forEach(b => {
        b.setAttribute('data-pid', varId);
      });
      document.querySelectorAll('form[action*="/cart/add"] input[name="id"], [data-js-product-variant-input]').forEach(input => {
        input.value = varId;
      });

      // Sync sticky ATC dropdown value SILENTLY (no event dispatch) to avoid
      // triggering the jQuery sticky-select change handler and creating a loop.
      const stickySelect = document.querySelector('.js_sticky_sl');
      logDebug("stickySelect element found: " + !!stickySelect);
      if (stickySelect && stickySelect.value !== varId) {
        stickySelect.value = varId;
        logDebug("stickySelect value updated to: " + varId);
        // Do NOT dispatch change here — the jQuery handler would re-call fdSyncVariantToPDP
      }

      // Manually sync sticky bar thumb image if present
      const stickyImg = document.querySelector('.sticky_atc_thumb img');
      if (stickyImg && card.dataset.image) {
        stickyImg.src = card.dataset.image;
        stickyImg.setAttribute('data-src', card.dataset.image);
        stickyImg.classList.remove('lazyload');
        stickyImg.classList.add('lazyloaded');
      }

      // Manually sync sticky bar price if present
      const stickyPriceEl = document.querySelector('.sticky_atc_price');
      if (stickyPriceEl) {
        const price = card.dataset.price;
        const compare = card.dataset.compare;
        if (price) {
          if (compare && compare !== price) {
            stickyPriceEl.innerHTML = `<span class="current">${price}</span> <span class="compare">${compare}</span>`;
          } else {
            stickyPriceEl.innerHTML = price;
          }
        }
      }
    } catch(err) {
      logDebug("Error in fdSelectVariant: " + err.message);
    } finally {
      _fdSyncing = false;
      logDebug("fdSelectVariant finished, _fdSyncing reset to false");
    }
  };

  // Sync variant updates from any sticky bar select or product form input back to main PDP cards.
  // Uses _fdSyncing guard to prevent infinite event loops:
  //   sticky-select change → syncVariantToPDP → fdSelectVariant → (silently sets sticky value) → done
  function syncVariantToPDP(varId) {
    if (!varId) return;
    const targetId = String(varId).trim();
    logDebug("syncVariantToPDP called with targetId = " + targetId);
    console.log("Antigravity: syncVariantToPDP called with targetId =", targetId);
    
    // Find container and matching variant card
    const container = document.getElementById('fd-variants-' + sid) || document.querySelector('[id^="fd-variants-"]');
    let card = container ? container.querySelector(`.fd-variant-card[data-variant-id="${targetId}"]`) : null;
    if (!card) {
      card = document.querySelector(`.fd-variant-card[data-variant-id="${targetId}"]`);
    }
    
    logDebug("card matching " + targetId + " found: " + !!card);
    if (card) {
      const parentContainer = card.closest('[id^="fd-variants-"]');
      const sectionId = parentContainer ? parentContainer.id.replace('fd-variants-', '') : sid;
      _fdSyncing = false; // Reset lock to execute variant selection
      window.fdSelectVariant(card, sectionId);
    }
  }
  window.fdSyncVariantToPDP = syncVariantToPDP;

  // Listen for sticky-bar select changes on the CAPTURING phase (fires before jQuery bubble handlers).
  // We only respond when NOT already syncing to avoid circular calls.
  ['change', 'input'].forEach(evtType => {
    document.addEventListener(evtType, function(e) {
      if (!e.target) return;
      
      // Log event targets of interest for debugging
      const isSticky = e.target.classList.contains('js_sticky_sl');
      const isHiddenInput = e.target.name === 'id' || e.target.id === 'fd-variant-input-' + sid;
      if (isSticky || isHiddenInput) {
        logDebug("Event caught: " + evtType + " on " + e.target.tagName + " (sticky: " + isSticky + ", hiddenInput: " + isHiddenInput + "), val = " + e.target.value + ", _fdSyncing = " + _fdSyncing);
      }
      
      if (_fdSyncing) return;
      
      // 1. Sticky ATC select or XBoost app select changed
      if (
        e.target.classList.contains('js_sticky_sl') ||
        e.target.classList.contains('xb-variant') ||
        e.target.id === 'xb-satc-variant-select' ||
        (e.target.closest && e.target.closest('#xb-satc-root') && e.target.tagName === 'SELECT')
      ) {
        syncVariantToPDP(e.target.value);
      }
      // 2. Hidden product variant ID input updated by theme scripts (but NOT by our own fdSelectVariant)
      // Only respond when the value differs from the currently active card to avoid echoes.
      else if (e.target.name === 'id' || e.target.id === 'fd-variant-input-' + sid) {
        const container = document.getElementById('fd-variants-' + sid);
        if (container) {
          const activeCard = container.querySelector('.fd-variant-card--active');
          if (!activeCard || activeCard.dataset.variantId !== e.target.value) {
            syncVariantToPDP(e.target.value);
          }
        }
      }
    }, true);
  });

  // Sync quantity from sticky footer to main quantity input (listening on capturing phase)
  document.addEventListener('change', function(e) {
    if (e.target && (e.target.classList.contains('js_sticky_qty') || e.target.classList.contains('xb-qty') || (e.target.closest && e.target.closest('#xb-satc-root') && e.target.tagName === 'INPUT' && e.target.type === 'number'))) {
      const mainQty = document.getElementById('fd-qty-' + sid);
      if (mainQty) {
        mainQty.value = e.target.value;
      }
    }
  }, true);

  // Sync quantity from main quantity input to sticky footer
  document.addEventListener('change', function(e) {
    if (e.target && e.target.id === 'fd-qty-' + sid) {
      const stickyQty = document.querySelector('.js_sticky_qty, .xb-qty, #xb-satc-root input[type="number"]');
      if (stickyQty) {
        stickyQty.value = e.target.value;
      }
    }
  }, true);

  // Fallback click handler to sync sticky add-to-cart button click to main ATC button
  document.addEventListener('click', function(e) {
    const stickyAtcBtn = e.target.closest('.sticky_atc_js, [data-js-product-button-add-to-cart], .xb-atc, #xb-satc-root button');
    if (stickyAtcBtn) {
      // Find quantity just in case before clicking
      const stickyQtyInp = document.querySelector('.js_sticky_qty, .xb-qty, #xb-satc-root input[type="number"]');
      const mainQtyInp = document.getElementById('fd-qty-' + sid);
      if (stickyQtyInp && mainQtyInp) {
        mainQtyInp.value = stickyQtyInp.value;
      }
      // Click the main PDP add-to-cart button
      const mainAtcBtn = document.getElementById('fd-atc-btn-' + sid);
      if (mainAtcBtn) {
        // Only trigger click if the clicked button is not the main button itself to avoid infinite loop
        if (stickyAtcBtn !== mainAtcBtn) {
          e.preventDefault();
          e.stopPropagation();
          if (typeof e.stopImmediatePropagation === 'function') {
            e.stopImmediatePropagation();
          }
          mainAtcBtn.click();
        }
      }
    }
  }, true);

  /* ── Keyboard nav for variant cards ── */
  document.addEventListener('keydown', function(e) {
    if ((e.key === 'Enter' || e.key === ' ') && e.target.classList.contains('fd-variant-card')) {
      e.preventDefault();
      e.target.click();
    }
  });

  /* ── Add to cart AJAX ──
     Passes `sections: 'minicart'` so Shopify returns fresh cart HTML
     atomically in the same response — no race condition, no stale cart on open.
  ── */
  window.fdAddToCart = async function(sectionId) {
    const btn      = document.getElementById('fd-atc-btn-' + sectionId);
    const varInput = document.getElementById('fd-variant-input-' + sectionId);
    const qtyInput = document.getElementById('fd-qty-' + sectionId);
    if (!btn || !varInput) return;

    if (btn.disabled || btn.dataset.adding === 'true') return;
    btn.dataset.adding = 'true';

    const originalText = btn.textContent.trim();
    btn.disabled    = true;
    btn.textContent = '{{ section.settings.adding_text }}';

    try {
      const addResp = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          items: [{
            id:       parseInt(varInput.value, 10),
            quantity: qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1
          }],
          sections:     'minicart',
          sections_url: window.location.pathname
        })
      });

      if (!addResp.ok) {
        const errData = await addResp.json().catch(() => ({}));
        throw new Error(errData.description || 'Cart error');
      }

      const data = await addResp.json();
      const cosmeticsCart = document.getElementById('js_cart_popup');

      if (data.sections && data.sections['minicart'] && cosmeticsCart) {
        const parser     = new DOMParser();
        const doc        = parser.parseFromString(data.sections['minicart'], 'text/html');
        const newSection = doc.querySelector('[id^="shopify-section"], .shopify-section');
        const oldSection = cosmeticsCart.querySelector('[id^="shopify-section"]');
        if (newSection && oldSection) {
          oldSection.innerHTML = newSection.innerHTML;
        } else if (newSection) {
          cosmeticsCart.innerHTML = newSection.outerHTML;
        }
      } else if (cosmeticsCart) {
        try {
          const secResp = await fetch('/?sections=minicart');
          if (secResp.ok) {
            const secData    = await secResp.json();
            const secHtml    = secData['minicart'];
            if (secHtml) {
              const parser     = new DOMParser();
              const doc        = parser.parseFromString(secHtml, 'text/html');
              const newSection = doc.querySelector('[id^="shopify-section"], .shopify-section');
              const oldSection = cosmeticsCart.querySelector('[id^="shopify-section"]');
              if (newSection && oldSection) oldSection.innerHTML = newSection.innerHTML;
              else if (newSection) cosmeticsCart.innerHTML = newSection.outerHTML;
            }
          }
        } catch (secErr) {
          console.warn('Minicart section fetch failed', secErr);
        }
      }

      try {
        const cart = await fetch('/cart.js').then(r => r.json());
        document.querySelectorAll(
          '[data-cart-count],[data-cart-item-count],.cart-count,.cart__count,' +
          '.header__cart-count,.js-cart-count,.cart-count-bubble,' +
          '.cart-item-count-header--quantity,#smart-cart-count'
        ).forEach(el => {
          el.textContent = cart.item_count;
          if (cart.item_count > 0) el.removeAttribute('hidden');
        });
        ['cart:updated', 'cartUpdated'].forEach(evt => {
          document.dispatchEvent(new CustomEvent(evt, { detail: { cart }, bubbles: true }));
          window.dispatchEvent(new CustomEvent(evt,  { detail: { cart }, bubbles: true }));
        });
      } catch (countErr) {
        console.warn('Cart count update failed', countErr);
      }

      if (cosmeticsCart) {
        cosmeticsCart.classList.add('act_opened');
        document.body.classList.add('pside_opened', 'js_cart_popup_open');
      }

      btn.textContent      = '{{ section.settings.added_text }}';
      btn.style.background = '#28a745';

      setTimeout(() => {
        btn.textContent      = originalText;
        btn.style.background = '';
        btn.disabled         = false;
      }, 2000);

    } catch (err) {
      console.error('ATC Error:', err);
      alert('Could not add to cart. Please try again.');
      btn.textContent      = originalText;
      btn.style.background = '';
      btn.disabled         = false;
    } finally {
      btn.dataset.adding   = 'false';
    }
  };

  /* ── Lightbox Slideshow ── */
  const lightboxImages = [
    {%- for image in product.images -%}
      "{{ image | img_url: '1200x1200' }}"{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];
  let curLightboxIndex = 0;

  window.fdOpenLightbox = function(sectionId) {
    const modal = document.getElementById('fd-lightbox-' + sectionId);
    if (!modal) return;
    
    let startIndex = 0;
    const thumbsWrap = document.getElementById('fd-thumbs-' + sectionId);
    if (thumbsWrap) {
      const activeThumb = thumbsWrap.querySelector('.fd-thumb--active');
      if (activeThumb) {
        const index = Array.from(thumbsWrap.querySelectorAll('.fd-thumb')).indexOf(activeThumb);
        if (index > -1) startIndex = index;
      }
    }
    
    modal.classList.add('fd-lightbox--open');
    document.body.classList.add('fd-lightbox-active');
    
    window.fdSetLightboxImg(startIndex, sectionId);
  };

  window.fdCloseLightbox = function(sectionId) {
    const modal = document.getElementById('fd-lightbox-' + sectionId);
    if (!modal) return;
    modal.classList.remove('fd-lightbox--open');
    document.body.classList.remove('fd-lightbox-active');
  };

  window.fdSetLightboxImg = function(index, sectionId) {
    if (index < 0 || index >= lightboxImages.length) return;
    curLightboxIndex = index;
    
    const img = document.getElementById('fd-lightbox-img-' + sectionId);
    if (img) {
      img.src = lightboxImages[index];
    }
    
    const thumbsWrap = document.getElementById('fd-lightbox-thumbs-' + sectionId);
    if (thumbsWrap) {
      thumbsWrap.querySelectorAll('.fd-lightbox-thumb').forEach((t, i) => {
        if (i === index) {
          t.classList.add('fd-lightbox-thumb--active');
          t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          t.classList.remove('fd-lightbox-thumb--active');
        }
      });
    }
  };

  window.fdChangeLightboxImg = function(delta, sectionId) {
    let nextIndex = curLightboxIndex + delta;
    if (nextIndex < 0) nextIndex = lightboxImages.length - 1;
    if (nextIndex >= lightboxImages.length) nextIndex = 0;
    window.fdSetLightboxImg(nextIndex, sectionId);
  };

  // Keyboard navigation for Lightbox
  document.addEventListener('keydown', function(e) {
    const modal = document.getElementById('fd-lightbox-' + sid);
    if (modal && modal.classList.contains('fd-lightbox--open')) {
      if (e.key === 'Escape') {
        window.fdCloseLightbox(sid);
      } else if (e.key === 'ArrowLeft') {
        window.fdChangeLightboxImg(-1, sid);
      } else if (e.key === 'ArrowRight') {
        window.fdChangeLightboxImg(1, sid);
      }
    }
  });

  // Hover Zoom Logic
  document.addEventListener("DOMContentLoaded", function() {
    const mainImgContainers = document.querySelectorAll('.fd-main-image');
    mainImgContainers.forEach(container => {
      const img = container.querySelector('.fd-hero-img');
      if (!img) return;
      
      container.addEventListener('mousemove', function(e) {
        if (window.matchMedia('(pointer: coarse)').matches) return;
        
        const rect = container.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const pctX = (x / rect.width) * 100;
        const pctY = (y / rect.height) * 100;
        
        img.style.transformOrigin = `${pctX}% ${pctY}%`;
        img.style.transform = 'scale(2.2)';
        img.style.cursor = 'zoom-in';
      });
      
      container.addEventListener('mouseleave', function() {
        img.style.transformOrigin = 'center center';
        img.style.transform = 'scale(1)';
        img.style.cursor = '';
      });
      
      container.addEventListener('click', function() {
        window.fdOpenLightbox(sid);
      });
    });
  });

  /* ── Pincode check ── */
  window.fdCheckPin = function(sectionId, availMsg, unavailMsg) {
    const inp    = document.getElementById('fd-pin-' + sectionId);
    const result = document.getElementById('fd-pin-result-' + sectionId);
    if (!inp || !result) return;
    const pin = inp.value.trim();
    if (!/^\d{6}$/.test(pin)) {
      result.textContent = '{{ section.settings.pin_invalid_msg }}';
      result.className   = 'fd-pin-result fd-pin-err';
      return;
    }
    result.textContent = '{{ section.settings.pin_checking_msg }}';
    result.className   = 'fd-pin-result';
    setTimeout(() => {
      result.textContent = availMsg.replace('{pin}', pin);
      result.className   = 'fd-pin-result fd-pin-ok';
    }, 600);
  };

  /* ── Urgency counter ── */
  {%- if section.settings.show_urgency -%}
  (function() {
    const el = document.getElementById('fd-sold-count-' + sid);
    if (el) {
      const min = {{ section.settings.urgency_min }};
      const max = {{ section.settings.urgency_max }};
      el.textContent = Math.floor(Math.random() * (max - min + 1)) + min + ' {{ section.settings.urgency_unit }}';
    }
  })();
  {%- endif -%}
})();
</script>

{%- assign seo_media = product.featured_media | default: product.featured_image -%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if seo_media -%}
      "image": [
        {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": "Divyaprabha Foods"
    },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
            "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
    {%- assign r_value = product.metafields.reviews.rating.value | default: product.metafields.reviews.rating -%}
    {%- assign r_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0 -%}
    {%- if r_count == 0 -%}
      {%- assign jg_badge = product.metafields.judgeme.badge -%}
      {%- if jg_badge contains 'data-average-rating' -%}
        {%- assign r_value = jg_badge | split: "data-average-rating='" | last | split: "'" | first -%}
        {%- assign r_count = jg_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0 -%}
      {%- endif -%}
    {%- endif -%}
    {%- if r_count > 0 -%}
      ,"aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ r_value }}",
        "reviewCount": {{ r_count }}
      }
    {%- endif -%}
  }
</script>


{% schema %}
{
  "name": "FD Product Detail",
  "tag": "section",
  "class": "fd-product-page-section",
  "settings": [
    { "type": "header", "content": "🎨 Colors" },
    { "type": "color", "id": "primary_color",             "label": "Primary / Brand Color",       "default": "#f3a222" },
    { "type": "color", "id": "accent_color",              "label": "Accent Color",                 "default": "#cc1226" },
    { "type": "color", "id": "text_color",                "label": "Text Color",                   "default": "#111111" },
    { "type": "color", "id": "background_color",          "label": "Section Background",           "default": "#ffffff" },
    { "type": "color", "id": "sale_badge_bg",             "label": "Sale Badge Background",        "default": "#d62628" },
    { "type": "color", "id": "sale_badge_text_color",     "label": "Sale Badge Text",              "default": "#ffffff" },
    { "type": "color", "id": "star_color",                "label": "Star Rating Color",            "default": "#f3a222" },
    { "type": "color", "id": "tag_bg_color",              "label": "Tag Background",               "default": "#f8f8f8" },
    { "type": "color", "id": "tag_text_color",            "label": "Tag Text Color",               "default": "#333333" },
    { "type": "header", "content": "🔘 Buttons" },
    { "type": "color", "id": "add_to_cart_bg",            "label": "Add to Cart Background",      "default": "#cc1226" },
    { "type": "color", "id": "add_to_cart_text_color",    "label": "Add to Cart Text",             "default": "#ffffff" },
    { "type": "color", "id": "add_to_cart_hover_bg",      "label": "Add to Cart Hover",            "default": "#a80e1e" },
    { "type": "color", "id": "buy_now_bg",                "label": "Buy Now Background",           "default": "#f3a222" },
    { "type": "color", "id": "buy_now_text_color",        "label": "Buy Now Text",                 "default": "#000000" },
    { "type": "header", "content": "🧱 Variant Cards" },
    { "type": "color", "id": "variant_active_border",     "label": "Active Variant Border",        "default": "#f3a222" },
    { "type": "color", "id": "variant_active_header_bg",  "label": "Active Variant Header BG",     "default": "#f3a222" },
    { "type": "header", "content": "✏️ Typography & Layout" },
    { "type": "range", "id": "base_font_size",   "label": "Base Font Size (px)", "min": 13, "max": 20, "step": 1, "default": 16 },
