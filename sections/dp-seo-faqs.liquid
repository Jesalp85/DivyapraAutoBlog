            "default": "<p>We use premium cold-pressed oils (such as cold-pressed mustard oil or peanut oil depending on the specific recipe) to retain natural health benefits and authentic Saurashtra flavor.</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "SEO FAQ Section",
        "category": "Custom",
        "blocks": [
          { "type": "faq" },
          { "type": "faq" },
          { "type": "faq" }
        ]
      }
    ]
  }
{% endschema %}
