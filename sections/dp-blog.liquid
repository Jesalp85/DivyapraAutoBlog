{% assign sid = section.id %}

<section id="laber_{{ sid }}" class="dp-blog-page">
  <!-- ===== HERO HEADER ===== -->
  <div class="dp-blog-hero">
    <div class="dp-blog-hero__overlay"></div>
    <div class="dp-blog-hero__content container">
      {%- if section.settings.hero_tag != blank -%}
        <span class="dp-blog-hero__tag">{{ section.settings.hero_tag | escape }}</span>
      {%- endif -%}
      {%- if section.settings.hero_title != blank -%}
        <h1 class="dp-blog-hero__title">{{ section.settings.hero_title }}</h1>
      {%- endif -%}
      {%- if section.settings.hero_sub != blank -%}
        <p class="dp-blog-hero__sub">{{ section.settings.hero_sub | escape }}</p>
      {%- endif -%}

      <!-- Search & Filter Bar -->
      <div class="dp-blog-search-wrap">
        <div class="dp-blog-search-bar">
          <svg class="dp-blog-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="dp-blog-search-input" placeholder="Search recipes, ingredients, spice secrets..." onkeyup="dpFilterArticles()">
          <button type="button" class="dp-blog-search-btn">Search</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== CATEGORY PILLS BAR ===== -->
  <div class="dp-blog-cats-bar">
    <div class="container">
      <div class="dp-blog-cats-list">
        <button class="dp-cat-pill active" onclick="dpSelectCategory('all', this)">All Stories</button>
        {% assign core_cats = "Heritage Recipes,Health & Spices,Buying Guides,Pickle Pairings,Artisanal Craft" | split: "," %}
        {% for cat_item in core_cats %}
          {% assign cat_clean = cat_item | strip %}
          {% assign cat_lower = cat_clean | downcase %}
          <button class="dp-cat-pill" onclick="dpSelectCategory('{{ cat_clean | handle }}', this)">
            {% if cat_lower contains 'heritage' %}🥭{% elsif cat_lower contains 'health' %}🌶️{% elsif cat_lower contains 'buy' %}🛒{% elsif cat_lower contains 'pair' %}🍱{% else %}🫙{% endif %} {{ cat_clean }}
          </button>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="container dp-blog-body">
    <div class="dp-blog-layout">
      <!-- MAIN CONTENT COLUMN -->
      <div class="dp-blog-main">
        
        {%- assign total_articles = blog.articles.size -%}

        {%- if blog.articles.size > 0 -%}
          <!-- FEATURED HERO ARTICLE (First Article) -->
          {%- assign featured_article = blog.articles.first -%}
          <div class="dp-featured-post" data-tags="{% for tag in featured_article.tags %}{{ tag | handle }} {% endfor %}" data-category="heritage-recipes">
            <div class="dp-featured-post__img">
              {%- assign feat_seo_alt = featured_article.title | escape | append: " - Focus Keyword: " | append: featured_article.tags.first -%}
              {%- if featured_article.image -%}
                <img src="{{ featured_article.image | image_url: width: 1000 }}" alt="{{ feat_seo_alt }}" loading="lazy">
              {%- else -%}
                <img src="https://cdn.shopify.com/s/files/1/0752/0904/8278/files/SpecialMangoBig.webp?v=1782721972" alt="{{ feat_seo_alt }}" loading="lazy">
              {%- endif -%}
              <span class="dp-badge dp-badge--featured">Featured Story</span>
            </div>
            <div class="dp-featured-post__content">
              <div class="dp-post-meta">
                <span class="dp-post-tag">{{ featured_article.tags.first | default: "Heritage Recipes" }}</span>
                <span class="dp-post-dot">•</span>
                <span class="dp-post-date">{{ featured_article.published_at | date: "%b %d, %Y" }}</span>
                <span class="dp-post-dot">•</span>
                <span class="dp-post-read">6 min read</span>
              </div>
              <h2 class="dp-featured-post__title">
                <a href="{{ featured_article.url }}">{{ featured_article.title }}</a>
              </h2>
              <p class="dp-featured-post__excerpt">
                {{ featured_article.excerpt_or_content | strip_html | truncate: 180 }}
              </p>
              <div class="dp-featured-post__footer">
                <div class="dp-author">
                  <div class="dp-author__avatar">👵</div>
                  <div class="dp-author__info">
                    <strong>Baa & The Kitchen Team</strong>
                    <span>Master Pickle Maker</span>
                  </div>
                </div>
                <a href="{{ featured_article.url }}" class="dp-btn dp-btn--sm">Read Full Story →</a>
              </div>
            </div>
          </div>

          <!-- ARTICLES GRID -->
          <div class="dp-blog-grid" id="dp-articles-container">
            {%- for article in blog.articles offset:1 -%}
              {%- assign tag_lower = article.tags | join: ' ' | downcase -%}
              <div class="dp-article-card" data-title="{{ article.title | downcase }}" data-tags="{% for tag in article.tags %}{{ tag | handle }} {% endfor %}" data-category="{% if tag_lower contains 'recipe' %}heritage-recipes{% elsif tag_lower contains 'spice' %}health-spices{% elsif tag_lower contains 'ghee' %}ghee-chutneys{% else %}baas-secrets{% endif %}">
                <div class="dp-article-card__media">
                  <a href="{{ article.url }}">
                    {%- assign card_seo_alt = article.title | escape | append: " - Focus Keyword: " | append: article.tags.first -%}
                    {%- if article.image -%}
                      <img src="{{ article.image | image_url: width: 600 }}" alt="{{ card_seo_alt }}" loading="lazy">
                    {%- else -%}
                      <img src="https://cdn.shopify.com/s/files/1/0752/0904/8278/files/Gor_Keri_500g.webp?v=1784831601" alt="{{ card_seo_alt }}" loading="lazy">
                    {%- endif -%}
                  </a>
                  <span class="dp-post-tag-badge">{{ article.tags.first | default: "Heritage Tale" }}</span>
                </div>
                <div class="dp-article-card__body">
                  <div class="dp-post-meta">
                    <span class="dp-post-date">{{ article.published_at | date: "%b %d, %Y" }}</span>
                    <span class="dp-post-dot">•</span>
                    <span class="dp-post-read">4 min read</span>
                  </div>
                  <h3 class="dp-article-card__title">
                    <a href="{{ article.url }}">{{ article.title }}</a>
                  </h3>
                  <p class="dp-article-card__excerpt">
                    {{ article.excerpt_or_content | strip_html | truncate: 120 }}
                  </p>
                  <div class="dp-article-card__footer">
                    <div class="dp-author-box">
                      <span class="dp-author-name" title="By {{ article.author | default: 'DivyaPrabha Kitchen' }}">By {{ article.author | default: "DivyaPrabha Kitchen" | replace: "Baa & The DivyaPrabha Culinary Team", "Baa & Culinary Team" }}</span>
                    </div>
                    <a href="{{ article.url }}" class="dp-read-link">
                      <span>Read Story</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

        {%- else -%}

          <!-- FALLBACK DEMO ARTICLES (Rendered when store has no published articles yet) -->
          <div class="dp-featured-post" data-category="heritage-recipes">
            <div class="dp-featured-post__img">
              <img src="{{ 'Traditional_receipe.webp' | asset_url }}" alt="Top 10 Homemade Pickles in India" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1610057099443-fde8c4d50f91?auto=format&fit=crop&w=1000&q=80';">
              <span class="dp-badge dp-badge--featured">Featured Story</span>
            </div>
            <div class="dp-featured-post__content">
              <div class="dp-post-meta">
                <span class="dp-post-tag">Heritage Recipes</span>
                <span class="dp-post-dot">•</span>
                <span class="dp-post-date">July 31, 2026</span>
                <span class="dp-post-dot">•</span>
                <span class="dp-post-read">7 min read</span>
              </div>
              <h2 class="dp-featured-post__title">
                <a href="#top-10-homemade-pickles-in-india">Top 10 Homemade Pickles in India: Authentic Taste, Traditional Methods & Cultural Flavours</a>
              </h2>
              <p class="dp-featured-post__excerpt">
                From Saurashtra’s Rajapuri Raw Mango Achar and Spicy Stuffed Red Chilli to Sweet Gorkeri and Gut-Soothing Nimbu Achar — discover India's top 10 most beloved traditional homemade pickles and why they hold a sacred place in every Indian home.
              </p>
              <div class="dp-featured-post__footer">
                <div class="dp-author">
                  <div class="dp-author__avatar">👵</div>
                  <div class="dp-author__info">
                    <strong>Baa & The Culinary Team</strong>
                    <span>Master Pickle Artisan</span>
                  </div>
                </div>
                <a href="#top-10-homemade-pickles-in-india" class="dp-btn dp-btn--sm">Read Full Story →</a>
              </div>
            </div>
          </div>

          <div class="dp-blog-grid" id="dp-articles-container">
            <!-- Demo Article 1 -->
            <div class="dp-article-card" data-title="why cold-pressed mustard oil is the soul of authentic indian pickles" data-category="preservation-tips">
              <div class="dp-article-card__media">
                <a href="#article-2">
                  <img src="https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?auto=format&fit=crop&w=600&q=80" alt="Cold-Pressed Mustard Oil" loading="lazy">
                </a>
                <span class="dp-post-tag-badge">Preservation Secrets</span>
              </div>
              <div class="dp-article-card__body">
                <div class="dp-post-meta">
                  <span class="dp-post-date">July 22, 2026</span>
                  <span class="dp-post-dot">•</span>
                  <span class="dp-post-read">4 min read</span>
                </div>
                <h3 class="dp-article-card__title">
                  <a href="#article-2">Why Cold-Pressed Mustard Oil is the Soul of Authentic Indian Pickles</a>
                </h3>
                <p class="dp-article-card__excerpt">
                  Refined oil ruins traditional achar. Learn how cold-pressed mustard oil naturally seals out oxygen, enhances spice infusion, and protects health.
                </p>
                <div class="dp-article-card__footer">
                  <span class="dp-author-name">By DivyaPrabha Team</span>
                  <a href="#article-2" class="dp-read-link">Read Story <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
                </div>
              </div>
            </div>

            <!-- Demo Article 2 -->
            <div class="dp-article-card" data-title="5 traditional indian chutneys that transform everyday ghar ka khana" data-category="ghee-chutneys">
              <div class="dp-article-card__media">
                <a href="#article-3">
                  <img src="https://images.unsplash.com/photo-1596797038530-2c107229654b?auto=format&fit=crop&w=600&q=80" alt="Traditional Indian Chutneys" loading="lazy">
                </a>
                <span class="dp-post-tag-badge">Ghee & Chutneys</span>
              </div>
              <div class="dp-article-card__body">
                <div class="dp-post-meta">
                  <span class="dp-post-date">July 15, 2026</span>
                  <span class="dp-post-dot">•</span>
                  <span class="dp-post-read">5 min read</span>
                </div>
                <h3 class="dp-article-card__title">
                  <a href="#article-3">5 Traditional Indian Chutneys That Transform Everyday Ghar Ka Khana</a>
                </h3>
                <p class="dp-article-card__excerpt">
                  From sun-dried Garlic Chutney to tangy Methi Lemon condiment, elevate your simple dal-rice into a royal feast.
                </p>
                <div class="dp-article-card__footer">
                  <span class="dp-author-name">By Baa's Kitchen</span>
                  <a href="#article-3" class="dp-read-link">Read Story <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
                </div>
              </div>
            </div>

            <!-- Demo Article 3 -->
            <div class="dp-article-card" data-title="the health secrets of traditional stone-ground spices" data-category="health-spices">
              <div class="dp-article-card__media">
                <a href="#article-4">
                  <img src="https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=600&q=80" alt="Stone Ground Spices" loading="lazy">
                </a>
                <span class="dp-post-tag-badge">Health & Spices</span>
              </div>
              <div class="dp-article-card__body">
                <div class="dp-post-meta">
                  <span class="dp-post-date">July 08, 2026</span>
                  <span class="dp-post-dot">•</span>
                  <span class="dp-post-read">5 min read</span>
                </div>
                <h3 class="dp-article-card__title">
                  <a href="#article-4">The Health Secrets of Traditional Stone-Ground Spices</a>
                </h3>
                <p class="dp-article-card__excerpt">
