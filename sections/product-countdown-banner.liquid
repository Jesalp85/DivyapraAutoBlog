{%- liquid
  assign sid = section.id
  assign sett_equal = section.settings.use_eq_height
  assign ck = section.settings.use_eq_height
  assign url = section.settings.button_link
%}

{%- for i in (1..1) -%}
  <section id="laber_{{sid}}" class="laber_product-countdown-banner_{{sid}}">
    <div class="container">
      <div class="laber_countdown_banner">
        <div class="row align-items-center">
          {%- assign url = section.settings.button_link -%}
          <div class="product_count_down col-12 col-md-6 col-lg-6">
            <div class="content-countdown">
              <div class="product-inner">
                {% if section.settings.title != blank or section.settings.sub_title != blank %}
                  <div class="wrap_title m-lg-0">
                    {% if section.settings.subtitle != blank %}
                      <p class="subtitles mb-2">
                        {{ section.settings.subtitle }}
                      </p>
                    {% endif %}
                    {% if section.settings.title != blank %}
                      <h5 class="title1">
                        {% if section.settings.title_span_text != blank %}
                          <span style="color: {{ section.settings.title_span_color }}">{{ section.settings.title_span_text }}</span>
                        {% endif %}
                        {{ section.settings.title }}
                      </h5>
                    {% endif %}
                    {% if section.settings.btn != blank %}
                      <div class="laber_button mt-3 mt-lg-4">
                        <a
                          class="button"
                          href="{%- if url != blank -%}{{ url | replace: 'shopify://', '' }}{%- else -%}#{% endif %}"
                          onMouseOver="this.style.backgroundColor='{{section.settings.bg_cl_hover}}'; this.style.color='{{section.settings.cl_btn_hover}}'"
                          onMouseOut="this.style.backgroundColor='{{section.settings.bg_cl}}'; this.style.color='{{section.settings.cl_btn}}'"
                          style="color:{{section.settings.cl_btn}}; background-color:{{section.settings.bg_cl}};">
                          {{ section.settings.btn }}
                        </a>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

              </div>
            </div>
          </div>
          <div class="product_count_down col-12 col-md-6 col-lg-6">
            <div class="content-countdown">
              <div class="alo-countdown  text-center text-lg-end">
                {%- if section.settings.year_count_down != blank and section.settings.month_count_down != blank and section.settings.day_count_down != blank -%}
                  <div
                    class="cms-countdown"
                    data-y="{{section.settings.year_count_down}}"
                    data-m="{{section.settings.month_count_down}}"
                    data-d="{{section.settings.day_count_down}}"
                    data-h="00"
                    data-i="00"
                    data-s="00"></div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endfor -%}
{%- render 'section_style' -%}
{%- schema -%}
  {
    "name": "Bannner countdown",
    "class": "cms_section type_product_countdown_banner",
    "settings": [
      {
        "type": "header",
        "content": "== Product Settings"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image",
        "info": "1920x700.jpg recommended"
      },
      {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      },
      {
        "type": "text",
        "id": "subtitle",
        "label": "Subtitle"
      }, {
        "type": "text",
        "id": "year_count_down",
        "label": "Year of countdown",
        "default": "2021"
      }, {
        "type": "text",
        "id": "month_count_down",
        "label": "Month of countdown",
        "default": "12"
      }, {
        "type": "text",
        "id": "day_count_down",
        "label": "Day of countdown",
        "default": "30"
      }, {
        "type": "text",
        "id": "btn",
        "label": "Button Text",
        "default": "Shop Now"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }, {
        "type": "header",
        "content": "== Style Button"
      }, {
        "type": "color",
        "id": "cl_btn",
        "label": "Button color ",
        "default": "#fff"
      }, {
        "type": "color",
        "id": "cl_btn_hover",
        "label": "Button color (hover)",
        "default": "#fff"
      }, {
        "type": "color",
        "id": "bg_cl",
        "label": "Button background color",
        "default": "#1a73e8"
      }, {
        "type": "color",
        "id": "bg_cl_hover",
        "label": "Button background color (hover)",
        "default": "#343e45"
      }, {
        "type": "header",
        "content": "== General Settings"
      }, {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Special Offers"
      }, {
        "type": "text",
        "id": "title_span_text",
        "label": "Span Text",
        "default": "50% Off "
      }, {
        "type": "color",
        "id": "title_span_color",
        "label": "Span Text Color",
        "default": "#F3F0FA"
      }, {
        "type": "text",
        "id": "mg",
        "label": "Margin",
        "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank"
      }, {
        "type": "text",
        "id": "pd",
        "label": "Padding",
        "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank"
      }, {
        "type": "header",
        "content": "== Design Mobile Options"
      }, {
        "type": "text",
        "id": "mg_mb",
        "label": "Margin"
      }, {
        "type": "text",
        "id": "pd_mb",
        "label": "Padding"
      }
    ],
    "presets": [
      {
        "name": "Bannner countdown",
        "category": "Countdown"
      }
    ]
  }
{% endschema %}