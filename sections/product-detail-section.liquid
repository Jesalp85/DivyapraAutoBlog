  box-shadow: 0 0 0 1px var(--fd-variant-active-border, #f3a222);
}
.fd-variant-card--active .fd-variant-header {
  background: var(--fd-variant-active-header, #f3a222);
  color: #000;
}
.fd-variant-best-badge {
  position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
  font-size: .72em; font-weight: 700;
  padding: 2px 10px; border-radius: 20px;
  white-space: nowrap;
}
.fd-variant-header {
  background: #f5f5f5; font-weight: 700; font-size: .9em;
  padding: 7px 6px 5px;
