    { "type": "range", "id": "card_gap", "label": "Card Gap (px)", "min": 4, "max": 40, "step": 2, "default": 16 },
    { "type": "range", "id": "padding_top", "label": "Top Padding Desktop (px)", "min": 0, "max": 100, "step": 4, "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom Padding Desktop (px)", "min": 0, "max": 100, "step": 4, "default": 60 },
