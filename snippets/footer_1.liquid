{%- for block in section.blocks -%}
  {%- capture Heading -%}  
                    {%- if block.settings.title != blank -%}
                       <h5 class="widget-title {{ block.settings.text_size }}">
                          <span class="txt_title alo-color alo-text-transform" style="--ui-color:{{ block.settings.cl_heading }};--ui-text-transform:{{ block.settings.text_transform }};">{{block.settings.title}}</span>
                          <span class="icon_mobile alo-color" style="--ui-color:{{ block.settings.cl_heading }};" ><i class="laber-icon-down icon-chevron-down"></i><i class="laber-icon-up icon-chevron-up"></i></span>
                        </h5>
                    {% endif %}  
                  {%- endcapture -%}
  {% case block.settings.col %}
    {% when '16%' %}
      {%- assign block_width = 'col-lg-2 col-md-6 col-12' -%}
    {% when '25%' %}
      {%- assign block_width = 'col-lg-3 col-md-6 col-12' -%}
    {% when '33%' %}
      {%- assign block_width = 'col-lg-4 col-md-6 col-12' -%}
    {% when '42%' %}
      {%- assign block_width = 'col-lg-5 col-md-6 col-12' -%}
    {% when '50%' %}
      {%- assign block_width = 'col-lg-6 col-md-6 col-12' -%}
    {% when '58%' %}
      {%- assign block_width = 'col-lg-7 col-md-6 col-12' -%}
    {% when '66%' %}
      {%- assign block_width = 'col-lg-8 col-md-6 col-12' -%}
    {% when '75%' %}
      {%- assign block_width = 'col-lg-9 col-md-6 col-12' -%}
    {% when '100%' %}
      {%- assign block_width = 'col-12' -%}
  {% endcase %}
  {%- case block.type -%}
    {%- when 'mail' -%}
      <div class="footer-iteam {{ block_width }} sm:mb-{{ block.settings.sm_mg_b }} mb-{{ block.settings.mg_b }}" {{ block.shopify_attributes }}>
        <aside
          id="block_{{block.id}}"
          class="labernewsletter widget widget_text alo-mail"
          style="--ui-border-radius:{{ block.settings.border }}px;--color-btn:{{ block.settings.cl_btn }};">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="widget_footer" style="--ui-color-text:{{block.settings.cl_text}};">
            {% if block.settings.sub_contact %}
              <div class="d-flex align-items-center gap-2 mb-2 mb-lg-3">
                <div class="icon-round">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none">
                    <path d="M16.2489 15.5304L15.8318 14.8339C15.0817 13.5971 14.0464 12.1776 12.6885 12.1776C12.4369 12.1776 12.1878 12.2282 11.9411 12.3307L11.2123 12.6432C11.1457 12.6708 11.081 12.7022 11.0126 12.7355C10.826 12.8262 10.6145 12.929 10.3969 12.929C9.86021 12.929 9.23834 12.2305 8.64615 10.9623C8.06497 9.71762 8.10204 9.06508 8.23545 8.73673C8.38267 8.37447 8.72499 8.21959 9.09276 8.08041C9.1439 8.06101 9.19009 8.04342 9.23501 8.02493L9.97306 7.71418C11.8959 6.9101 11.1805 4.10014 10.946 3.17889L10.7471 2.3868C10.5771 1.734 10.1262 0 8.63082 0C8.35398 0 8.05865 0.064496 7.75331 0.191774C7.55297 0.271334 4.79597 1.39672 3.79713 3.37382C2.60337 5.72716 2.8241 8.88296 4.45256 12.7515C6.06884 16.625 8.16473 18.9942 10.6821 19.7933C11.1139 19.9305 11.6019 19.9999 12.1326 19.9999H12.1329C13.8702 19.9999 15.585 19.2608 15.7242 19.1994C16.3232 18.9457 16.7103 18.5601 16.8749 18.0532C17.1538 17.1937 16.6859 16.2519 16.2489 15.5304ZM15.5877 17.6356C15.5495 17.7534 15.4165 17.8609 15.1928 17.9551C15.1891 17.9567 15.1846 17.9586 15.1808 17.9603C15.1653 17.9672 13.6131 18.647 12.1325 18.6469C11.7409 18.6469 11.3906 18.5988 11.0915 18.5037C8.97071 17.8305 7.15724 15.72 5.70035 12.2286C4.23264 8.7416 3.99811 5.96837 5.00425 3.98495C5.78551 2.43858 8.23139 1.45761 8.25539 1.44823C8.26026 1.44625 8.26504 1.44435 8.26982 1.44237C8.4091 1.38391 8.53394 1.35306 8.63082 1.35306C8.92894 1.35306 9.20028 1.81545 9.43607 2.72173L9.63407 3.51048C10.0613 5.18828 9.99624 6.23772 9.44933 6.46647L8.7148 6.77587C8.68557 6.78796 8.65139 6.80068 8.61368 6.81502C8.20794 6.96864 7.36363 7.28814 6.98179 8.22735C6.63532 9.0796 6.77874 10.1615 7.41983 11.535C8.28326 13.3835 9.25702 14.2821 10.3967 14.2821C10.9257 14.2821 11.3503 14.0757 11.604 13.9525C11.6507 13.9298 11.6924 13.909 11.7374 13.8904L12.4673 13.5774C12.5426 13.546 12.615 13.5307 12.6884 13.5307C13.0397 13.5307 13.6697 13.8786 14.673 15.5325L15.0898 16.2285C15.6035 17.0767 15.6441 17.4618 15.5877 17.6356Z" fill="#141516" />
                  </svg>
                </div>
                <h5 class="number-text">
                  <a href="tel:{{ block.settings.sub_contact}}" style="color: {{ block.settings.sub_contact_color }};">
                    {{ block.settings.sub_contact }}
                  </a>
                </h5>
              </div>
            {% endif %}
            {% if block.settings.sub_mail %}
              <div class="d-flex align-items-center gap-2">
                <div class="icon-round">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none">
                    <path d="M18.2422 2.96875H1.75781C0.786602 2.96875 0 3.76023 0 4.72656V15.2734C0 16.2455 0.792383 17.0312 1.75781 17.0312H18.2422C19.2053 17.0312 20 16.2488 20 15.2734V4.72656C20 3.76195 19.2165 2.96875 18.2422 2.96875ZM17.996 4.14062C17.6369 4.49785 11.4564 10.6458 11.243 10.8581C10.9109 11.1901 10.4695 11.3729 10 11.3729C9.53047 11.3729 9.08906 11.1901 8.75594 10.857C8.61242 10.7142 2.50012 4.63414 2.00398 4.14062H17.996ZM1.17188 15.0349V4.96582L6.23586 10.0031L1.17188 15.0349ZM2.00473 15.8594L7.06672 10.8296L7.9284 11.6867C8.48176 12.2401 9.21746 12.5448 10 12.5448C10.7825 12.5448 11.5182 12.2401 12.0705 11.6878L12.9333 10.8296L17.9953 15.8594H2.00473ZM18.8281 15.0349L13.7641 10.0031L18.8281 4.96582V15.0349Z" fill="#141516" />
                  </svg>
                </div>
                <p class="sub-mail">
                  {{ block.settings.sub_mail }}
                </p>
              </div>
            {% endif %}

            {% if block.settings.newsletter_lable %}
              <h5 class="newsletter_lable">
                {{ block.settings.newsletter_lable }}
              </h5>
            {% endif %}
            <div class="textwidget">
              <div class="footer-mail">
                {%- form 'customer'
                  , class: 'newsletter-form-footer' -%}
                  <input
                    type="hidden"
                    name="contact[tags]"
                    value="newsletter">
                  <div class="mc4wp-form-fields">
                    <div class="signup-newsletter-form  {{class}}">
                      <div class="col_email d-flex align-items-center">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 20 20"
                          fill="none">
                          <g clip-path="url(#clip0_11605_5926)">
                            <path d="M18.2422 2.96875L1.75781 2.96875C0.786602 2.96875 0 3.76023 0 4.72656L0 15.2734C0 16.2455 0.792383 17.0312 1.75781 17.0312H18.2422C19.2053 17.0312 20 16.2488 20 15.2734V4.72656C20 3.76195 19.2165 2.96875 18.2422 2.96875ZM17.996 4.14063C17.6369 4.49785 11.4564 10.6458 11.243 10.8581C10.9109 11.1901 10.4695 11.3729 10 11.3729C9.53047 11.3729 9.08906 11.1901 8.75594 10.857C8.61242 10.7142 2.50012 4.63414 2.00398 4.14062L17.996 4.14063ZM1.17187 15.0349L1.17188 4.96582L6.23586 10.0031L1.17187 15.0349ZM2.00473 15.8594L7.06672 10.8296L7.9284 11.6867C8.48176 12.2401 9.21746 12.5448 10 12.5448C10.7825 12.5448 11.5182 12.2401 12.0705 11.6878L12.9333 10.8296L17.9953 15.8594L2.00473 15.8594ZM18.8281 15.0349L13.7641 10.0031L18.8281 4.96582V15.0349Z" fill="#EAEAEC" />
                          </g>
                          <defs>
                            <clipPath id="clip0_11605_5926">
                              <rect
                                width="20"
                                height="20"
                                fill="white" />
                            </clipPath>
                          </defs>
                        </svg>
                        <input
                          type="email"
                          name="contact[email]"
                          placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
                          value="{% if customer %}{{ customer.email }}{% endif %}"
                          class="{{class_ip}} input-text"
                          required="required">
                      </div>
                      <div class="col_btn">
                        <button type="submit" class="submit-btn truncate{% if settings.checkbox_mail %} mail_agree pr{% endif %}">
                          <span>
                            {% comment %} {{ 'general.newsletter_form.submit' | t }} {% endcomment %}
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="20"
                              height="20"
                              viewBox="0 0 20 20"
                              fill="none">
                              <g clip-path="url(#clip0_12166_595)">
                                <path d="M19.8283 0.171647C19.6625 0.00586635 19.4138 -0.0451101 19.1963 0.041921L0.368218 7.57308C0.152789 7.65925 0.00853097 7.86441 0.00024974 8.09632C-0.00799243 8.32819 0.121382 8.54308 0.330132 8.64433L7.75465 12.2451L11.3555 19.6697C11.4537 19.8722 11.6588 19.9999 11.8826 19.9999C11.8895 19.9999 11.8965 19.9998 11.9035 19.9995C12.1353 19.9913 12.3406 19.847 12.4267 19.6316L19.9579 0.803599C20.045 0.585943 19.994 0.337389 19.8283 0.171647ZM2.03478 8.16862L16.9811 2.19016L8.07371 11.0974L2.03478 8.16862ZM11.8312 17.9651L8.90234 11.926L17.8097 3.01875L11.8312 17.9651Z" fill="#141516" />
                              </g>
                              <defs>
                                <clipPath id="clip0_12166_595">
                                  <rect
                                    width="20"
                                    height="20"
                                    fill="white" />
                                </clipPath>
                              </defs>
                            </svg>
                          </span>
                        </button>
                      </div>
                    </div>
                    {%- if settings.checkbox_mail -%}
                      {%- render 'conditions_mail'
                        , html: 'p'
                        , margin: 'mt__15'
                        , stt_link: settings.link_mail
                        , sid: sid
                      -%}
                    {%- endif -%}
                  </div>
                  <div class="mc4wp-response">
                    {%- if form.posted_successfully? -%}
                      <div class="shopify-message">
                        <i class="las la-check"></i>
                        {{ 'general.newsletter_form.confirmation' | t }}</div>
                    {%- elsif form.errors -%}
                      <div class="shopify-error">
                        <i class="las la-exclamation-triangle"></i>
                        {{ form.errors | default_errors }}</div>
                    {%- endif -%}
                  </div>
                {%- endform -%}
              </div>
            </div>
            {% if block.settings.use_social %}
              {% render 'social_link' %}
            {% endif %}
          </div>
        </aside>
      </div>
      {% style %}
        #block_{{ block.id }} .widget_mail .widget_footer .signup-newsletter-form .submit-btn {
          background: {{ block.settings.cl_sub }};
          border-color: {{ block.settings.cl_sub }};
        }
        #block_{{ block.id }}.widget_mail .widget_footer .signup-newsletter-form .submit-btn:hover {
          background: {{ block.settings.cl_sub_hover }};
          border-color: {{ block.settings.cl_sub_hover }};
        }
      {% endstyle %}
    {%- when 'text' -%}
      <div class="footer-iteam {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_text">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="textwidget widget_footer alo-color" style="--ui-color:{{ block.settings.cl_content }};">
            {{ block.settings.content }}
          </div>
        </aside>
      </div>
    {%- when 'contact_information' -%}
      <div class="footer-iteam contact_information {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_text">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="textwidget widget_footer">
            <div class="information">
              {%- if block.settings.text2 -%}
                <div class="Address" style="color:{{ block.settings.cl_text }}">{{ block.settings.text2 }}</div>
              {% endif %}
              {%- if block.settings.show_phone -%}
                <div class="wrap-phone">
                  <span class="icon" style="--fill:{{ block.settings.cl_phone }}">
                    <svg
                      height="50px"
                      viewBox="0 -9 512.00101 512"
                      width="50px"
                      xmlns="http://www.w3.org/2000/svg">
                      <path d="m484.847656 243.015625v-16.414063c0-60.285156-23.636718-117.121093-66.558594-160.042968-42.917968-42.921875-99.757812-66.558594-160.042968-66.558594-117.925782 0-217.183594 92.101562-225.96875 209.679688-.3125 4.15625 2.804687 7.773437 6.960937 8.082031 4.167969.316406 7.769531-2.804688 8.082031-6.957031 8.199219-109.75 100.851563-195.71875 210.925782-195.71875 56.257812 0 109.308594 22.066406 149.378906 62.136718 40.070312 40.070313 62.140625 93.121094 62.140625 149.378906v7.296876c-6.058594-2.695313-12.558594-4.570313-19.359375-5.476563v-1.820313c0-43.582031-14.328125-84.671874-41.429688-118.824218-2.585937-3.265625-7.332031-3.8125-10.597656-1.222656-3.261718 2.589843-3.808594 7.335937-1.21875 10.597656 24.964844 31.457031 38.160156 69.304687 38.160156 109.449218v1.171876h-18.984374v-6.972657c0-12.476562-10.148438-22.628906-22.625-22.628906h-12.871094c-12.476563 0-22.625 10.152344-22.625 22.628906v152.210938c0 12.476562 10.148437 22.625 22.625 22.625h12.871094c12.476562 0 22.625-10.148438 22.625-22.625v-3.15625h24.625c39.171874 0 71.039062-31.867188 71.039062-71.042969 0-22.609375-10.636719-42.777344-27.152344-55.796875zm-83.59375 129.996094c0 4.160156-3.382812 7.542969-7.542968 7.542969h-12.871094c-4.160156 0-7.542969-3.382813-7.542969-7.542969v-152.210938c0-4.160156 3.382813-7.542969 7.542969-7.542969h12.871094c4.160156 0 7.542968 3.382813 7.542968 7.542969zm39.707032-18.238281h-24.449219v-111.914063h24.449219c30.855468 0 55.957031 25.101563 55.957031 55.957031-.003907 30.855469-25.101563 55.957032-55.957031 55.957032zm0 0" /><path d="m302.902344 434.984375h-70.09375c-11.667969 0-21.296875 8.875-22.5 20.226563h-82.777344c-30.9375 0-56.109375-25.167969-56.109375-56.109376v-29.242187h24.242187v3.152344c0 12.476562 10.148438 22.628906 22.625 22.628906h12.871094c12.476563 0 22.625-10.152344 22.625-22.628906v-97.789063c0-4.167968-3.375-7.542968-7.542968-7.542968-4.164063 0-7.539063 3.375-7.539063 7.542968v97.789063c0 4.160156-3.382813 7.542969-7.542969 7.542969h-12.871094c-4.160156 0-7.542968-3.382813-7.542968-7.542969v-152.210938c0-4.160156 3.382812-7.542969 7.542968-7.542969h12.871094c4.160156 0 7.542969 3.382813 7.542969 7.542969v24.25c0 4.167969 3.375 7.542969 7.539063 7.542969 4.167968 0 7.542968-3.375 7.542968-7.542969v-24.25c0-12.476562-10.148437-22.625-22.625-22.625h-12.871094c-12.476562 0-22.625 10.148438-22.625 22.625v6.976563h-14.492187v-1.175782c0-47.054687 18.488281-91.453124 52.054687-125.019531 33.5625-33.566406 77.964844-52.050781 125.019532-52.050781 44.667968 0 87.382812 16.855469 120.273437 47.46875 3.050781 2.835938 7.820313 2.664062 10.660157-.382812 2.839843-3.050782 2.667968-7.820313-.382813-10.660157-35.691406-33.21875-82.054687-51.511719-130.550781-51.511719-51.082032 0-99.273438 20.054688-135.6875 56.46875-36.414063 36.414063-56.46875 84.605469-56.46875 135.6875v1.367188c-36.867188 2.550781-66.089844 33.34375-66.089844 70.847656 0 34.132813 24.199219 62.710938 56.335938 69.5v30.785156c0 39.257813 31.9375 71.195313 71.195312 71.195313h82.648438v2.023437c0 12.476563 10.152343 22.625 22.628906 22.625h70.09375c12.472656 0 22.625-10.148437 22.625-22.625v-14.710937c0-12.476563-10.148438-22.625-22.625-22.625zm-287.816406-136.167969c0-30.855468 25.101562-55.957031 55.953124-55.957031h24.449219v111.914063h-24.449219c-30.851562 0-55.953124-25.101563-55.953124-55.957032zm295.359374 173.503906c0 4.160157-3.382812 7.542969-7.542968 7.542969h-70.09375c-4.160156 0-7.542969-3.382812-7.542969-7.542969v-14.710937c0-4.160156 3.382813-7.542969 7.542969-7.542969h70.09375c4.160156 0 7.542968 3.382813 7.542968 7.542969zm0 0" />
                    </svg>
                  </span>
                  <p>
                    {%- if block.settings.text1 -%}
                      <span class="text" style="color:{{ block.settings.cl_text }}">{{ block.settings.text1 }}</span>
                    {%- endif %}
                    <a
                      class="phone"
                      href="tel:{{shop.phone}}"
                      style="color:{{ block.settings.cl_phone }}">
                      {{- shop.phone -}}
                    </a>
                  </p>
                </div>
              {% endif %}

              {%- if block.settings.show_email -%}
                <a
                  href="mailto:{{shop.email}}"
                  style="color:{{ block.settings.cl_text }}"
                  target="_blank">
                  {{- shop.email -}}
                </a>
              {% endif %}
              {% render 'social_link' %}
            </div>
          </div>
        </aside>
      </div>
    {%- when 'logo-footer' -%}
      <div class="footer-iteam footer-iteam-logo {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_text alo-logo-footer">
          {% if block.settings.use_logo_footer %}
            <div class="logo-footer">
              {% if block.settings.logo_footer != blank %}
                <a href="{{ routes.root_url }}" class="site-header__logo-image" aria-label="{{ shop.name }}">
                  {% capture image_size %}{{ block.settings.logo_max_width | escape }}{% endcapture %}
                  <img
                    loading="lazy"
                    src="{{ block.settings.logo_footer | img_url: image_size, scale: 2 }}"
                    alt="{{ logo_alt | escape }}"
                    style="max-width: {{ image_size }}px; width:auto; height:auto;">
                </a>
              {% else %}
                <a
                  class="site-title"
                  href="{{ routes.root_url }}"
                  itemprop="url">
                  <span class="logo-default">{{ shop.name }}</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
          {%- if block.settings.hotline -%}
            <div class="hotline">
              {{ block.settings.hotline }}
            </div>
          {% endif %}
          {%- if block.settings.content -%}
            <div class="content" style="--ui-color-text:{{ block.settings.text_color }};">
              {{ block.settings.content }}
            </div>
          {% endif %}
          {% if block.settings.use_social %}
            {% render 'social_link' %}
          {% endif %}
        </aside>
      </div>

    {%- when 'html' -%}
      <div class="footer-iteam {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_text ">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="textwidget widget_footer">
            {%- if block.settings.content != blank -%}
              <div class="contentHtml mb-20 alo-color" style="--ui-color:{{ block.settings.cl_content }};">
                {{ block.settings.content }}
              </div>
            {% endif %}
            <div class="ao-img mb-30" style="--ui-width:{{ block.settings.width_img }}px;">
              {% if block.settings.img %}
                {% render 'responsive-image'
                  , image: block.settings.img
                  , image_class: 'w-auto h-full' %}
              {%- endif -%}
            </div>
            {% if block.settings.use_social %}
              {% render 'social_link' %}
            {% endif %}
          </div>
        </aside>
      </div>
    {%- when 'social_network' -%}
      <div class="footer-iteam {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_text ">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="textwidget widget_footer">
            {%- if block.settings.content != blank -%}
              <div class="contentHtml mb-20 alo-color" style="--ui-color:{{ block.settings.cl_content }};">
                {{ block.settings.content }}
              </div>
            {% endif %}
            {% if block.settings.use_social %}
              {% render 'social_link' %}
            {% endif %}
          </div>
        </aside>
      </div>
    {%- when 'image' -%}
      <div class="footer-iteam {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_text ">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="textwidget widget_footer">
            <div class="image-footer">
              {%- assign image = block.settings.image %}
              {% assign url = block.settings.url -%}
              {%- if image != blank -%}
                {% render 'responsive-image'
                  , image: image
                  , aspect_ratio: aspect_ratio
                  , image_class: 'w-full h-full'
                  , url: url
                %}
              {%- else -%}
                {% if aspect_ratio != blank %}
                  {%- assign ratio = 1 | divided_by: aspect_ratio | times: 100 -%}
                {% else %}
                  {%- assign ratio = 100 -%}
                {% endif %}
                <div class="image-card__img overflow-hidden alo-border-radius ratio" style="--ui-border-radius:{{ border }}px;--ratio-percent: {{ ratio }}%;">
                  {% capture current %}{% cycle 1, 2, 3, 4, 5 %}{% endcapture %}
                  {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
                </div>
              {%- endif -%}
            </div>
          </div>
        </aside>
      </div>
    {%- when 'instagram' -%}
      <div class="footer-iteam {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_text ">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="textwidget widget_footer">
            <div class="instagram-footer row">
              {% render 'instagram_footer'
                , block: block.settings %}
            </div>
          </div>
        </aside>
      </div>
    {%- when 'menu' -%}
      <div class="footer-iteam {{ block_width }}" {{ block.shopify_attributes }}>
        <aside id="block_{{block.id}}" class="widget widget_nav_menu">
          {{ Heading | strip_newlines | remove: '  ' }}
          <div class="menu_footer widget_footer">
            {%- assign menu = block.settings.menu -%}
            {%- assign title_lower = block.settings.title | downcase -%}
            {%- if menu != blank -%}
              <ul class="menu">
                {%- for link in linklists[menu].links -%}
                  {%- assign item_title = link.title | split: '[' | first -%}
                  {%- assign target_url = link.url -%}
                  {%- assign item_check = item_title | downcase -%}
                  {%- if item_check contains 'track' -%}
                    {%- assign target_url = 'https://divyaprabhafoods.shiprocket.co/tracking' -%}
                  {%- endif -%}
                  {%- if title_lower contains 'company' or menu contains 'company' -%}
                    {%- assign item_title = item_title | downcase -%}
                  {%- endif -%}
                  <li class="menu-item{% if link.active %} active{% endif %}">
                    <a
                      class="alo-color alo-color-hover"
                      style="--ui-color:{{ block.settings.cl_link }};--ui-color-hover:{{ block.settings.cl_link_hover }};text-transform: capitalize;"
                      href="{{ target_url }}"{% if item_check contains 'track' %} target="_blank"{% endif %}>
                      {{- item_title }}
                      {% if link.object.all_products_count %}
                        <span class="n_products">({{ link.object.all_products_count }})</span>
                      {% endif %}
                    </a>
                  </li>
                {%- endfor -%}
                {%- if title_lower contains 'company' or menu contains 'company' -%}
                  <li class="menu-item{% if request.path contains '/blogs' %} active{% endif %}">
                    <a
                      class="alo-color alo-color-hover"
                      style="--ui-color:{{ block.settings.cl_link }};--ui-color-hover:{{ block.settings.cl_link_hover }};text-transform: capitalize;"
                      href="/blogs/news">
                      Blogs
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- else -%}
              You have not selected the footer menu
            {%- endif -%}
          </div>
        </aside>
      </div>
  {%- endcase -%}
{%- endfor -%}