{%- unless template == 'index' -%}
<nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
  <div class="outline-breadcrum">
    <div class="wrap-breadcrum">
      <div class="container">
        <div class="breadcrumb-inner" style="text-align: {{ section.settings.txt_align }};">
          
          <!-- Breadcrumb Trail -->
          <div class="breadcrumb-trail">
            <a href="/" title="Home">Home</a>
            
            {%- case template -%}
            
              {%- when 'product' -%}
                <!-- Product Page Breadcrumb -->
                <span class="separator" aria-hidden="true"> / </span>
                
                {%- comment -%} Try to get current collection from URL param {%- endcomment -%}
                {%- assign current_collection = collection -%}
                
                {%- comment -%} If no collection in context, try to get from product's collections {%- endcomment -%}
                {%- if current_collection == blank and product.collections.size > 0 -%}
                  {%- assign current_collection = product.collections | first -%}
                {%- endif -%}
                
                {%- if current_collection != blank -%}
                  <a href="{{ current_collection.url }}">{{ current_collection.title }}</a>
                  <span class="separator" aria-hidden="true"> / </span>
                {%- endif -%}
                
                <span class="current-page">{{ product.title }}</span>
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">{{ product.title }}</h1>
                {%- endif -%}
              
              {%- when 'collection' -%}
                <!-- Collection Page Breadcrumb -->
                <span class="separator" aria-hidden="true"> / </span>
                
                {%- if current_tags -%}
                  <a href="{{ collection.url }}">{{ collection.title }}</a>
                  <span class="separator" aria-hidden="true"> / </span>
                  <span class="current-page">{{ current_tags | join: ' + ' }}</span>
                {%- else -%}
                  <span class="current-page">{{ collection.title }}</span>
                {%- endif -%}
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">{{ collection.title }}</h1>
                {%- endif -%}
              
              {%- when 'blog' -%}
                <!-- Blog Listing Page Breadcrumb -->
                <span class="separator" aria-hidden="true"> / </span>
                <span class="current-page">{{ blog.title }}</span>
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">{{ blog.title }}</h1>
                {%- endif -%}
              
              {%- when 'article' -%}
                <!-- Article Page Breadcrumb -->
                <span class="separator" aria-hidden="true"> / </span>
                <a href="{{ blog.url }}">{{ blog.title }}</a>
                <span class="separator" aria-hidden="true"> / </span>
                <span class="current-page">{{ article.title }}</span>
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">{{ article.title }}</h1>
                {%- endif -%}
              
              {%- when 'page' -%}
                <!-- Regular Page Breadcrumb -->
                <span class="separator" aria-hidden="true"> / </span>
                <span class="current-page">{{ page.title }}</span>
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">{{ page.title }}</h1>
                {%- endif -%}
              
              {%- when 'search' -%}
                <!-- Search Page Breadcrumb -->
                <span class="separator" aria-hidden="true"> / </span>
                <span class="current-page">Search</span>
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">Search Results</h1>
                {%- endif -%}
              
              {%- when 'cart' -%}
                <!-- Cart Page Breadcrumb -->
                <span class="separator" aria-hidden="true"> / </span>
                <span class="current-page">Shopping Cart</span>
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">Shopping Cart</h1>
                {%- endif -%}
              
              {%- else -%}
                <!-- Default/Other Pages -->
                <span class="separator" aria-hidden="true"> / </span>
                <span class="current-page">{{ page_title }}</span>
                
                {%- if section.settings.show_title_page -%}
                  <h1 class="page-title">{{ page_title }}</h1>
                {%- endif -%}
              
            {%- endcase -%}
          </div>
          
        </div>
      </div>
    </div>
  </div>
</nav>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://{{ shop.domain }}"
    }
    {%- case template -%}
      {%- when 'product' -%}
        {%- assign current_collection = collection -%}
        {%- if current_collection == blank and product.collections.size > 0 -%}
          {%- assign current_collection = product.collections | first -%}
        {%- endif -%}
        {%- if current_collection != blank -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ current_collection.title | json }},
            "item": "https://{{ shop.domain }}{{ current_collection.url }}"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": "https://{{ shop.domain }}{{ product.url }}"
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": "https://{{ shop.domain }}{{ product.url }}"
          }
        {%- endif -%}
      {%- when 'collection' -%}
        {%- if current_tags -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "https://{{ shop.domain }}{{ collection.url }}"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ current_tags | join: ' + ' | json }},
            "item": "https://{{ shop.domain }}{{ collection.url }}/{{ current_tags | join: '+' }}"
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "https://{{ shop.domain }}{{ collection.url }}"
          }
        {%- endif -%}
      {%- when 'blog' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": "https://{{ shop.domain }}{{ blog.url }}"
        }
      {%- when 'article' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": "https://{{ shop.domain }}{{ blog.url }}"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }},
          "item": "https://{{ shop.domain }}{{ article.url }}"
        }
      {%- when 'page' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": "https://{{ shop.domain }}{{ page.url }}"
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page_title | json }},
          "item": "https://{{ shop.domain }}{{ request.path }}"
        }
    {%- endcase -%}
  ]
}
</script>
{%- endunless -%}

