    "dp_seo_faqs": {
      "type": "dp-seo-faqs",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Are DivyaPrabha Foods pickles handmade and preservative-free?",
            "answer": "<p>Yes, all DivyaPrabha Foods pickles are 100% handmade and prepared without any artificial preservatives, chemicals, or synthetic colors, following traditional Saurashtra home recipes to ensure authentic taste and healthiness.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Which oil is used in preparing your pickles?",
            "answer": "<p>We use premium quality oils, such as pure cold-pressed peanut oil or mustard oil depending on the specific recipe, to preserve the pickles naturally and enhance the traditional Saurashtra flavor profile.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "What is the shelf life of Saurashtra pickles and how should they be stored?",
            "answer": "<p>Our homemade pickles have a shelf life of 12 months from the date of packaging. To maintain their freshness, store them in a cool, dry place away from direct sunlight, and always use a clean, dry spoon to serve them.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Do you offer no-onion and no-garlic (Jain-friendly) pickle options?",
            "answer": "<p>Yes, we have specialized Jain-friendly pickle variants (such as our Gujarati Chhunda) prepared strictly without onion or garlic to cater to specific dietary preferences.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Are the pickle jars made of food-grade materials?",
            "answer": "<p>Absolutely. We pack all our homemade pickles in premium food-grade glass jars and containers to preserve their aroma, flavor, and freshness safely and sustainably.</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "What are the health benefits of eating handmade pickles daily?",
            "answer": "<p>Handmade pickles, especially those prepared via traditional sun-drying methods, are rich in natural antioxidants and beneficial bacteria (probiotics) that aid digestion, boost gut health, and improve immunity when consumed in moderation as part of a daily balanced diet.</p>"
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "question": "Do you use any artificial food colorings or flavors in your pickles?",
            "answer": "<p>No, we do not use any synthetic colors or artificial flavors. The vibrant red color of our pickles comes naturally from premium-grade Byadgi or Kashmiri red chili powder, and the yellow from pure turmeric powder.</p>"
          }
        },
        "faq_8": {
          "type": "faq",
          "settings": {
            "question": "Why is Saurashtra home-style preparation unique?",
            "answer": "<p>Our Saurashtra home-style pickles are unique because they are prepared in small batches using traditional sun-drying in barnis (porcelain jars). This slow process allows the spices to infuse deeply into the fruits, maintaining authentic flavor without needing any chemicals.</p>"
          }
        },
        "faq_9": {
          "type": "faq",
          "settings": {
            "question": "Are these pickles safe for kids and pregnant women?",
            "answer": "<p>Yes, since our pickles are 100% natural and made from high-quality cold-pressed oils and handpicked spices without preservatives, they are safe for children and pregnant women. However, due to the spice and oil levels, it is always recommended to consume them in moderate quantities.</p>"
          }
        }
      },
