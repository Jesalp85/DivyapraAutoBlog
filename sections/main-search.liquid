    { "type": "select", "id": "default_columns", "label": "Default Columns", "options": [{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}], "default": "3" },
    { "type": "checkbox", "id": "show_grid_toggle", "label": "Show Grid Toggle", "default": true },
