                  <span class="dp-author-name">By DivyaPrabha Team</span>
                  <a href="#article-5" class="dp-read-link">Read Story <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
                </div>
              </div>
            </div>

            <!-- Demo Article 5 -->
            <div class="dp-article-card" data-title="baa's 5 rules for storing pickles to keep them fresh for years" data-category="baas-secrets">
              <div class="dp-article-card__media">
                <a href="#article-6">
                  <img src="https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=600&q=80" alt="Pickle Storage Jar" loading="lazy">
                </a>
                <span class="dp-post-tag-badge">Baa's Kitchen Secrets</span>
              </div>
              <div class="dp-article-card__body">
                <div class="dp-post-meta">
                  <span class="dp-post-date">June 18, 2026</span>
                  <span class="dp-post-dot">•</span>
                  <span class="dp-post-read">3 min read</span>
                </div>
                <h3 class="dp-article-card__title">
                  <a href="#article-6">Baa's 5 Golden Rules for Storing Pickles to Keep Them Fresh for Years</a>
