        {%- endif -%}
      </div>

      <!-- SIDEBAR COLUMN -->
      <aside class="dp-blog-sidebar">
        <!-- Widget 1: About Kitchen -->
        <div class="dp-widget dp-widget--brand">
          <div class="dp-widget__header">
            <span class="dp-widget__icon">👵</span>
            <h4>From Baa's Kitchen</h4>
          </div>
          <p>
            At <strong>DivyaPrabha Foods</strong>, every jar is handcrafted in small batches using traditional Saurashtra sun-drying, cold-pressed oils, and hand-ground spices. Zero preservatives. 100% home love.
          </p>
          <a href="/pages/about-us" class="dp-widget-link">Our Heritage Story →</a>
        </div>

        <!-- Widget 2: Pickle Pairing Guide -->
        <div class="dp-widget dp-widget--pairing">
          <div class="dp-widget__header">
            <span class="dp-widget__icon">🫙</span>
            <h4>Perfect Pickle Pairings</h4>
          </div>
          <ul class="dp-pairing-list">
            {% assign pairing_collection = collections['all'] %}
            {% if pairing_collection.products.size > 0 %}
              {% for p_item in pairing_collection.products limit: 5 %}
                <li>
                  <a href="{{ p_item.url }}" style="text-decoration: none; color: inherit; display: block;">
                    <strong>{{ p_item.title }}</strong>
                    <span>Pairs best with: 
                      {% assign p_title_lower = p_item.title | downcase %}
                      {% if p_title_lower contains 'mango' or p_title_lower contains 'keri' %}
                        Hot Methi Thepla & Chai
                      {% elsif p_title_lower contains 'gor' or p_title_lower contains 'sweet' %}
                        Crispy Puri & Mathri
                      {% elsif p_title_lower contains 'garlic' or p_title_lower contains 'lasan' %}
                        Bajra Rotla & Fresh Butter
                      {% elsif p_title_lower contains 'chilli' or p_title_lower contains 'mirch' %}
                        Stuffed Paratha & Curd Rice
                      {% elsif p_title_lower contains 'gunda' %}
                        Kathiyawadi Thali & Khichdi
                      {% else %}
                        Dal Chawal & Fresh Ghee
                      {% endif %}
                    </span>
                  </a>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>

        <!-- Widget 3: Focus Keywords & Popular Topics -->
        <div class="dp-widget dp-widget--keywords">
          <div class="dp-widget__header">
            <span class="dp-widget__icon">🏷️</span>
            <h4>Focus Keywords & Topics</h4>
          </div>
          <div class="dp-blog-keywords-cloud">
            {% if blog.all_tags.size > 0 %}
              {% assign categories_filter = "Heritage Recipes,Health & Spices,Buying Guides,Pickle Pairings,Artisanal Craft" %}
              {% for tag in blog.all_tags %}
                {% assign tag_clean = tag | strip %}
                {% unless categories_filter contains tag_clean %}
                  <a href="{{ blog.url }}/tagged/{{ tag_clean | handle }}" class="dp-blog-keyword-pill">#{{ tag_clean }}</a>
                {% endunless %}
              {% endfor %}
            {% endif %}
          </div>
        </div>

        <!-- Widget 4: Recipe Newsletter -->
        <div class="dp-widget dp-widget--newsletter">
          <div class="dp-widget__header">
            <span class="dp-widget__icon">💌</span>
            <h4>Get Baa's Secret Recipes</h4>
          </div>
          <p>Subscribe for weekly heritage recipes, spice health tips, and exclusive pickle discount offers!</p>
          <form class="dp-newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to DivyaPrabha Kitchen Tales!');">
            <input type="email" placeholder="Enter your email address" required>
            <button type="submit" class="dp-btn dp-btn--full">Subscribe Free</button>
          </form>
        </div>
      </aside>
    </div>

  </div>
</section>

<script>
  function dpSelectCategory(cat, btn) {
    document.querySelectorAll('.dp-cat-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    
    const cards = document.querySelectorAll('.dp-article-card');
    const featured = document.querySelector('.dp-featured-post');
    
    cards.forEach(card => {
      const cardTags = card.getAttribute('data-tags') || card.getAttribute('data-category') || '';
      if (cat === 'all' || cardTags.includes(cat)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    if (featured) {
      const featuredTags = featured.getAttribute('data-tags') || featured.getAttribute('data-category') || '';
      if (cat === 'all' || featuredTags.includes(cat)) {
        featured.style.display = 'grid';
      } else {
        featured.style.display = 'none';
      }
    }
  }

  function dpFilterArticles() {
    const q = document.getElementById('dp-blog-search-input').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.dp-article-card');
    const featured = document.querySelector('.dp-featured-post');

    cards.forEach(card => {
      const title = card.getAttribute('data-title') || card.innerText.toLowerCase();
      if (!q || title.includes(q)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    if (featured) {
      const fText = featured.innerText.toLowerCase();
      if (!q || fText.includes(q)) {
        featured.style.display = 'grid';
      } else {
        featured.style.display = 'none';
      }
    }
  }
</script>

{%- style -%}
#laber_{{ sid }} {
  --dp-red: {{ section.settings.color_red | default: '#b01215' }};
  --dp-red-dark: #8c0e10;
  --dp-brown: {{ section.settings.color_brown | default: '#3d1f0f' }};
  --dp-gold: {{ section.settings.color_gold | default: '#e5a842' }};
  --dp-cream: {{ section.settings.color_cream | default: '#fff8ee' }};
  --dp-warm-bg: {{ section.settings.color_warm_bg | default: '#fdf6ed' }};
  --dp-text: {{ section.settings.color_text | default: '#2d1206' }};
  --dp-muted: {{ section.settings.color_muted | default: '#6b4c3b' }};
  --dp-border: {{ section.settings.color_border | default: '#e8d5c0' }};

  width: 100%;
  overflow-x: hidden;
}

#laber_{{ sid }} .container {
  max-width: 1360px;
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
  box-sizing: border-box;
}

#laber_{{ sid }} .dp-blog-hero {
  background: linear-gradient(135deg, #2d1206 0%, #3d1f0f 50%, #b01215 100%);
  color: #fff;
  padding: 60px 20px 50px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

#laber_{{ sid }} .dp-blog-hero__tag {
  display: inline-block;
  background: rgba(229, 168, 66, 0.15);
  color: var(--dp-gold);
  border: 1px solid rgba(229, 168, 66, 0.4);
  padding: 6px 16px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 16px;
}

#laber_{{ sid }} .dp-blog-hero__title {
  font-size: clamp(26px, 4vw, 42px);
  font-weight: 900;
  line-height: 1.25;
  color: #fff;
  margin: 0 0 14px;
}

#laber_{{ sid }} .dp-blog-hero__sub {
  font-size: clamp(14px, 1.8vw, 17px);
  color: rgba(255, 255, 255, 0.85);
  max-width: 720px;
  margin: 0 auto 28px;
