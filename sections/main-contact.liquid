{% liquid
  assign sid = section.id
%}
<section id="laber_{{sid}}">
  <div class="container {% if section.settings.layout == "full-width"%}{{section.settings.layout}}{% endif %}">
    <div class="main-content shop-page">
      <div class="content-form">
        <div class="row pr_center ">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'Contact' -%}
                <div class=" col-12 col-md-4 col-lg-4 contact-info">
                  <div class="contact-list-text">
                    <h6 class="title-form">{{ 'contact.information.phone' | t }}</h6>
                    <p>
                      <a class="phone" href="tel:{{shop.phone}}">{{ shop.phone }}</a>
                      {% if block.settings.phone -%}
                        <a class="phone" href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
                      {%- endif %}
                    </p>
                  </div>
                </div>
                <div class="col-12 col-md-4 col-lg-4 contact-info">
                  <div class="contact-list-text">
                    <h6 class="title-form">{{ 'contact.information.email' | t }}</h6>
                    <p>
                      <a href="mailto:{{shop.email}}">{{ shop.email }}</a>
                      {% if block.settings.email -%}
                        <a href="mailto:{{block.settings.email}}">{{ block.settings.email }}</a>
                      {%- endif %}
                    </p>
                  </div>
                </div>
                {% assign type_social = block.settings.type_social | plus: 0 %}
                {% if block.settings.header_use_social %}
                  <div class="col-12 col-md-4 col-lg-4 contact-info">
                    <h6 class="title-form mb-2 mb-lg-3">{{ 'contact.information.social' | t }}</h6>
                    {%- if type_social == 1 -%}
                      {% include 'social_link' %}
                    {%- else -%}
                      {% include 'social-sharing' %}
                    {%- endif -%}
                  </div>
                {% endif %}
              {%- when 'form_contact' -%}
                <div class="col-12">
                  <div class="information-form pt-80">
                    <div class="contact-form">
                      {% form 'contact'
                        , class: 'form-contact'
                        , id: 'contact-form' %}
                        {% if form.posted_successfully? %}
                          <div class="successForm feedback">
                            {{ 'contact.form.post_success' | t }}
                          </div>
                        {% endif %}
                        {% if form.errors %}
                          <div class="errorForm feedback">
                            <p>
                              Your contact form has {{ form.errors | size | pluralize: 'an error', 'a few errors' }}. To                                       
                                submit your form, make the following changes and try again:
                            </p>
                            {% for field in form.errors %}
                              <p>
                                The {{ field | capitalize | replace: 'Body', 'Message' }} field
                                {{ form.errors.messages[field] }}.
                              </p>
                            {% endfor %}
                          </div>
                        {% endif %}
                        <div class="mb-2 main-titles h4">{{ block.settings.right_title_block }}</div>
                        <div class="content">{{ block.settings.content }}</div>
                        <div class="row row-10">
                          <div class="col-xs-12 col-sm-12 pd-10">
                            <div class="input-info d-flex gap-2 align-items-center">
                              {% assign name_attr = 'contact.form.name' | t | handle %}
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="21"
                                viewBox="0 0 20 21"
                                fill="none">
                                <g clip-path="url(#clip0_22210_1147)">
                                  <path d="M10 0.5C7.09223 0.5 4.72656 2.86566 4.72656 5.77344C4.72656 8.68121 7.09223 11.0469 10 11.0469C12.9078 11.0469 15.2734 8.68121 15.2734 5.77344C15.2734 2.86566 12.9078 0.5 10 0.5ZM10 9.875C7.7384 9.875 5.89844 8.03504 5.89844 5.77344C5.89844 3.51184 7.7384 1.67188 10 1.67188C12.2616 1.67188 14.1016 3.51184 14.1016 5.77344C14.1016 8.03504 12.2616 9.875 10 9.875Z" fill="#45474F" />
                                  <path d="M16.5612 14.492C15.1174 13.0261 13.2035 12.2188 11.1719 12.2188H8.82812C6.79656 12.2188 4.88258 13.0261 3.43883 14.492C2.00215 15.9507 1.21094 17.8763 1.21094 19.9141C1.21094 20.2377 1.47328 20.5 1.79688 20.5H18.2031C18.5267 20.5 18.7891 20.2377 18.7891 19.9141C18.7891 17.8763 17.9979 15.9507 16.5612 14.492ZM2.40859 19.3281C2.70215 16.0045 5.46918 13.3906 8.82812 13.3906H11.1719C14.5308 13.3906 17.2979 16.0045 17.5914 19.3281H2.40859Z" fill="#45474F" />
                                </g>
                                <defs>
                                  <clipPath id="clip0_22210_1147">
                                    <rect
                                      width="20"
                                      height="20"
                                      fill="white"
                                      transform="translate(0 0.5)" />
                                  </clipPath>
                                </defs>
                              </svg>
                              <input
                                placeholder="{{'contact.form.name' | t}} "
                                class="border-0 w-100"
                                id="name"
                                required
                                name="contact[{{ name_attr }}]"
                                type="text"
                                value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.first_name }}{% endif %}">

                            </div>
                          </div>
                          <div class="col-xs-12 col-sm-12 pd-10">
                            <div class="input-info d-flex gap-2 align-items-center">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="21"
                                viewBox="0 0 20 21"
                                fill="none">
                                <path d="M18.2422 3.46875H1.75781C0.786602 3.46875 0 4.26023 0 5.22656V15.7734C0 16.7455 0.792383 17.5312 1.75781 17.5312H18.2422C19.2053 17.5312 20 16.7488 20 15.7734V5.22656C20 4.26195 19.2165 3.46875 18.2422 3.46875ZM17.996 4.64062C17.6369 4.99785 11.4564 11.1458 11.243 11.3581C10.9109 11.6901 10.4695 11.8729 10 11.8729C9.53047 11.8729 9.08906 11.6901 8.75594 11.357C8.61242 11.2142 2.50012 5.13414 2.00398 4.64062H17.996ZM1.17188 15.5349V5.46582L6.23586 10.5031L1.17188 15.5349ZM2.00473 16.3594L7.06672 11.3296L7.9284 12.1867C8.48176 12.7401 9.21746 13.0448 10 13.0448C10.7825 13.0448 11.5182 12.7401 12.0705 12.1878L12.9333 11.3296L17.9953 16.3594H2.00473ZM18.8281 15.5349L13.7641 10.5031L18.8281 5.46582V15.5349Z" fill="#45474F" />
                              </svg>
                              <input
                                placeholder="{{ 'contact.form.email' | t }} "
                                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                                required
                                name="contact[email]"
                                class="border-0 w-100"
                                id="email"
                                type="text">

                            </div>
                          </div>
                        </div>
                        <div class="input-info d-flex align-items-center gap-2">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="21"
                            viewBox="0 0 20 21"
                            fill="none">
                            <g clip-path="url(#clip0_22210_1150)">
                              <path d="M16.2489 16.0304L15.8318 15.3339C15.0817 14.0971 14.0464 12.6776 12.6885 12.6776C12.4369 12.6776 12.1878 12.7282 11.9411 12.8307L11.2123 13.1432C11.1457 13.1708 11.081 13.2022 11.0126 13.2355C10.826 13.3262 10.6145 13.429 10.3969 13.429C9.86021 13.429 9.23834 12.7305 8.64615 11.4623C8.06497 10.2176 8.10204 9.56508 8.23545 9.23673C8.38267 8.87447 8.72499 8.71959 9.09276 8.58041C9.1439 8.56101 9.19009 8.54342 9.23501 8.52493L9.97306 8.21418C11.8959 7.4101 11.1805 4.60014 10.946 3.67889L10.7471 2.8868C10.5771 2.234 10.1262 0.5 8.63082 0.5C8.35398 0.5 8.05865 0.564496 7.75331 0.691774C7.55297 0.771334 4.79597 1.89672 3.79713 3.87382C2.60337 6.22716 2.8241 9.38296 4.45256 13.2515C6.06884 17.125 8.16473 19.4942 10.6821 20.2933C11.1139 20.4305 11.6019 20.4999 12.1326 20.4999H12.1329C13.8702 20.4999 15.585 19.7608 15.7242 19.6994C16.3232 19.4457 16.7103 19.0601 16.8749 18.5532C17.1538 17.6937 16.6859 16.7519 16.2489 16.0304ZM15.5877 18.1356C15.5495 18.2534 15.4165 18.3609 15.1928 18.4551C15.1891 18.4567 15.1846 18.4586 15.1808 18.4603C15.1653 18.4672 13.6131 19.147 12.1326 19.1469C11.7409 19.1469 11.3906 19.0988 11.0915 19.0037C8.97071 18.3305 7.15724 16.22 5.70035 12.7286C4.23264 9.2416 3.99811 6.46837 5.00425 4.48495C5.78551 2.93858 8.23139 1.95761 8.25539 1.94823C8.26026 1.94625 8.26504 1.94435 8.26982 1.94237C8.4091 1.88391 8.53394 1.85306 8.63082 1.85306C8.92894 1.85306 9.20028 2.31545 9.43607 3.22173L9.63407 4.01048C10.0613 5.68828 9.99624 6.73772 9.44933 6.96647L8.7148 7.27587C8.68557 7.28796 8.65139 7.30068 8.61368 7.31502C8.20794 7.46864 7.36363 7.78814 6.9818 8.72735C6.63532 9.5796 6.77874 10.6615 7.41983 12.035C8.28326 13.8835 9.25702 14.7821 10.3967 14.7821C10.9257 14.7821 11.3503 14.5757 11.604 14.4525C11.6507 14.4298 11.6924 14.409 11.7374 14.3904L12.4673 14.0774C12.5426 14.046 12.615 14.0307 12.6884 14.0307C13.0397 14.0307 13.6697 14.3786 14.673 16.0325L15.0898 16.7285C15.6035 17.5767 15.6441 17.9618 15.5877 18.1356Z" fill="#45474F" />
                            </g>
                            <defs>
                              <clipPath id="clip0_22210_1150">
                                <rect
                                  width="20"
                                  height="20"
                                  fill="white"
                                  transform="translate(0 0.5)" />
                              </clipPath>
                            </defs>
                          </svg>
                          <input
                            required
                            type="tel"
                            id="ContactForm-phone"
                            class="border-0 w-100"
                            autocomplete="tel"
                            name="contact[{{ 'contact.form.phone' | t }}]"
                            pattern="[0-9\-]*"
                            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                            placeholder="{{ 'contact.form.phone' | t }} ">

                        </div>
                        <div class="field"></div>
                        <textarea
                          placeholder="{{ 'contact.form.message' | t }}"
                          rows="6"
                          class="input-info input-note"
                          name="contact[body]"
                          required
                          id="message"></textarea>

                        <div class="group-button text-lg-start">
                          <button class="btn" type="submit">
                            {{ 'contact.form.submit' | t }}
                          </button>
                        </div>
                      {% endform %}
                    </div>
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  <div class="map">
    {{ section.settings.map_iframe }}
  </div>
</section>
{%- render 'section_style' -%}
{% schema %}
  {
    "name": "Contact",
    "class": "cms_section contact-page",
    "blocks": [
      {
        "type": "Contact",
        "name": "Contact Us Detail",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "phone",
            "label": "Phone number",
            "default": "(+100) 666-456-7890"
          }, {
            "type": "text",
            "id": "email",
            "label": "Email",
            "default": "paradox@ui_paradox.com"
          }, {
            "type": "checkbox",
            "id": "header_use_social",
            "label": "Display social on top bar",
            "default": true,
            "info": "Note: you can edit social at 'Theme settings' -> 'Social media'"
          }, {
            "type": "select",
            "id": "type_social",
            "label": "Show sharing Or link:",
            "options": [
              {
                "value": "1",
                "label": "Social link"
              }, {
                "value": "2",
                "label": "Social sharing"
              }
            ],
            "default": "2"
          }
        ]
      }, {
        "type": "form_contact",
        "name": "Contact Form",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "right_title_block",
            "label": "Title of block",
            "default": "Get in touch"
          }, {
            "type": "textarea",
            "id": "content",
            "label": "Content",
            "default": "Commodo sociosqu venenatis cras dolor sagittis integer luctus maecenas."
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "use_contact_map",
        "label": "Show Google Map",
        "default": true
      },
      {
        "type": "textarea",
        "id": "map_iframe",
        "label": "Link Googlemap",
        "default": "<iframe width=\"2000\" height=\"400\" style=\"border:0\" src=\"https:\/\/www.google.com\/maps\/embed\/v1\/search?q=1200+Beverly+Street,+Mountain+View,+CA,+United+States&key=AIzaSyCeVrTUW_JTL2UKUT0-85wiwusOJZ48yMM\" allowfullscreen=\"\"><\/iframe>",
        "info": "* Edit width = 960px ; height = 890px"
      },
      {
        "type": "paragraph",
        "content": "* GUIDE TO EMBED GOOGLE MAP. Step 1: go to this link https:\/\/developers.google.com\/maps\/documentation\/embed\/start . Step 2: fill your address, press Enter and make following their instruction. Step 3: copy iframe code to above text area."
      },
      {
        "type": "header",
        "content": "== setting content"
      }, {
        "type": "select",
        "id": "layout",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "Container"
          }, {
            "value": "full-width",
            "label": "Full Width"
          }
        ],
        "label": "Layout"
      }, {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      }, {
        "type": "header",
        "content": "== setting content"
      }, {
        "type": "header",
        "content": "== Setting PC",
        "info": "Margin"
      }, {
        "type": "text",
        "id": "mg",
        "label": "Margin",
        "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank"
      }, {
        "type": "text",
        "id": "pd",
        "label": "Padding",
        "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank"
      }, {
        "type": "header",
        "content": "== Design Mobile Options"
      }, {
        "type": "text",
        "id": "mg_mb",
        "label": "Margin"
      }, {
        "type": "text",
        "id": "pd_mb",
        "label": "Padding"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}