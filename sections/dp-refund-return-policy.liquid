{% assign sid = section.id %}

<section id="laber_{{ sid }}" class="dp-rp-page">

  <!-- ===== HERO BANNER ===== -->
  <div class="dp-rp-hero">
    <div class="dp-rp-hero__overlay"></div>
    <div class="dp-rp-hero__content container">
      <h1 class="dp-rp-hero__title">{{ section.settings.hero_title | escape }}</h1>
      {%- if section.settings.hero_sub != blank -%}
        <p class="dp-rp-hero__sub">{{ section.settings.hero_sub | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- ===== QUICK POLICY HIGHLIGHTS ===== -->
  <div class="dp-rp-highlights container">
    <div class="dp-rp-highlights__grid">
      {%- assign highlights = section.blocks | where: 'type', 'highlight_card' -%}
      {%- for block in highlights -%}
        <div class="dp-rp-highlight-card" {{ block.shopify_attributes }}>
          <div class="dp-rp-highlight-card__icon">{{ block.settings.card_icon | escape }}</div>
          <h3>{{ block.settings.card_title | escape }}</h3>
          <p>{{ block.settings.card_desc | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- ===== REFUND & RETURN ACCORDION SECTION ===== -->
  <div class="dp-rp-body container">
    <div class="dp-section-head">
      {%- if section.settings.section_label != blank -%}
        <span class="dp-label">{{ section.settings.section_label | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.section_heading | escape }}</h2>
    </div>

    <div class="dp-rp-accordion-wrapper">
      {%- assign accordions = section.blocks | where: 'type', 'policy_accordion' -%}
      {%- for block in accordions -%}
        <div class="dp-rp-accordion-item" {{ block.shopify_attributes }}>
          <button class="dp-rp-accordion-header">
            <span>{{ block.settings.title | escape }}</span>
            <span class="dp-rp-accordion-icon">+</span>
          </button>
          <div class="dp-rp-accordion-content">
            <div class="dp-rp-accordion-content-inner">
              <p>{{ block.settings.content | newline_to_br }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- ===== CONTACT SUPPORT STRIP ===== -->
  <div class="dp-rp-contact-strip">
    <div class="container dp-rp-contact-strip__inner">
      <div class="dp-rp-contact-strip__text">
        <h2>{{ section.settings.contact_heading | escape }}</h2>
        <p>{{ section.settings.contact_sub | escape }}</p>
      </div>
      <div class="dp-rp-contact-strip__cta">
        {%- if section.settings.contact_btn1_text != blank -%}
          <a href="{{ section.settings.contact_btn1_link | default: '#' }}" class="dp-rp-btn dp-rp-btn--white">{{ section.settings.contact_btn1_text | escape }}</a>
        {%- endif -%}
        {%- if section.settings.contact_btn2_text != blank -%}
          <a href="{{ section.settings.contact_btn2_link | default: '/pages/contact' }}" class="dp-rp-btn dp-rp-btn--outline">{{ section.settings.contact_btn2_text | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

</section>

{%- style -%}
/* ======================================
   DIVYA PRABHA FOODS — REFUND & RETURN POLICY
   Premium Scoped Theme Layout
   ====================================== */

#laber_{{ sid }} {
  --dp-red: {{ section.settings.color_red }};
  --dp-red-dark: color-mix(in srgb, {{ section.settings.color_red }} 85%, black);
  --dp-brown: {{ section.settings.color_brown }};
  --dp-gold: {{ section.settings.color_gold }};
  --dp-cream: {{ section.settings.color_cream }};
  --dp-warm-bg: {{ section.settings.color_warm_bg }};
  --dp-text: {{ section.settings.color_text }};
  --dp-muted: {{ section.settings.color_muted }};
  --dp-border: {{ section.settings.color_border }};
}

.dp-rp-page {
  font-family: 'Inter', 'Gill Sans MT', sans-serif;
  color: var(--dp-text);
  background-color: var(--dp-warm-bg);
  overflow-x: hidden;
  padding-bottom: 0;
}

/* ---- HERO ---- */
.dp-rp-hero {
  position: relative;
  min-height: 45vh;
  background: linear-gradient(135deg, color-mix(in srgb, var(--dp-brown) 40%, black) 0%, var(--dp-brown) 40%, color-mix(in srgb, var(--dp-brown) 40%, var(--dp-red) 30%) 70%, var(--dp-brown) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}
.dp-rp-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='40' cy='40' r='20'/%3E%3C/g%3E%3C/svg%3E") repeat;
}
.dp-rp-hero__overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(176,18,21,0.2) 0%, transparent 80%);
}
.dp-rp-hero__content {
  position: relative;
  z-index: 2;
  max-width: 800px;
  padding: 80px 20px;
}
.dp-rp-hero__title {
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 16px;
}
.dp-rp-hero__sub {
  font-size: clamp(14px, 2vw, 18px);
  color: var(--dp-gold);
  font-weight: 500;
  letter-spacing: 0.5px;
  margin: 0;
}

/* ---- HIGHLIGHTS ROW ---- */
.dp-rp-highlights {
  margin-top: -50px;
  position: relative;
  z-index: 5;
  padding: 0 15px;
}
.dp-rp-highlights__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.dp-rp-highlight-card {
  background: #fff;
  border-radius: 20px;
  padding: 32px 24px;
  border: 1px solid var(--dp-border);
  box-shadow: 0 10px 30px rgba(61,31,15,0.06);
  text-align: center;
  transition: all 0.3s ease;
}
.dp-rp-highlight-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(61,31,15,0.12);
  border-color: var(--dp-gold);
}
.dp-rp-highlight-card__icon {
  font-size: 36px;
  margin-bottom: 16px;
}
.dp-rp-highlight-card h3 {
  font-size: 18px;
  font-weight: 700;
  color: var(--dp-brown);
  margin-bottom: 8px;
}
.dp-rp-highlight-card p {
  font-size: 14px;
  color: var(--dp-muted);
  line-height: 1.6;
  margin: 0;
}

/* ---- SECTION HEADS ---- */
.dp-label {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--dp-red);
  background: rgba(176,18,21,0.08);
  padding: 5px 14px;
  border-radius: 100px;
  margin-bottom: 16px;
}
.dp-section-head {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 50px;
}
.dp-section-head h2 {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 800;
  color: var(--dp-brown);
  line-height: 1.2;
  margin: 12px 0;
}

/* ---- ACCORDION SECTION ---- */
.dp-rp-body {
  padding: 80px 0;
  max-width: 800px;
}
.dp-rp-accordion-wrapper {
  background: #fff;
  border: 1px solid var(--dp-border);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 10px 40px rgba(61,31,15,0.05);
}
.dp-rp-accordion-item {
  border-bottom: 1px solid var(--dp-border);
}
.dp-rp-accordion-item:last-child {
  border-bottom: none;
}
.dp-rp-accordion-header {
  width: 100%;
  background: none;
  border: none;
  padding: 24px 32px;
  text-align: left;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 17px;
  font-weight: 700;
  color: var(--dp-brown);
  cursor: pointer;
  transition: all 0.3s ease;
}
.dp-rp-accordion-header:hover {
  background-color: var(--dp-cream);
  color: var(--dp-red);
}
.dp-rp-accordion-icon {
  font-size: 22px;
  color: var(--dp-red);
  transition: transform 0.3s ease;
  font-weight: 400;
}
.dp-rp-accordion-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
  background-color: var(--dp-warm-bg);
}
.dp-rp-accordion-content-inner {
  padding: 24px 32px;
  border-top: 1px solid rgba(232, 213, 192, 0.5);
}
.dp-rp-accordion-content-inner p {
  font-size: 15px;
  line-height: 1.75;
  color: var(--dp-muted);
  margin: 0;
}

/* Accordion Active state helper classes */
.dp-rp-accordion-item.active .dp-rp-accordion-header {
  background-color: var(--dp-cream);
  color: var(--dp-red);
}
.dp-rp-accordion-item.active .dp-rp-accordion-icon {
  transform: rotate(45deg);
}

/* ---- CONTACT STRIP ---- */
.dp-rp-contact-strip {
  background: linear-gradient(135deg, var(--dp-red-dark) 0%, var(--dp-red) 50%, #d32f2f 100%);
  padding: 60px 0;
  position: relative;
  overflow: hidden;
  text-align: left;
}
.dp-rp-contact-strip::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -100px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}
.dp-rp-contact-strip__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}
.dp-rp-contact-strip__text {
  flex: 1;
}
.dp-rp-contact-strip__text h2 {
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 12px;
}
.dp-rp-contact-strip__text p {
  font-size: 15px;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
  margin: 0;
}
.dp-rp-contact-strip__cta {
  flex-shrink: 0;
  display: flex;
  gap: 16px;
}
.dp-rp-btn {
  display: inline-block;
  background: var(--dp-red);
  color: #fff;
  padding: 14px 28px;
  border-radius: 100px;
  font-weight: 700;
  font-size: 15px;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 2px solid var(--dp-red);
  text-align: center;
}
.dp-rp-btn:hover {
  background: var(--dp-gold);
  border-color: var(--dp-gold);
  color: var(--dp-brown);
  transform: translateY(-2px);
}
.dp-rp-btn--white {
  background: #fff;
  color: var(--dp-brown);
  border-color: #fff;
}
.dp-rp-btn--white:hover {
  background: var(--dp-gold);
  border-color: var(--dp-gold);
  color: var(--dp-brown);
}
.dp-rp-btn--outline {
  background: transparent;
  color: #fff;
  border-color: rgba(255,255,255,0.5);
}
.dp-rp-btn--outline:hover {
  background: rgba(255,255,255,0.1);
  border-color: #fff;
}

/* ---- RESPONSIVE ---- */
@media (max-width: 991px) {
  .dp-rp-highlights__grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .dp-rp-highlights {
    margin-top: -30px;
  }
  .dp-rp-contact-strip__inner {
    flex-direction: column;
    text-align: center;
    gap: 24px;
  }
  .dp-rp-contact-strip__cta {
    width: 100%;
    justify-content: center;
  }
}
@media (max-width: 575px) {
  .dp-rp-accordion-header {
    padding: 20px 24px;
    font-size: 15px;
  }
  .dp-rp-accordion-content-inner {
    padding: 20px 24px;
  }
  .dp-rp-contact-strip__cta {
    flex-direction: column;
    width: 100%;
  }
  .dp-rp-btn {
    width: 100%;
  }
}
{%- endstyle -%}

<script>
document.addEventListener("DOMContentLoaded", function() {
  const headers = document.querySelectorAll('#laber_{{ sid }} .dp-rp-accordion-header');
  headers.forEach(header => {
    header.addEventListener('click', function() {
      const item = this.parentElement;
      const content = this.nextElementSibling;
      const isActive = item.classList.contains('active');
      
      // Close all other accordion items
      document.querySelectorAll('#laber_{{ sid }} .dp-rp-accordion-item').forEach(i => {
        if (i !== item) {
          i.classList.remove('active');
          i.querySelector('.dp-rp-accordion-content').style.maxHeight = null;
          i.querySelector('.dp-rp-accordion-icon').textContent = '+';
        }
      });
      
      // Toggle current item
      if (isActive) {
        item.classList.remove('active');
        content.style.maxHeight = null;
        this.querySelector('.dp-rp-accordion-icon').textContent = '+';
      } else {
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + "px";
        this.querySelector('.dp-rp-accordion-icon').textContent = '×';
      }
    });
  });
});
</script>

