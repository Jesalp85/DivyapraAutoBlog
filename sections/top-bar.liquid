{% if section.settings.home_page_only == false or template.name == 'index' %}
  {% if section.settings.header_use_top_header %}
    <div class="topbar {% if section.settings.hide_top_header_mobile %}hide-mobile{% endif %} {% if section.settings.show_close_btn %} show-close-button parent-close{% endif %}" style="background-color: {{ section.settings.bg_top_header }}; border-color: {{ section.settings.cl_bd_top_bar }}; color: {{ section.settings.cl_text }};">
      {% if section.settings.show_close_btn %}
        <span class="announcement-close btn-close">
          {% if section.settings.title_close_btn != blank %}
            <span class="title">{{ section.settings.title_close_btn }}</span>
          {% endif %}
          <i class="icon-btn-close icon-x">✕</i>
        </span>
      {% endif %}
      <div class="{{section.settings.layout}}">
        <div class="announcement-bar">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'message' -%}
                <div class="announcement-marquee">
                  <div class="announcement-marquee__track">
                    {%- for i in (1..3) -%}
                      {%- assign message_key = 'message_' | append: i -%}
                      {%- assign link_key = 'link_' | append: i -%}
                      {%- assign btn_link_key = 'btn_link_' | append: i -%}
                      
                      {%- if block.settings[message_key] != blank -%}
                        <span class="announcement-item">
                          {%- if block.settings[btn_link_key] != blank -%}
                            <a href="{{ block.settings[btn_link_key] }}" 
                               target="{{ block.settings.open_link }}"
                               class="announcement-link">
                              {{ block.settings[message_key] }}
                              {%- if block.settings[link_key] != blank -%}
                                <span class="link-text">{{ block.settings[link_key] }}</span>
                              {%- endif -%}
                            </a>
                          {%- else -%}
                            {{ block.settings[message_key] }}
                          {%- endif -%}
                        </span>
                        <span class="announcement-separator">|</span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- when 'banner' -%}
                {%- assign assign h_des = block.settings.h_des -%}
                {%- assign assign h_tb = block.settings.h_tb -%}
                {%- assign assign h_mb = block.settings.h_mb -%}
                {% assign image = block.settings.image_sl %}
                {% assign image_mobile = block.settings.image_mobile | default: block.settings.image_sl %}
                {% assign url = block.settings.link_img %}
                {% assign open_link = block.settings.open_link %}
                <div class="banner-top" style="--ui-height-pc:{{ h_des }}; --ui-height-tb:{{ h_tb }};--ui-height-mb:{{ h_mb }}">
                  {% if image != blank %}
                    <img src="{{ image | img_url: 'master' }}" alt="banner" style="width:100%; height:100%; object-fit:cover;">
                  {% else %}
                    <div class="image-card__img">
                      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {% endif %}
{% endif %}

