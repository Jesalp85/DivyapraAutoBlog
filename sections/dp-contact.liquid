{% assign sid = section.id %}

<section id="laber_{{ sid }}" class="dp-contact-page">

  <!-- ===== HERO BANNER ===== -->
  <div class="dp-contact-hero">
    <div class="dp-contact-hero__overlay"></div>
    <div class="dp-contact-hero__content container">
      <h1 class="dp-contact-hero__title">{{ section.settings.hero_title | escape }}</h1>
      {%- if section.settings.hero_sub != blank -%}
        <p class="dp-contact-hero__sub">{{ section.settings.hero_sub | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- ===== QUICK CONTACT HIGHLIGHTS ===== -->
  <div class="dp-contact-highlights container">
    <div class="dp-contact-highlights__grid">
      {%- assign highlights = section.blocks | where: 'type', 'highlight_card' -%}
      {%- for block in highlights -%}
        {%- if block.settings.card_link != blank -%}
          <a href="{{ block.settings.card_link }}" class="dp-contact-highlight-card" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="dp-contact-highlight-card" {{ block.shopify_attributes }}>
        {%- endif -%}
          <div class="dp-contact-highlight-card__icon">{{ block.settings.card_icon | escape }}</div>
          <h3>{{ block.settings.card_title | escape }}</h3>
          <p>{{ block.settings.card_desc | escape }}</p>
        {%- if block.settings.card_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- ===== SPLIT BODY GRID (CONTACT FORM & FAQ ACCORDION) ===== -->
  <div class="dp-contact-body container">
    <div class="dp-contact-grid">
      
      <!-- LEFT COLUMN: PREMIUM CONTACT FORM -->
      <div class="dp-contact-form-card" data-aos="fade-right">
        <h2>{{ section.settings.form_heading | escape }}</h2>
        
        {% form 'contact', class: 'form-contact', id: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div class="feedback success">
              {{ 'contact.form.post_success' | t | default: "Thank you! Your message has been sent successfully." }}
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="feedback error">
              <p>
                Your message could not be sent. Please correct the following errors and try again:
              </p>
              {% for field in form.errors %}
                <p>
                  The {{ field | capitalize | replace: 'Body', 'Message' }} field {{ form.errors.messages[field] }}.
                </p>
              {% endfor %}
            </div>
          {% endif %}

          <div class="form-group">
            <label for="ContactForm-name">Your Name</label>
            <input
              type="text"
              id="ContactForm-name"
              name="contact[name]"
              placeholder="Enter your full name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="form-group">
            <label for="ContactForm-email">Your Email</label>
            <input
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              placeholder="Enter your email address"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>

          <div class="form-group">
            <label for="ContactForm-phone">Your Phone Number</label>
            <input
              type="tel"
              id="ContactForm-phone"
              name="contact[phone]"
              placeholder="Enter your phone number (e.g. +91 98765 43210)"
              pattern="[0-9+\-\s]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </div>

          <div class="form-group">
            <label for="ContactForm-message">Your Message</label>
            <textarea
              id="ContactForm-message"
              name="contact[body]"
              rows="5"
              placeholder="How can we help you? Describe your query..."
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="dp-contact-btn">Send Message</button>
        {% endform %}
      </div>

      <!-- RIGHT COLUMN: INTERACTIVE FAQ ACCORDION -->
      <div class="dp-contact-faq-column" data-aos="fade-left">
        <div class="dp-section-head">
          {%- if section.settings.section_label != blank -%}
            <span class="dp-label">{{ section.settings.section_label | escape }}</span>
          {%- endif -%}
          <h2>{{ section.settings.section_heading | escape }}</h2>
        </div>

        <div class="dp-contact-faq-wrapper">
          {%- assign accordions = section.blocks | where: 'type', 'faq_accordion' -%}
          {%- for block in accordions -%}
            <div class="dp-contact-faq-item" {{ block.shopify_attributes }}>
              <button class="dp-contact-faq-header">
                <span>{{ block.settings.title | escape }}</span>
                <span class="dp-contact-faq-icon">+</span>
              </button>
              <div class="dp-contact-faq-content">
                <div class="dp-contact-faq-content-inner">
                  <p>{{ block.settings.content | newline_to_br }}</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>

  <!-- ===== GOOGLE MAPS IFRAME ===== -->
  {%- if section.settings.use_map and section.settings.map_iframe != blank -%}
    <div class="dp-contact-map">
      {{ section.settings.map_iframe }}
    </div>
  {%- endif -%}

</section>

{%- style -%}
/* ======================================
   DIVYA PRABHA FOODS — CONTACT US
   Premium Scoped Theme Layout
   ====================================== */

#laber_{{ sid }} {
  --dp-red: {{ section.settings.color_red }};
  --dp-red-dark: color-mix(in srgb, {{ section.settings.color_red }} 85%, black);
  --dp-brown: {{ section.settings.color_brown }};
  --dp-gold: {{ section.settings.color_gold }};
  --dp-cream: {{ section.settings.color_cream }};
  --dp-warm-bg: {{ section.settings.color_warm_bg }};
  --dp-text: {{ section.settings.color_text }};
  --dp-muted: {{ section.settings.color_muted }};
  --dp-border: {{ section.settings.color_border }};
}

.dp-contact-page {
  font-family: 'Inter', 'Gill Sans MT', sans-serif;
  color: var(--dp-text);
  background-color: var(--dp-warm-bg);
  overflow-x: hidden;
  padding-bottom: 0;
}

/* --- Container Style --- */
.dp-contact-page .container {
  width: 100%;
  max-width: 1240px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 24px;
  padding-right: 24px;
  box-sizing: border-box;
}

@media (max-width: 768px) {
  .dp-contact-page .container {
    padding-left: 20px;
    padding-right: 20px;
  }
}

/* ---- HERO ---- */
.dp-contact-hero {
  position: relative;
  min-height: 45vh;
  background: linear-gradient(135deg, color-mix(in srgb, var(--dp-brown) 40%, black) 0%, var(--dp-brown) 40%, color-mix(in srgb, var(--dp-brown) 40%, var(--dp-red) 30%) 70%, var(--dp-brown) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}
.dp-contact-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='40' cy='40' r='20'/%3E%3C/g%3E%3C/svg%3E") repeat;
}
.dp-contact-hero__overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(176,18,21,0.2) 0%, transparent 80%);
}
.dp-contact-hero__content {
  position: relative;
  z-index: 2;
  max-width: 800px;
  padding: 80px 20px;
}
.dp-contact-hero__title {
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 16px;
}
.dp-contact-hero__sub {
  font-size: clamp(14px, 2vw, 18px);
  color: var(--dp-gold);
  font-weight: 500;
  letter-spacing: 0.5px;
  margin: 0;
}

/* ---- HIGHLIGHTS ROW ---- */
.dp-contact-highlights {
  margin-top: -50px;
  position: relative;
  z-index: 5;
  padding: 0 15px;
}
.dp-contact-highlights__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.dp-contact-highlight-card {
  background: #fff;
  border-radius: 20px;
  padding: 32px 24px;
  border: 1px solid var(--dp-border);
  box-shadow: 0 10px 30px rgba(61,31,15,0.06);
  text-align: center;
  transition: all 0.3s ease;
  text-decoration: none;
  display: block;
}
.dp-contact-highlight-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(61,31,15,0.12);
  border-color: var(--dp-gold);
}
.dp-contact-highlight-card__icon {
  font-size: 36px;
  margin-bottom: 16px;
}
.dp-contact-highlight-card h3 {
  font-size: 18px;
  font-weight: 700;
  color: var(--dp-brown);
  margin-bottom: 8px;
}
.dp-contact-highlight-card p {
  font-size: 14px;
  color: var(--dp-muted);
  line-height: 1.6;
  margin: 0;
}

/* ---- SECTION HEADS ---- */
.dp-label {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--dp-red);
  background: rgba(176,18,21,0.08);
  padding: 5px 14px;
  border-radius: 100px;
  margin-bottom: 16px;
}
.dp-section-head {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 30px;
}
.dp-section-head h2 {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 800;
  color: var(--dp-brown);
  line-height: 1.25;
  margin: 12px 0;
}

/* ---- SPLIT GRID ---- */
.dp-contact-body {
  padding: 80px 0 0;
}
.dp-contact-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 48px;
  align-items: start;
}

/* ---- CONTACT FORM CARD ---- */
.dp-contact-form-card {
  background: #fff;
  border: 1px solid var(--dp-border);
  border-radius: 24px;
  padding: 48px;
  box-shadow: 0 10px 40px rgba(61,31,15,0.05);
}
.dp-contact-form-card h2 {
  font-size: 28px;
  font-weight: 800;
  color: var(--dp-brown);
  margin-bottom: 28px;
}
.dp-contact-form-card .form-group {
  margin-bottom: 20px;
}
.dp-contact-form-card label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--dp-muted);
  margin-bottom: 8px;
}
.dp-contact-form-card input,
.dp-contact-form-card textarea {
  width: 100%;
  padding: 14px 18px;
  border: 1px solid var(--dp-border);
  border-radius: 12px;
  font-family: inherit;
  font-size: 15px;
  color: var(--dp-text);
  background-color: var(--dp-warm-bg);
  transition: all 0.3s ease;
  box-sizing: border-box;
}
.dp-contact-form-card input:focus,
.dp-contact-form-card textarea:focus {
  outline: none;
  border-color: var(--dp-red);
  background-color: #fff;
  box-shadow: 0 0 0 4px rgba(176,18,21,0.1);
}
.dp-contact-btn {
  display: inline-block;
  background: var(--dp-red);
  color: #fff;
  padding: 16px 36px;
  border-radius: 100px;
  font-weight: 700;
  font-size: 16px;
  border: 2px solid var(--dp-red);
  cursor: pointer;
  transition: all 0.3s ease;
  width: 100%;
  text-align: center;
}
.dp-contact-btn:hover {
  background: var(--dp-gold);
  border-color: var(--dp-gold);
  color: var(--dp-brown);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(176,18,21,0.2);
}
.dp-contact-form-card .feedback {
  padding: 16px;
  border-radius: 12px;
  margin-bottom: 24px;
  font-size: 14px;
  font-weight: 600;
}
.dp-contact-form-card .feedback.success {
  background-color: #e6f4ea;
  color: #137333;
  border: 1px solid #c2e7c9;
}
.dp-contact-form-card .feedback.error {
  background-color: #fce8e6;
  color: #c5221f;
  border: 1px solid #fad2cf;
}

/* ---- FAQ ACCORDION SECTION ---- */
.dp-contact-faq-wrapper {
  background: #fff;
  border: 1px solid var(--dp-border);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 10px 40px rgba(61,31,15,0.05);
}
.dp-contact-faq-item {
  border-bottom: 1px solid var(--dp-border);
}
.dp-contact-faq-item:last-child {
  border-bottom: none;
}
.dp-contact-faq-header {
  width: 100%;
  background: none;
  border: none;
  padding: 24px 32px;
  text-align: left;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 17px;
  font-weight: 700;
  color: var(--dp-brown);
  cursor: pointer;
  transition: all 0.3s ease;
}
.dp-contact-faq-header:hover {
  background-color: var(--dp-cream);
  color: var(--dp-red);
}
.dp-contact-faq-icon {
  font-size: 22px;
  color: var(--dp-red);
  transition: transform 0.3s ease;
  font-weight: 400;
}
.dp-contact-faq-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
  background-color: var(--dp-warm-bg);
}
.dp-contact-faq-content-inner {
  padding: 24px 32px;
  border-top: 1px solid rgba(232, 213, 192, 0.5);
}
.dp-contact-faq-content-inner p {
  font-size: 15px;
  line-height: 1.75;
  color: var(--dp-muted);
  margin: 0;
}
.dp-contact-faq-item.active .dp-contact-faq-header {
  background-color: var(--dp-cream);
  color: var(--dp-red);
}
.dp-contact-faq-item.active .dp-contact-faq-icon {
  transform: rotate(45deg);
}

/* ---- MAP SECTION ---- */
.dp-contact-map {
  width: 100%;
  margin-top: 80px;
  line-height: 0;
  position: relative;
  border-top: 4px solid var(--dp-red);
}
.dp-contact-map iframe {
  width: 100%;
  height: 450px;
  border: none;
  display: block;
}

/* ---- RESPONSIVE ---- */
@media (max-width: 1024px) {
  .dp-contact-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

@media (max-width: 991px) {
  .dp-contact-highlights__grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .dp-contact-highlights {
    margin-top: -30px;
  }
}

@media (max-width: 768px) {
  .dp-contact-form-card {
    padding: 30px 20px;
    border-radius: 20px;
  }
  .dp-contact-form-card h2 {
    font-size: 24px;
    margin-bottom: 20px;
  }
  .dp-contact-faq-header {
    padding: 20px 24px;
    font-size: 15px;
  }
  .dp-contact-faq-content-inner {
    padding: 20px 24px;
  }
  .dp-contact-map {
    margin-top: 60px;
  }
  .dp-contact-map iframe {
    height: 350px;
  }
}
{%- endstyle -%}

<script>
document.addEventListener("DOMContentLoaded", function() {
  const headers = document.querySelectorAll('#laber_{{ sid }} .dp-contact-faq-header');
  headers.forEach(header => {
    header.addEventListener('click', function() {
      const item = this.parentElement;
      const content = this.nextElementSibling;
      const isActive = item.classList.contains('active');
      
      // Close all other accordion items
      document.querySelectorAll('#laber_{{ sid }} .dp-contact-faq-item').forEach(i => {
        if (i !== item) {
          i.classList.remove('active');
          i.querySelector('.dp-contact-faq-content').style.maxHeight = null;
          i.querySelector('.dp-contact-faq-icon').textContent = '+';
        }
      });
      
      // Toggle current item
      if (isActive) {
        item.classList.remove('active');
        content.style.maxHeight = null;
        this.querySelector('.dp-contact-faq-icon').textContent = '+';
      } else {
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + "px";
        this.querySelector('.dp-contact-faq-icon').textContent = '×';
      }
    });
  });
});
</script>

