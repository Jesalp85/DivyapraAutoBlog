<link
  rel="preconnect"
  href=" {{ 'testimonials.css' | asset_url}}"
  crossorigin>
{{ 'testimonials.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign settings = section.settings
  assign sid = section.id
  assign layout = section.settings.layout
  assign arrows = section.settings.arrows
  assign dots = section.settings.dots
  assign visible = section.settings.visible
  assign widescreen = section.settings.widescreen
  assign desktop = section.settings.desktop
  assign laptop = section.settings.laptop
  assign notebook = section.settings.notebook
  assign tablet = section.settings.tablet
  assign landscape = section.settings.landscape
  assign portrait = section.settings.portrait
  assign mobile = section.settings.mobile
  assign padding = section.settings.padding
%}
{%- for i in (1..1) -%}
  {%- if section.settings.hidden %}
    {% break %}{% endif -%}
  <section id="laber_{{sid}}">
    {% if section.settings.title != blank %}
      <div class="wrap_title container style1 {{ section.settings.text_size }}">
        <h3 class="section-title alo-text-transform" style="--ui-text-transform:{{ section.settings.text_transform }}">
          {{ section.settings.title }}
        </h3>
        {% if section.settings.content != blank %}
          <p class="content mt-2 mb-0">{{ section.settings.content }}</p>
        {% endif %}
      </div>
    {% endif %}
    <div class="container {%if layout == 'full-width' %}{{layout}}{%endif%}">
      <div class="quotes_wrapper {{section.settings.style}}">
        {%- if section.blocks.size > 0 -%}
          {% assign index = 0 %}
          {% include 'grid-slider'
            , settings: settings %}
          <div class="content_section slick-carousel">
            <div
              class="grid-slider js_carousel collection-slider laber-slick-carousel {%if sett_equal%}{{image_ratio}} {%endif%}"
              {{ gridSlider }}
              data-mobile="{{ mobile }}"
              data-portrait="{{ portrait }}"
              data-landscape="{{ landscape }}"
              data-tablet="{{ tablet }}"
              data-notebook="{{ notebook }}"
              data-laptop="{{ laptop }}"
              data-desktop="{{ desktop }}"
              data-widescreen="{{ widescreen }}"
              data-visible="{{ visible }}"
              data-spacing="{{ padding | plus: padding }}"
              style="--perload-gap: {{ padding | plus: padding }}px"
              data-append-Arrows=".arrows_{{sid}}"
              data-append-Dots=".dots_{{sid}}">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'quote' -%}
                    <div class="post-item quote_slide">
                      <div class="quote_content rounded-4 p-3 p-lg-4">
                        {% if section.settings.style == 'style1' %}
                          <div class="flex flex-wrap alo-gap" style="--ui-gap:10px;">
                            {%- if block.settings.rating >= 1 -%}
                              {%- case block.settings.rating -%}
                                {%- when 1 -%}
                                  {% assign class = ', _outline,_outline,_outline,_outline,dn' %}
                                {%- when 1.5 -%}
                                  {% assign class = ',_half pr,_outline,_outline,_outline,_outline' %}
                                {%- when 2 -%}
                                  {% assign class = ',, _outline,_outline,_outline,dn' %}
                                {%- when 2.5 -%}
                                  {% assign class = ',,_half pr,_outline,_outline,_outline' %}
                                {%- when 3 -%}
                                  {% assign class = ',,, _outline,_outline,dn' %}
                                {%- when 3.5 -%}
                                  {% assign class = ',,,_half pr,_outline,_outline' %}
                                {%- when 4 -%}
                                  {% assign class = ',,,, _outline,dn' %}
                                {%- when 4.5 -%}
                                  {% assign class = ',,,,_half pr,_outline' %}
                                {%- else -%}
                                  {% assign class = ',,,,,dn' %}
                              {%- endcase -%}
                              {% assign arr = class | split: ',' %}
                              <div class="quote_rating cra rating_{{block.settings.rating}}">
                                <i class="icon-star{{arr[0]}}"></i>
                                <i class="icon-star{{arr[1]}}"></i>
                                <i class="icon-star{{arr[2]}}"></i>
                                <i class="icon-star{{arr[3]}}"></i>
                                <i class="icon-star{{arr[4]}}"></i>
                              </div>
                            {%- endif -%}
                          </div>
                          <div class="cms_content_quote mb-2">
                            <p class="fw-bold">
                              {{ block.settings.contentHead }}
                            </p>
                          </div>
                          <div class="cms_content_quote">
                            {{ block.settings.content }}
                          </div>
                        {% else %}
                          <div class="cms_content_quote">
                            {{ block.settings.content }}
                          </div>
                          {%- if block.settings.rating >= 1 -%}
                            {%- case block.settings.rating -%}
                              {%- when 1 -%}
                                {% assign class = ', _outline,_outline,_outline,_outline,dn' %}
                              {%- when 1.5 -%}
                                {% assign class = ',_half pr,_outline,_outline,_outline,_outline' %}
                              {%- when 2 -%}
                                {% assign class = ',, _outline,_outline,_outline,dn' %}
                              {%- when 2.5 -%}
                                {% assign class = ',,_half pr,_outline,_outline,_outline' %}
                              {%- when 3 -%}
                                {% assign class = ',,, _outline,_outline,dn' %}
                              {%- when 3.5 -%}
                                {% assign class = ',,,_half pr,_outline,_outline' %}
                              {%- when 4 -%}
                                {% assign class = ',,,, _outline,dn' %}
                              {%- when 4.5 -%}
                                {% assign class = ',,,,_half pr,_outline' %}
                              {%- else -%}
                                {% assign class = ',,,,,dn' %}
                            {%- endcase -%}
                            {% assign arr = class | split: ',' %}
                            <div class="quote_rating cra rating_{{block.settings.rating}}">
                              <i class="icon-star{{arr[0]}}"></i>
                              <i class="icon-star{{arr[1]}}"></i>
                              <i class="icon-star{{arr[2]}}"></i>
                              <i class="icon-star{{arr[3]}}"></i>
                              <i class="icon-star{{arr[4]}}"></i>
                            </div>
                          {%- endif -%}
                          <div class="quote_author">{{ block.settings.title }}</div>
                          <div class="quote_address">{{ block.settings.address }}</div>
                        {% endif %}
                        <div class="testimonial_{{index}} testimonial_avatar d-flex align-items-center gap-3 position-relative">
                          {%- if block.settings.image -%}
                            {% assign image = block.settings.image %}
                            <div class="quote_avatar {% if forloop.first%} active {% endif %}">
                              {% if image != blank %}
                                <div class="images-card w-full h-full overflow-hidden">
                                  {% render 'responsive-image'
                                    , image: image
                                    , border: border
                                    , aspect_ratio: aspect_ratio
                                    , image_class: 'w-full h-full'
                                    , url: url
                                  %}
                                </div>
                              {% endif %}
                            </div>
                          {% else %}
                            <div class="quote_avatar {% if forloop.first%} active {% endif %}">
                              {% if aspect_ratio != blank %}
                                {%- assign ratio = 1 | divided_by: aspect_ratio | times: 100 -%}
                              {% else %}
                                {%- assign ratio = 100 -%}
                              {% endif %}
                              <div class="image-card__img image-blog img-demo overflow-hidden alo-border-radius ratio" style="--ui-border-radius:{{ border }}px;--ratio-percent: {{ ratio }}%;">
                                {% capture current %}{% cycle 1, 2, 3 %}{% endcapture %}
                                {{
                                  'hero-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg w-full h-full'
                                }}
                              </div>
                            </div>
                          {%- endif -%}
                          {% assign index = index | plus: 1 %}
                          <div>
                            <h6 class="quote_author">{{ block.settings.title }}</h6>
                            <div class="quote_address">{{ block.settings.address }}</div>
                          </div>
                          <div class="position-absolute bottom-0 end-0">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="80"
                              height="50"
                              viewBox="0 0 80 50"
                              fill="none">
                              <path
                                d="M16.9014 31.784C11.7684 31.9092 7.69953 30.4069 4.69484 27.277C1.56495 24.1471 0 20.266 0 15.6338C0 11.0016 1.56495 7.2457 4.69484 4.3662C7.69953 1.4867 11.5806 0.0469475 16.338 0.0469475C21.3459 0.0469475 25.4147 1.4867 28.5446 4.3662C31.5493 7.2457 33.0516 11.0016 33.0516 15.6338C33.0516 20.3912 31.9249 25.3991 29.6714 30.6573C27.4178 35.9155 24.0376 42.3631 19.5305 50H8.07512L16.9014 31.784ZM63.8498 31.784C58.7167 31.9092 54.6479 30.4069 51.6432 27.277C48.5133 24.1471 46.9484 20.266 46.9484 15.6338C46.9484 11.0016 48.5133 7.2457 51.6432 4.3662C54.6479 1.4867 58.529 0.0469475 63.2864 0.0469475C68.2942 0.0469475 72.3631 1.4867 75.493 4.3662C78.4977 7.2457 80 11.0016 80 15.6338C80 20.3912 78.8732 25.3991 76.6197 30.6573C74.3662 35.9155 70.9859 42.3631 66.4789 50H55.0235L63.8498 31.784Z"
                                fill="#0C0C0D"
                                fill-opacity="0.1" />
                            </svg>
                          </div>
                        </div>
                      </div>
                    </div>
                {% endcase %}
              {%- endfor -%}
            </div>
            {% if dots %}
              <div class="laber_append_dots dots_{{sid}}"></div>
            {% endif %}
            {% if arrows %}
              <div class="laber_append_arrows arrows_{{sid}}"></div>
            {% endif %}
          </div>
        {%- endif -%}
      </div>
      {% if section.settings.show_text_bottom %}
        <div class="text_bottom ">{{ section.settings.text_bottom }}</div>
      {% endif %}
    </div>
  </section>
{%- endfor -%}
{% style %}
  @media (min-width: 1200px) {
    #laber_{{ sid }} .content_section {
      width: {{ section.settings.width_c }}%;
      margin: 0 auto;
    }
  }
{% endstyle %}
{%- render 'section_style' -%}
{%- schema -%}
  {
    "name": "Testimonials",
    "class": "type_testimonials type_carousel",
    "max_blocks": 30,
    "settings": [
      {
        "type": "header",
        "content": "== Title Settings"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Happy Customers Say!"
      },
      {
        "type": "textarea",
        "id": "content",
        "label": "Content",
        "default": "Commodo sociosqu venenatis cras dolor sagittis integer luctus maecenas."
      },
      {
        "type": "select",
        "id": "text_size",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "small"
          }, {
            "value": "medium",
            "label": "Medium"
          }, {
            "value": "large",
            "label": "Large"
          }
        ],
        "label": "Text size"
      }, {
        "type": "select",
        "id": "text_transform",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "None"
          }, {
            "value": "capitalize",
            "label": "Capitalize"
          }, {
            "value": "lowercase",
            "label": "Lowercase"
          }, {
            "value": "uppercase",
            "label": "Uppercase"
          }
        ],
        "label": "Text transform:"
      }, {
        "type": "checkbox",
        "id": "show_text_bottom",
        "label": "Show text bottom",
        "default": false
      }, {
        "type": "richtext",
        "id": "text_bottom",
        "label": "Text",
        "default": "<p>Trusted customers are our happiness. Contact us.<p>"
      }, {
        "type": "header",
        "content": "== Design Options"
      }, {
        "type": "checkbox",
        "id": "hidden",
        "label": "Hidden Section?",
        "default": false
      }, {
        "type": "select",
        "id": "layout",
        "options": [
          {
            "value": "container",
            "label": "Container"
          }, {
            "value": "full-width",
            "label": "Full Width"
          }
        ],
        "label": "Layout"
      }, {
        "type": "range",
        "id": "width_c",
        "label": "Width container",
        "min": 0,
        "max": 100,
        "step": 10,
        "unit": "%",
        "default": 100
      }, {
        "type": "select",
        "id": "style",
        "options": [
          {
            "value": "style1",
            "label": "Style 1"
          }, {
            "value": "style2",
            "label": "Style 2"
          }
        ],
        "label": "Style"
      }, {
        "type": "header",
        "content": "---- Slider Show Collection ----",
        "info": "Refer to the attribute values [here](httpss://kenwheeler.github.io/slick)"
      }, {
        "type": "checkbox",
        "id": "use-slider",
        "label": "Use slider?",
        "default": true
      }, {
        "type": "range",
        "id": "slides-To-Scroll",
        "label": "Slide to scroll",
        "info": "The number of items slide to scroll",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "col",
        "default": 1
      }, {
        "type": "range",
        "id": "visible",
        "label": "Columns in Visible",
        "info": "Item(s) in screen ( Size >= 1920 )",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "col",
        "default": 5
      }, {
        "type": "range",
        "id": "widescreen",
        "label": "Columns in Widescreen",
        "info": "Item(s) in screen ( 1366 <= Size < 1920 )",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "col",
        "default": 4
      }, {
        "type": "range",
        "id": "desktop",
        "label": "Columns in Desktop",
        "info": "Item(s) in screen ( 1200 <= Size < 1480 )",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "col",
        "default": 4
      }, {
        "type": "range",
        "id": "laptop",
        "label": "Columns in Laptop",
        "info": "Item(s) in screen ( 992 <= Size < 1200 )",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "col",
        "default": 4
      }, {
        "type": "range",
        "id": "notebook",
        "label": "Columns in Notebook",
        "info": "Item(s) in screen ( 768 <= Size < 992 )",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "col",
        "default": 3
      }, {
        "type": "range",
        "id": "tablet",
        "label": "Columns in Tablet",
        "info": "Item(s) in screen ( 576 <= Size < 768 )",
        "min": 1,
        "max": 8,
        "step": 1,
        "unit": "col",
        "default": 3
      }, {
        "type": "range",
        "id": "landscape",
        "label": "Columns in Landscape",
        "info": "Item(s) in screen ( 480 <= Size < 576 )",
        "min": 1,
        "max": 6,
        "step": 1,
        "unit": "col",
        "default": 2
      }, {
        "type": "range",
        "id": "portrait",
        "label": "Columns in Portrait",
        "info": "Item(s) in screen ( 360 < Size < 480 )",
        "min": 1,
        "max": 6,
        "step": 1,
        "unit": "col",
        "default": 2
      }, {
        "type": "range",
        "id": "mobile",
        "label": "Columns in Mobile",
        "info": "Item(s) in screen ( Size < = 360 )",
        "min": 1,
        "max": 4,
        "step": 1,
        "unit": "col",
        "default": 1
      }, {
        "type": "range",
        "id": "rows",
        "label": "Rows Slider",
        "min": 1,
        "max": 3,
        "step": 1,
        "unit": "col",
        "default": 1
      }, {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": true
      }, {
        "type": "text",
        "id": "speed",
        "label": "Speed",
        "default": "300",
        "info": "Autoplay Speed in milliseconds"
      }, {
        "type": "text",
        "id": "autoplay-Speed",
        "label": "Auto Play Speed",
        "default": "3000",
        "info": "Autoplay Speed in milliseconds"
      }, {
        "type": "checkbox",
        "id": "arrows",
        "label": "Arrows",
        "default": true
      }, {
        "type": "checkbox",
        "id": "fade",
        "label": "Fade",
        "default": false,
        "info": "Only use for 1 column"
      }, {
        "type": "checkbox",
        "id": "center-Mode",
        "label": "Center Mode",
        "default": false
      }, {
        "type": "checkbox",
        "id": "adaptive-Height",
        "label": "Adaptive Height",
        "default": false
      }, {
        "type": "checkbox",
        "id": "dots",
        "label": "Dots",
        "default": false
      }, {
        "type": "checkbox",
        "id": "infinite",
        "label": "Infinite",
        "default": false
      }, {
        "type": "range",
        "id": "padding",
        "label": "padding",
        "info": "Distance between items",
        "min": 0,
        "max": 15,
        "step": 5,
        "unit": "px",
        "default": 10
      }, {
        "type": "checkbox",
        "id": "vertical",
        "label": "Vertical",
        "default": false
      }, {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background images"
      }, {
        "type": "color",
        "id": "cl_bg",
        "label": "Background color",
        "default": "#fff"
      }, {
        "type": "header",
        "content": "== Setting PC",
        "info": "Margin"
      }, {
        "type": "text",
        "id": "mg",
        "label": "Margin",
        "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank"
      }, {
        "type": "text",
        "id": "pd",
        "label": "Padding",
        "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank"
      }, {
        "type": "header",
        "content": "== Design Mobile Options"
      }, {
        "type": "text",
        "id": "mg_mb",
        "label": "Margin"
      }, {
        "type": "text",
        "id": "pd_mb",
        "label": "Padding"
      }
    ],
    "blocks": [
      {
        "type": "quote",
        "name": "Testimonial",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Author's image",
            "info": "200x200 recommend"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Text",
            "default": "<p>I love my lash tint! I don't have extremely blonde lashes, but I do like that they can be even darker than they are. It makes my eyes stand out more and I love the way it looks!</p>"
          },
          {
            "type": "text",
            "id": "contentHead",
            "label": "Text",
            "default": "Fresh, Flavorful, Unmatched"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Author",
            "default": "Alexander Ball"
          }, {
            "type": "text",
            "id": "address",
            "label": "Address",
            "default": "New York"
          }, {
            "type": "range",
            "id": "rating",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "label": "Rating",
            "info": "Set less than '1' to disable Rating.",
            "default": 5
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Testimonials",
        "category": "Text",
        "blocks": [
          {
            "type": "quote"
          },
          {
            "type": "quote"
          },
          {
            "type": "quote"
          },
          {
            "type": "quote"
          }, {
            "type": "quote"
          }, {
            "type": "quote"
          }, {
            "type": "quote"
          }, {
            "type": "quote"
          }
        ]
      }
    ]
  }
{%- endschema -%}