    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom Padding Mobile (px)", "min": 0, "max": 60, "step": 4, "default": 32 },

    { "type": "header", "content": "🗺️ Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show Breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_home", "label": "Home Label", "default": "Home" },
