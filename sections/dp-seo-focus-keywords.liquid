{% assign sid = section.id %}

<section id="laber_{{ sid }}" class="dp-seo-keywords-section">
  <div class="container">
    <div class="dp-seo-keywords-head">
      {%- if section.settings.label != blank -%}
        <span class="dp-label">{{ section.settings.label | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- DYNAMIC SEO COLLECTIONS FOCUS KEYWORDS PILLS CLOUD -->
    <div class="dp-seo-pills-cloud">
      {%- if collections.size > 0 -%}
        {%- for collection in collections -%}
          {%- unless collection.handle == 'frontpage' or collection.handle contains 'smart-products' -%}
            <a href="{{ collection.url }}" class="dp-seo-pill" title="{{ collection.title | escape }}">
              🏷️ {{ collection.title }}
            </a>
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        <!-- HARDCODED FALLBACK FOR ALL USER CREATED SEO COLLECTIONS -->
        <a href="/collections/pickles-online-authentic-indian-achaar-divya-prabha-foods" class="dp-seo-pill">🏷️ Pickles Online | Authentic Indian Achaar</a>
        <a href="/collections/best-pickle-brands-in-india-divya-prabha-foods" class="dp-seo-pill">🏷️ Best Pickle Brands in India</a>
        <a href="/collections/best-homemade-pickles-in-india-divya-prabha-foods" class="dp-seo-pill">🏷️ Best Homemade Pickles in India</a>
        <a href="/collections/buy-mango-pickle-online-authentic-keri-achaar-divya-prabha" class="dp-seo-pill">🏷️ Buy Mango Pickle Online | Authentic Keri Achaar</a>
        <a href="/collections/buy-homemade-pickle-online-divya-prabha-foods" class="dp-seo-pill">🏷️ Buy Homemade Pickle Online</a>
        <a href="/collections/buy-pickles-online-authentic-gujarati-achaar-divya-prabha" class="dp-seo-pill">🏷️ Buy Pickles Online | Authentic Gujarati Achaar</a>
        <a href="/collections/buy-achar-online-authentic-gujarati-pickles-divya-prabha" class="dp-seo-pill">🏷️ Buy Achar Online | Authentic Gujarati Pickles</a>
        <a href="/collections/gujarati-pickle-traditional-achaar-online" class="dp-seo-pill">🏷️ Gujarati Pickle | Traditional Achaar Online</a>
        <a href="/collections/traditional-gujarati-foods-divya-prabha-foods" class="dp-seo-pill">🏷️ Traditional Gujarati Foods</a>
        <a href="/collections/organic-pickles-authentic-gujarati-saurashtra-achaar" class="dp-seo-pill">🏷️ Organic Pickles | Authentic Gujarati Achaar</a>
        <a href="/collections/homemade-pickles-traditional-gujarati-saurashtra-achaar" class="dp-seo-pill">🏷️ Homemade Pickles | Traditional Saurashtra Achaar</a>
        <a href="/collections/sweet-tangy" class="dp-seo-pill">🏷️ Sweet & Tangy</a>
        <a href="/collections/all-spices" class="dp-seo-pill">🏷️ All Spices</a>
        <a href="/collections/all" class="dp-seo-pill">🏷️ All Products</a>
      {%- endif -%}
    </div>

    <!-- SEO TOPICS CARDS -->
    <div class="dp-seo-cards-grid">
      <div class="dp-seo-card">
        <div class="dp-seo-card__icon">🥭</div>
        <h4>Buy Mango Pickle Online</h4>
        <p>Handcrafted Rajapuri raw mango achar made with cold-pressed mustard oil, sendha namak, and sun-drying techniques passed through generations.</p>
        <a href="/collections/all" class="dp-seo-card__link">Shop Mango Achar →</a>
