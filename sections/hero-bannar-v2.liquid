    },
    {
      "type": "header",
      "content": "Brand Features (Checklist)"
    },
    {
      "type": "text",
      "id": "usp1_icon",
      "label": "Feature 1 Icon (Emoji)",
      "default": "🥭"
    },
    {
      "type": "text",
      "id": "usp1_text",
      "label": "Feature 1 Title",
      "default": "Generational recipes, unchanged since 1980"
    },
    {
      "type": "text",
      "id": "usp2_icon",
      "label": "Feature 2 Icon (Emoji)",
      "default": "☀️"
    },
    {
      "type": "text",
      "id": "usp2_text",
      "label": "Feature 2 Title",
      "default": "100% Sun-dried in traditional clay Barnis"
