        <a href="/collections/all" class="dp-seo-card__link">Shop Spicy Pickles →</a>
      </div>

      <div class="dp-seo-card">
        <div class="dp-seo-card__icon">🧈</div>
        <h4>Traditional Gujarati Foods & Spices</h4>
        <p>Pure hand-churned A2 Desi Cow Bilona Ghee and authentic stone-ground spices made with 100% natural ingredients.</p>
        <a href="/collections/all" class="dp-seo-card__link">Shop Spices & Ghee →</a>
      </div>
    </div>
  </div>
</section>

{%- style -%}
#laber_{{ sid }} {
  --dp-red: {{ section.settings.color_red | default: '#b01215' }};
  --dp-brown: {{ section.settings.color_brown | default: '#3d1f0f' }};
  --dp-gold: {{ section.settings.color_gold | default: '#e5a842' }};
  --dp-warm-bg: {{ section.settings.color_warm_bg | default: '#fdf6ed' }};
  --dp-border: {{ section.settings.color_border | default: '#e8d5c0' }};
}

.dp-seo-keywords-section {
  padding: 60px 0;
  background: #fff;
  border-top: 1px solid var(--dp-border);
}
.dp-seo-keywords-head {
  text-align: center;
  margin-bottom: 36px;
}
.dp-seo-keywords-head h2 {
  font-size: clamp(24px, 3.5vw, 36px);
  font-weight: 900;
  color: var(--dp-brown);
  margin: 10px 0 6px;
}
.dp-seo-keywords-head p {
  font-size: 15px;
  color: #6b4c3b;
  margin: 0;
}

.dp-seo-pills-cloud {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-bottom: 40px;
}
.dp-seo-pill {
  background: var(--dp-warm-bg);
  border: 1px solid var(--dp-border);
  color: var(--dp-brown);
  padding: 10px 20px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.25s ease;
  box-shadow: 0 2px 8px rgba(61,31,15,0.03);
}
.dp-seo-pill:hover {
  background: var(--dp-red);
  color: #fff;
  border-color: var(--dp-red);
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(176,18,21,0.2);
}

.dp-seo-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.dp-seo-card {
  background: var(--dp-warm-bg);
  border: 1px solid var(--dp-border);
  border-radius: 20px;
  padding: 28px;
  transition: transform 0.3s ease;
}
.dp-seo-card:hover {
  transform: translateY(-4px);
  border-color: var(--dp-gold);
}
.dp-seo-card__icon { font-size: 32px; margin-bottom: 12px; }
.dp-seo-card h4 {
  font-size: 18px;
  font-weight: 800;
  color: var(--dp-brown);
  margin: 0 0 10px;
}
.dp-seo-card p {
  font-size: 14px;
  color: #6b4c3b;
  line-height: 1.6;
  margin-bottom: 16px;
}
.dp-seo-card__link {
  color: var(--dp-red);
  font-weight: 800;
  font-size: 13px;
  text-decoration: none;
}

@media (max-width: 991px) {
  .dp-seo-cards-grid { grid-template-columns: 1fr; }
}
{%- endstyle -%}

{% schema %}
{
  "name": "SEO Focus Keywords",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "SEO Focus Keywords & Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore All Focus Keywords & Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Authentic Gujarati Pickles, Homemade Achar, Pure Spices & Desi Ghee Available Online"
    }
  ],
  "presets": [
    {
      "name": "SEO Focus Keywords"
    }
  ]
}
{% endschema %}
