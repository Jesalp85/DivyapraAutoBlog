{% if forloop.first %}
  <div class="{%if layout >= 4 %} list {% endif %} post-item {% if layout == 4%} full {% endif %}col-sm-12 col-md-{{cl_first | default:'4'}} {% if layout != 1 and layout != 4 and index == 1 %} even {% endif %}">
    <div class="item border rounded-3">
      <div class="image-blog">
        <a href="{{ article.url }}" title="{{ article.title }}">
          <div
            class="pr_lazy_img lazyload laber_bg_lz item__position"
            data-bgset="{{ article.image.src | img_url: '1x1' }}"
            data-ratio="{{article.image.aspect_ratio}}"
            data-sizes="auto"
            style="padding-top:{{ 1 | divided_by: article.image.aspect_ratio | times: 100}}%;"></div>
        </a>
      </div>
      <div class="post-info p-2 p-lg-3">
        <div class="wrap-date">
          <div class="item-meta inner-date m-0 d-flex gap-1 align-items-center">
            <p class="m-0 month">{{ article.created_at | date: '%b' }}</p>
            <p class="m-0 day">{{ article.created_at | date: '%d' }}</p>
            ,
            <p class="m-0 year">{{ article.created_at | date: '%Y' }}</p>
            &nbsp;
            <div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="4"
                height="4"
                viewBox="0 0 4 4"
                fill="none">
                <circle
                  cx="2"
                  cy="2"
                  r="2"
                  fill="#45474F" />
              </svg>
            </div>
            &nbsp;
            <div class="meta-post">
              <div class="item-meta author">
                <span>by {{ article.author }}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="head head-article ">
          <div class="title_blog my-2 my-lg-3">
            <h3>
              <a
                href="{{ article.url }}"
                title="{{ article.title }}"
                class="post-title">{{ article.title }}</a>
            </h3>
          </div>
        </div>
        <div class="">
          <div class="read_more">
            <a
              href="{{ article.url }}"
              title="{{ article.title }}"
              class="btn btn-primary rounded-3">
              {{ 'blogs.article.read_more' | t }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
{% else %}
