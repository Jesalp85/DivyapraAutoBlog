{% comment %}
  FarmDidi Custom Product Detail Section
  All settings customizable from Shopify Theme Editor
  Fully responsive: Mobile, Tablet, Desktop
{% endcomment %}

<section
  id="product-single"
  data-js-product
  class="fd-product-section"
  data-section-id="{{ section.id }}"
  style="
    --fd-primary: {{ section.settings.primary_color }};
    --fd-accent: {{ section.settings.accent_color }};
    --fd-text: {{ section.settings.text_color }};
    --fd-bg: {{ section.settings.background_color }};
    --fd-sale-badge-bg: {{ section.settings.sale_badge_bg }};
    --fd-sale-badge-text: {{ section.settings.sale_badge_text_color }};
    --fd-btn-bg: {{ section.settings.add_to_cart_bg }};
    --fd-btn-text: {{ section.settings.add_to_cart_text_color }};
    --fd-btn-hover: {{ section.settings.add_to_cart_hover_bg }};
    --fd-buynow-bg: {{ section.settings.buy_now_bg }};
    --fd-buynow-text: {{ section.settings.buy_now_text_color }};
    --fd-variant-active-border: {{ section.settings.variant_active_border }};
    --fd-variant-active-header: {{ section.settings.variant_active_header_bg }};
    --fd-star-color: {{ section.settings.star_color }};
    --fd-tag-bg: {{ section.settings.tag_bg_color }};
    --fd-tag-text: {{ section.settings.tag_text_color }};
    --fd-font-size-base: {{ section.settings.base_font_size }}px;
    --fd-border-radius: {{ section.settings.border_radius }}px;
  "
>

  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

  <div class="fd-product-wrapper">

    {%- comment -%} ── Breadcrumb ── {%- endcomment -%}
    {%- if section.settings.show_breadcrumb -%}
    <nav class="fd-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span aria-hidden="true">/</span>
      {%- endif -%}
      <span>{{ product.title }}</span>
    </nav>
    {%- endif -%}

    <div class="fd-product-layout">

      {%- comment -%} LEFT COLUMN – Media Gallery {%- endcomment -%}
      <div class="fd-media-col">
        <div class="fd-media-row">

          {%- if product.images.size > 1 -%}
          <div class="fd-thumbs" role="list" aria-label="Product images" id="fd-thumbs-{{ section.id }}">
            {%- for image in product.images limit: 8 -%}
            <button
              class="fd-thumb{% if forloop.first %} fd-thumb--active{% endif %}"
              data-src="{{ image | img_url: '800x800', crop: 'center' }}"
              data-alt="{{ image.alt | default: product.title | escape }}"
              aria-label="View image {{ forloop.index }}"
              onclick="fdSetImage(this, '{{ section.id }}')"
              role="listitem"
            >
              <img
                src="{{ image | img_url: '160x160', crop: 'center' }}"
                srcset="{{ image | img_url: '160x160', crop: 'center' }} 1x, {{ image | img_url: '320x320', crop: 'center' }} 2x"
                alt="{{ image.alt | default: product.title | escape }}"
                loading="lazy"
                width="80"
                height="80"
              >
            </button>
            {%- endfor -%}
          </div>
          {%- endif -%}

          <div class="fd-main-image-wrap">
            {%- assign is_bestseller = false -%}
            {%- assign p_title = product.title | downcase | strip -%}
            {%- assign p_handle = product.handle | downcase | strip -%}
            {%- if p_title contains 'gor keri' or p_handle contains 'gor-keri' or p_title contains 'gunda keri' or p_handle contains 'gunda-keri' -%}
              {%- assign is_bestseller = true -%}
            {%- endif -%}
            {%- if is_bestseller -%}
              <div class="fd-sale-badge fd-bestseller-badge">Best Seller</div>
            {%- endif -%}

            <div class="fd-main-image" id="fd-main-image-{{ section.id }}">
              {%- if featured_image -%}
                <img
                  src="{{ featured_image | img_url: '800x800', crop: 'center' }}"
                  alt="{{ featured_image.alt | default: product.title | escape }}"
                  id="fd-hero-img-{{ section.id }}"
                  loading="eager"
                  class="fd-hero-img"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'fd-placeholder-svg' }}
              {%- endif -%}
            </div>

            {%- if section.settings.enable_zoom -%}
            <button class="fd-zoom-btn" aria-label="Zoom image" onclick="fdOpenLightbox('{{ section.id }}')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35M11 8v6M8 11h6"/></svg>
            </button>
            {%- endif -%}
          </div>

        </div><!-- /fd-media-row -->
      </div><!-- /fd-media-col -->

      {%- comment -%} RIGHT COLUMN – Product Info {%- endcomment -%}
      <div class="fd-info-col">

        <h1 class="fd-product-title">{{ product.title }}</h1>

        {%- if section.settings.show_reviews_row -%}
        <div class="fd-reviews-row">
          <!-- Start of Judge.me code -->
          <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
            {{ product.metafields.judgeme.badge }}
          </div>
          <!-- End of Judge.me code -->
          {%- if section.settings.show_amazon_rating and section.settings.amazon_star_image != blank -%}
          <span class="fd-amazon-rating">
            <img
              src="{{ section.settings.amazon_star_image | img_url: '160x' }}"
              srcset="{{ section.settings.amazon_star_image | img_url: '160x' }} 1x, {{ section.settings.amazon_star_image | img_url: '320x' }} 2x"
              alt="Amazon stars"
              height="20"
              width="100"
              loading="lazy"
            >
            {{ section.settings.amazon_rating_text }}
          </span>
          {%- endif -%}
        </div>
        {%- endif -%}

        {%- if section.settings.show_tags -%}
        <div class="fd-tags-row">
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_tag' -%}
              {%- assign meta_key = block.settings.metafield_key | strip -%}
              {%- assign meta_value = blank -%}
              {%- if meta_key != blank -%}
                {%- assign clean_key = meta_key | replace: "custom.", "" -%}
                {%- assign lookup_value = product.metafields.custom[clean_key].value | default: product.metafields.custom[clean_key] -%}
                {%- if lookup_value.first != blank -%}
                  {%- assign meta_value = lookup_value | join: ", " -%}
                {%- else -%}
                  {%- assign meta_value = lookup_value -%}
                {%- endif -%}
              {%- endif -%}
              {%- assign display_label = meta_value | default: block.settings.tag_label -%}
              {%- if display_label != blank -%}
              <div class="fd-tag" {{ block.shopify_attributes }}
                style="background:{{ block.settings.tag_bg_override | default: section.settings.tag_bg_color }};color:{{ block.settings.tag_text_override | default: section.settings.tag_text_color }}">
                {%- if block.settings.tag_icon != blank -%}
                  <img
                    src="{{ block.settings.tag_icon | img_url: '120x120' }}"
                    srcset="{{ block.settings.tag_icon | img_url: '120x120' }} 1x, {{ block.settings.tag_icon | img_url: '240x240' }} 2x"
                    alt=""
                    width="32"
                    height="32"
                    loading="lazy"
                  >
                {%- endif -%}
                <span>{{ display_label }}</span>
              </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        {%- if section.settings.show_trust_banners -%}
        <div class="fd-trust-row">
          {%- if section.settings.trust_banner_1 != blank -%}
          <span class="fd-trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            {{ section.settings.trust_banner_1 }}
          </span>
          {%- endif -%}
          {%- if section.settings.trust_banner_2 != blank -%}
          <span class="fd-trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
            {{ section.settings.trust_banner_2 }}
          </span>
          {%- endif -%}
        </div>
        {%- endif -%}

        {%- if section.settings.show_urgency -%}
        <div class="fd-urgency">
          <span class="fd-fire">🔥</span>
          <span id="fd-sold-count-{{ section.id }}"></span>
          {{ section.settings.urgency_suffix_text }}
        </div>
        {%- endif -%}

        <div class="fd-price-row" id="fd-price-row-{{ section.id }}">
          <span class="fd-price" id="fd-price-{{ section.id }}">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="fd-price-meta">
            <span class="fd-mrp-label">{{ section.settings.mrp_label }}</span>
            <s class="fd-compare-price" id="fd-compare-{{ section.id }}">
              {{ current_variant.compare_at_price | money }}
            </s>
          </span>
          {%- endif -%}
          <span class="fd-tax-note">{{ section.settings.tax_note }}</span>
        </div>

        {%- if section.settings.shelf_life_text != blank -%}
        <div class="fd-shelf-life">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <strong>{{ section.settings.shelf_life_label }}:</strong> {{ section.settings.shelf_life_text }}
        </div>
        {%- endif -%}

        {%- if product.variants.size > 1 -%}
        <div class="fd-variants" id="fd-variants-{{ section.id }}">
          {%- for variant in product.variants -%}
            {%- assign is_active = false -%}
            {%- if variant.id == current_variant.id -%}{%- assign is_active = true -%}{%- endif -%}
            {%- assign discount_pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
            {%- assign variant_img = variant.featured_image | default: product.featured_image -%}
            <div
              class="fd-variant-card{% if is_active %} fd-variant-card--active{% endif %}"
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price | money }}"
              data-compare="{{ variant.compare_at_price | money }}"
              data-available="{{ variant.available }}"
              {%- if variant_img -%}
                data-image="{{ variant_img | img_url: '800x800', crop: 'center' }}"
                data-image-alt="{{ variant_img.alt | default: variant.title | escape }}"
              {%- endif -%}
              onclick="fdSelectVariant(this, '{{ section.id }}')"
              role="button"
              tabindex="0"
              aria-pressed="{{ is_active }}"
              aria-label="{{ variant.title }}: {{ variant.price | money }}"
            >
              {%- for block in section.blocks -%}
                {%- if block.type == 'variant_badge' and block.settings.variant_id == variant.id -%}
                  <span class="fd-variant-best-badge" {{ block.shopify_attributes }}
                    style="background:{{ block.settings.badge_bg }};color:{{ block.settings.badge_text }}">
                    {{ block.settings.badge_label }}
                  </span>
                {%- endif -%}
              {%- endfor -%}

              <div class="fd-variant-header">{{ variant.title | split: '|' | first }}</div>
              <div class="fd-variant-body">
                <span class="fd-v-price">{{ variant.price | money }}</span>
                {%- if variant.compare_at_price > variant.price -%}
                <s class="fd-v-compare">{{ variant.compare_at_price | money }}</s>
                <span class="fd-v-discount">{{ discount_pct }}% off</span>
                {%- endif -%}
              </div>
              {%- if section.settings.show_per_unit -%}
              <div class="fd-variant-unit">
                {%- assign unit_label = variant.title | split: '₹' | last | strip -%}
                {%- if unit_label != blank -%}
                  <span>₹{{ unit_label }}</span>
                {%- endif -%}
              </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <select name="id" id="fd-variant-select-{{ section.id }}" style="display:none" aria-label="Variant">
          {%- for variant in product.variants -%}
          <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}>
            {{ variant.title }}
          </option>
          {%- endfor -%}
        </select>
        {%- endif -%}

        {%- form 'product', product, id: "fd-product-form-{{ section.id }}", class: "fd-product-form" -%}
          <input type="hidden" name="id" id="fd-variant-input-{{ section.id }}" value="{{ current_variant.id }}">

          <div class="fd-action-row">
            {%- if section.settings.show_quantity -%}
            <div class="fd-qty-picker">
              <button type="button" class="fd-qty-btn fd-qty-minus" aria-label="Decrease quantity"
                onclick="fdQtyChange(this, -1, '{{ section.id }}')">−</button>
              <input type="number" name="quantity" id="fd-qty-{{ section.id }}"
                value="1" min="1" class="fd-qty-input" aria-label="Quantity">
              <button type="button" class="fd-qty-btn fd-qty-plus" aria-label="Increase quantity"
                onclick="fdQtyChange(this, 1, '{{ section.id }}')">+</button>
            </div>
            {%- endif -%}

            <button
              type="button"
              id="fd-atc-btn-{{ section.id }}"
              class="fd-btn fd-btn--atc add-to-cart"
              onclick="fdAddToCart('{{ section.id }}')"
              {%- unless current_variant.available -%} disabled aria-disabled="true"{%- endunless -%}
            >
              {%- if current_variant.available -%}
                {{ section.settings.add_to_cart_text }}
              {%- else -%}
                {{ section.settings.sold_out_text }}
              {%- endif -%}
            </button>

            {%- if section.settings.show_buy_now -%}
            <button
              type="submit"
              name="add"
              id="fd-buynow-btn-{{ section.id }}"
              class="fd-btn fd-btn--buynow"
              {%- unless current_variant.available -%} disabled aria-disabled="true"{%- endunless -%}
            >
              {{ section.settings.buy_now_text }}
            </button>
            {%- endif -%}
          </div>
        {%- endform -%}

        {%- if section.settings.show_pincode_checker -%}
        <div class="fd-pincode-box">
          <div class="fd-pincode-header" style="background:var(--fd-primary)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="10" r="3"/><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
            <span>{{ section.settings.pincode_header_text }}</span>
          </div>
          <div class="fd-pincode-body">
            <p class="fd-pincode-label">{{ section.settings.pincode_label }}</p>
            <div class="fd-pincode-input-row">
              <input type="text" id="fd-pin-{{ section.id }}" maxlength="6" inputmode="numeric"
                placeholder="{{ section.settings.pincode_placeholder }}" class="fd-pin-input"
                aria-label="Enter pincode">
              <button type="button" class="fd-pin-check-btn"
                style="background:var(--fd-primary)"
                onclick="fdCheckPin('{{ section.id }}', '{{ section.settings.pin_available_msg }}', '{{ section.settings.pin_unavailable_msg }}')">
                {{ section.settings.pincode_btn_text }}
              </button>
            </div>
            <p class="fd-pin-result" id="fd-pin-result-{{ section.id }}" aria-live="polite"></p>
          </div>
        </div>
        {%- endif -%}

        {%- if section.settings.show_offers -%}
        <div class="fd-offers">
          <div class="fd-offers-header">
            <strong>{{ section.settings.offers_heading }}</strong>
            {%- if section.settings.offers_prepaid_text != blank -%}
            <span class="fd-offers-sub">{{ section.settings.offers_prepaid_text }}</span>
            {%- endif -%}
          </div>
          {%- for block in section.blocks -%}
            {%- if block.type == 'offer_card' -%}
            <div class="fd-offer-card" {{ block.shopify_attributes }}>
              <div class="fd-offer-card-head" style="background:{{ block.settings.card_header_bg }}">
                <span>{{ block.settings.offer_title }}</span>
                <span class="fd-offer-badge">{{ block.settings.offer_badge }}</span>
              </div>
              <p class="fd-offer-desc">{{ block.settings.offer_description }}</p>
            </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        {%- if section.settings.show_usp_icons -%}
        <div class="fd-usp-strip">
          {%- for block in section.blocks -%}
            {%- if block.type == 'usp_icon' -%}
            <div class="fd-usp-item" {{ block.shopify_attributes }}>
              {%- if block.settings.usp_image != blank -%}
                <img
                  src="{{ block.settings.usp_image | img_url: '160x160' }}"
                  srcset="{{ block.settings.usp_image | img_url: '160x160' }} 1x, {{ block.settings.usp_image | img_url: '320x320' }} 2x"
                  alt="{{ block.settings.usp_label }}"
                  width="56"
                  height="56"
                  loading="lazy"
                >
              {%- else -%}
                <div class="fd-usp-icon-placeholder">
                  {%- assign label_dn = block.settings.usp_label | downcase -%}
                  {%- if label_dn contains 'handmade' or label_dn contains 'hygienic' -%}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                    </svg>
                  {%- elsif label_dn contains 'ingredient' or label_dn contains 'premium' -%}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 20h10"/>
                      <path d="M10 20V12"/>
                      <path d="M10 17c-2.3-1.5-4-4.5-4-8a1 1 0 0 1 1-1h3"/>
                      <path d="M14 20V10"/>
                      <path d="M14 15c2.3-1.5 4-4.5 4-8a1 1 0 0 0-1-1h-3"/>
                    </svg>
                  {%- elsif label_dn contains 'sun' or label_dn contains 'barni' or label_dn contains 'dried' -%}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="4"/>
                      <path d="M12 2v2"/>
                      <path d="M12 20v2"/>
                      <path d="M4.93 4.93l1.41 1.41"/>
                      <path d="M17.66 17.66l1.41 1.41"/>
                      <path d="M2 12h2"/>
                      <path d="M20 12h2"/>
                      <path d="M6.34 17.66l-1.41 1.41"/>
                      <path d="M19.07 4.93l-1.41 1.41"/>
                    </svg>
                  {%- elsif label_dn contains 'preservative' or label_dn contains 'no chemical' -%}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <path d="m9 12 2 2 4-4"/>
                    </svg>
                  {%- else -%}
                    ✓
                  {%- endif -%}
                </div>
              {%- endif -%}
              <span>{{ block.settings.usp_label }}</span>
            </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        {%- if section.settings.show_ingredient_icons -%}
        <div class="fd-ingredient-icons">
          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient_icon' -%}
            <div class="fd-ingr-item" {{ block.shopify_attributes }}>
              {%- if block.settings.ingr_image != blank -%}
                <img
                  src="{{ block.settings.ingr_image | img_url: '160x160' }}"
                  srcset="{{ block.settings.ingr_image | img_url: '160x160' }} 1x, {{ block.settings.ingr_image | img_url: '320x320' }} 2x"
                  alt="{{ block.settings.ingr_label }}"
                  width="64"
                  height="64"
                  loading="lazy"
                >
              {%- endif -%}
              <span>{{ block.settings.ingr_label }}</span>
            </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

      </div><!-- /fd-info-col -->
    </div><!-- /fd-product-layout -->
  </div><!-- /fd-product-wrapper -->

  <!-- Lightbox Slideshow Modal -->
  <div id="fd-lightbox-{{ section.id }}" class="fd-lightbox" role="dialog" aria-modal="true" aria-hidden="true" onclick="fdCloseLightbox('{{ section.id }}')">
    <button class="fd-lightbox-close" aria-label="Close slideshow" onclick="fdCloseLightbox('{{ section.id }}')">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    
    <div class="fd-lightbox-content" onclick="event.stopPropagation()">
      <button class="fd-lightbox-arrow fd-lightbox-prev" aria-label="Previous image" onclick="fdChangeLightboxImg(-1, '{{ section.id }}')">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      
      <div class="fd-lightbox-main">
        <img id="fd-lightbox-img-{{ section.id }}" src="" alt="" class="fd-lightbox-img">
      </div>
      
      <button class="fd-lightbox-arrow fd-lightbox-next" aria-label="Next image" onclick="fdChangeLightboxImg(1, '{{ section.id }}')">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
    
    <div class="fd-lightbox-thumbs" id="fd-lightbox-thumbs-{{ section.id }}" onclick="event.stopPropagation()">
      {%- for image in product.images -%}
        <button 
          class="fd-lightbox-thumb" 
          data-index="{{ forloop.index0 }}" 
          data-src="{{ image | img_url: '1200x1200' }}" 
          onclick="fdSetLightboxImg({{ forloop.index0 }}, '{{ section.id }}')"
          aria-label="View slide {{ forloop.index }}"
        >
          <img src="{{ image | img_url: '160x160', crop: 'center' }}" alt="" loading="lazy">
        </button>
      {%- endfor -%}
    </div>
  </div>

</section>


{%- comment -%} STYLES {%- endcomment -%}
<style>
/* Fix sticky gallery on desktop by allowing overflow on main wrapper */
.template-product div.main {
  overflow: visible !important;
}

.fd-product-section *,
.fd-product-section *::before,
.fd-product-section *::after { box-sizing: border-box; }

.fd-product-section {
  --fd-radius: var(--fd-border-radius, 10px);
  font-size: var(--fd-font-size-base, 16px);
  color: var(--fd-text, #111);
  background: var(--fd-bg, #fff);
  padding: 0 0 40px;
}

.fd-product-wrapper { max-width: 1280px; margin: 0 auto; padding: 0 20px; }

.fd-breadcrumb {
  font-size: .82em;
  padding: 10px 0;
  color: #666;
  display: flex; flex-wrap: wrap; gap: 6px; align-items: center;
}
.fd-breadcrumb a { color: var(--fd-primary); text-decoration: none; }
.fd-breadcrumb a:hover { text-decoration: underline; }

.fd-product-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: start;
}
@media (max-width: 767px) {
  .fd-product-layout { grid-template-columns: 1fr; gap: 20px; }
}

@media (min-width: 768px) {
  .fd-media-col {
    position: sticky;
    top: 120px;
    z-index: 1; /* Reduced from 10 to prevent overlapping info column buttons */
  }
}
/* Ensure the info column and all interactive children remain clickable */
.fd-info-col {
  position: relative;
  z-index: 2;
  pointer-events: auto !important;
}
.fd-info-col *,
.fd-variant-card,
.fd-qty-btn,
.fd-qty-input,
.fd-btn,
.fd-btn--atc,
.fd-btn--buynow {
  pointer-events: auto !important;
}

.fd-media-row {
  display: flex;
  flex-direction: row;
  gap: 12px;
  align-items: flex-start;
}

.fd-main-image-wrap {
  position: relative;
  border-radius: var(--fd-radius);
  overflow: hidden;
  background: #f7f7f7;
  aspect-ratio: 1;
  flex: 1;
  min-width: 0;
}
.fd-hero-img {
  width: 100%; height: 100%;
  object-fit: contain;
  display: block;
  transition: transform 0.15s ease-out;
}

.fd-sale-badge {
  position: absolute; top: 12px; left: 12px; z-index: 2;
  background: var(--fd-sale-badge-bg, #d62628);
  color: var(--fd-sale-badge-text, #fff);
  font-size: .75em; font-weight: 700;
  padding: 4px 10px; border-radius: 20px;
}
.fd-zoom-btn {
  position: absolute; bottom: 10px; right: 10px; z-index: 2;
  background: rgba(255,255,255,.9); border: none; border-radius: 6px;
  padding: 6px; cursor: pointer; display: flex; align-items: center;
  box-shadow: 0 2px 6px rgba(0,0,0,.15);
}

/* ── Thumbnails: vertical column on the left for desktop ── */
.fd-thumbs {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
  width: 72px;
  max-height: 560px;
  overflow-y: auto;
  order: -1;
}
.fd-thumb {
  width: 64px; height: 64px; padding: 2px;
  border: 2px solid transparent; border-radius: 8px;
  background: #f5f5f5; cursor: pointer;
  transition: border-color .2s, transform .2s;
  overflow: hidden;
  flex-shrink: 0;
  box-sizing: border-box;
}
.fd-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
.fd-thumb:hover { transform: scale(1.05); }
.fd-thumb--active { border-color: var(--fd-primary); }

@media (max-width: 767px) {
  .fd-product-wrapper {
    padding: 0 8px;
  }
  .fd-media-col {
    padding: 0;
    box-sizing: border-box;
    width: 100%;
  }
  .fd-media-row {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 12px;
  }
  .fd-main-image-wrap {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
  }
  .fd-thumbs {
    display: flex;
    flex-direction: row;
    width: 100%;
    max-width: 100%;
    max-height: none;
    overflow-x: auto;
    overflow-y: hidden;
    order: 1;
    justify-content: flex-start !important;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 8px 10px 8px;
    box-sizing: border-box;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
  }
  .fd-thumb {
    width: 60px;
    height: 60px;
    flex: 0 0 60px;
    flex-shrink: 0;
    scroll-snap-align: start;
    box-sizing: border-box;
  }
}

.fd-product-title {
  font-size: 1.7em; line-height: 1.2; margin: 0 0 10px;
  color: var(--fd-text);
}

.fd-reviews-row {
  display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 10px;
}
.jdgm-widget.jdgm-preview-badge,
.jdgm-widget.jdgm-preview-badge .jdgm-prev-badge {
  display: inline-flex !important;
  align-items: center;
  gap: 4px;
}
.fd-star { color: #ccc; font-size: 1.1em; }
.fd-star--on { color: var(--fd-star-color, #f3a222); }
.fd-review-count { font-size: .88em; color: #555; }
.fd-amazon-rating {
  display: flex; align-items: center; gap: 6px; font-size: .85em;
}
.fd-amazon-rating img {
  height: 20px; width: auto; object-fit: contain; image-rendering: -webkit-optimize-contrast;
}

/* ── Tags: Premium horizontal pill style ── */
.fd-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.fd-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  border: 1px solid #e8a23a44;
  border-radius: 30px;
  font-size: .85em;
  font-weight: 600;
  background: var(--fd-tag-bg, #fff8ee);
  color: var(--fd-tag-text, #572423);
  line-height: 1.2;
  box-shadow: 0 1px 3px rgba(232, 162, 58, 0.05);
  transition: all 0.2s ease;
}
.fd-tag:hover {
  transform: translateY(-1px);
  box-shadow: 0 3px 6px rgba(232, 162, 58, 0.1);
}
.fd-tag img {
  width: 30px;
  height: 30px;
  object-fit: contain;
  border-radius: 50%;
}
@media (max-width: 480px) {
  .fd-tags-row {
    gap: 6px;
  }
  .fd-tag {
    padding: 5px 10px;
    font-size: .78em;
    gap: 6px;
  }
  .fd-tag img {
    width: 24px;
    height: 24px;
  }
}

.fd-trust-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
.fd-trust-item {
  display: flex; align-items: center; gap: 6px;
  background: #fff8ec; border-radius: 6px;
  padding: 5px 10px; font-size: .82em; font-weight: 500;
}

.fd-urgency {
  background: #fff3f3; border-radius: 6px;
  padding: 7px 12px; font-size: .88em; font-weight: 500;
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 12px; width: fit-content;
}

.fd-price-row {
  display: flex; flex-wrap: wrap; align-items: baseline;
  gap: 8px; margin-bottom: 8px;
}
.fd-price { font-size: 1.6em; font-weight: 700; color: var(--fd-text); }
.fd-price-meta { display: flex; align-items: baseline; gap: 4px; }
.fd-mrp-label { font-size: .82em; color: #888; }
.fd-compare-price { font-size: 1em; color: #999; text-decoration: line-through; }
.fd-tax-note { font-size: .78em; color: #888; width: 100%; }

.fd-shelf-life {
  display: flex; align-items: center; gap: 6px;
  font-size: .88em; margin-bottom: 16px; color: #555;
}

.fd-variants {
  display: flex; gap: 10px; flex-wrap: wrap;
  background: #f8f8f8; padding: 10px; border-radius: var(--fd-radius);
  margin-bottom: 18px;
}
.fd-variant-card {
  flex: 1; min-width: 120px;
  border: 2px solid #d3d3d3; border-radius: var(--fd-radius);
  cursor: pointer; text-align: center;
  padding-bottom: 4px;
  position: relative;
  transition: border-color .2s, box-shadow .2s;
