{% assign sid = section.id %}
{%- assign full_width = section.settings.full_width -%}

<section
  id="laber_{{sid}}"
  class="wow animate--slide-in"
  style="--ui-border-color:{{ section.settings.cl_line }};">

  <!-- Curvy Wave Divider Transition -->
  <div class="footer-wave-top">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display: block; width: 100%; height: 40px; margin-bottom: -1px;">
      <path d="M0,0C240,30,480,60,720,60C960,60,1200,30,1440,0L1440,60L0,60Z" fill="{{ section.settings.cl_bg | default: '#2c1e1b' }}"></path>
    </svg>
  </div>

  <div class="main-footer" style="
      background-color: {{ section.settings.cl_bg }};
      {% if section.settings.bg_image != blank %}
        background-image: url({{ section.settings.bg_image | asset_url }});
        background-size: cover;
        background-position: center;
      {% endif %}
    ">
    <div class="{% if section.settings.full_width %}full-width{% else %}container{% endif %}">
      <div class="row">
        {% render 'footer_1' %}
      </div>
    </div>
  </div>
</section>


{%- render 'section_style' -%}

{%- style -%}
  #laber_{{ sid }} {
    position: relative;
    padding-top: 0 !important;
    background-color: transparent !important;
    background-image: none !important;
  }
  #laber_{{ sid }} .footer-wave-top {
    line-height: 0;
    width: 100%;
    margin-top: 0;
    background: transparent;
    z-index: 5;
    position: relative;
  }
  #laber_{{ sid }} .footer-wave-top svg {
    display: block;
    width: 100%;
    height: 40px;
    fill: {{ section.settings.cl_bg | default: '#2c1e1b' }};
  }
  #laber_{{ sid }} .main-footer {
    padding-top: 40px !important;
    padding-bottom: 40px !important;
    margin-bottom: 0 !important;
  }
  #laber_{{ sid }} {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }
  .laber-newsletter {
    margin-bottom: 0 !important;
  }
  /* Heading styled with a premium gold touch */
  #laber_{{ sid }} .widget-title .txt_title {
    color: #e5a842 !important; /* Gold Heading color */
    font-size: 16px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    position: relative;
    padding-bottom: 8px;
    display: inline-block;
    border-bottom: 2px solid #b11f24; /* brand red line */
    margin-bottom: 24px;
  }
  #laber_{{ sid }} .widget-title .icon_mobile {
    display: none !important;
  }
  
  /* Link items styling */
  #laber_{{ sid }} .menu_footer .menu li {
    margin-bottom: 10px !important;
  }
  #laber_{{ sid }} .menu_footer .menu li a {
    color: #f5ede2 !important; /* light cream text */
    font-size: 14px !important;
    transition: all 0.25s ease !important;
    text-decoration: none;
    opacity: 0.85;
  }
  #laber_{{ sid }} .menu_footer .menu li a:hover {
    color: #f4b41a !important; /* hover gold */
    padding-left: 5px;
    opacity: 1;
  }
  
  /* Left Logo and info widget */
  #laber_{{ sid }} .alo-logo-footer {
    color: #eadec9 !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
  }
  #laber_{{ sid }} .alo-logo-footer .logo-footer {
    margin-bottom: 15px !important;
  }
  #laber_{{ sid }} .alo-logo-footer .logo-footer img {
    border-radius: 50%;
    border: 2px solid #e5a842;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
  #laber_{{ sid }} .alo-logo-footer .content {
    color: #eadec9 !important;
    margin-bottom: 15px !important;
  }

  /* Social sharing circular gold icons */
  #laber_{{ sid }} .laber-social-link .list-socials {
    display: flex;
    gap: 10px;
    margin-top: 15px;
  }
  #laber_{{ sid }} .laber-social-link .list-socials li {
    margin: 0 !important;
  }
  #laber_{{ sid }} .laber-social-link .list-socials li a {
    width: 36px !important;
    height: 36px !important;
    background: #3e2723 !important; /* Dark warm brown */
    color: #e5a842 !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 1px solid #e5a842 !important;
    font-size: 15px !important;
    transition: all 0.25s ease !important;
    text-decoration: none !important;
  }
  #laber_{{ sid }} .laber-social-link .list-socials li a:hover {
    background: #b11f24 !important; /* brand red */
    color: #ffffff !important;
    border-color: #b11f24 !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(177,31,36,0.3);
  }
{%- endstyle -%}

