  <section class="our-menu py-space-80">
  <div class="container">
    <div class="text-center mb-3 mb-lg-4">
      <div class="title-text mb-1 mx-auto" style="background-color: {{ section.settings.title_bg_color }}">
        {{ section.settings.eyebrow_text }}
      </div>
      <h2 class="">{{ section.settings.heading_text }}</h2>
      <p>{{ section.settings.description_text }}</p>
    </div>
    <div class="row">
      {% for block in section.blocks %}
        <div class="col-md-6 col-12 mb-4">
          <div class="border rounded-4 p-4 p-lg-5 bg-white">
            <!-- First Menu Item -->
            <div class="menu-items d-flex gap-3 gap-lg-4 align-items-center mb-1 mb-lg-2">
              <a href="{{ block.settings.item_1_link }}" class="flex-shrink-0">
                <h5>
                  {{- block.settings.item_1_name -}}
                </h5>
              </a>
              <hr class="w-100">
              <h5 style="color:var(--color-breadcrum)" class="color-quat flex-shrink-0">
                {{ block.settings.item_1_price }}
              </h5>
            </div>
            <p class="mb-3 mb-lg-4">{{ block.settings.item_1_description }}</p>

            <!-- Second Menu Item -->
            <div class="menu-items d-flex gap-3 gap-lg-4 align-items-center mb-1 mb-lg-2">
              <a href="{{ block.settings.item_2_link }}" class="flex-shrink-0">
                <h5>
                  {{- block.settings.item_2_name -}}
                </h5>
              </a>
              <hr class="w-100">
              <h5 style="color:var(--color-breadcrum)" class="color-quat flex-shrink-0">
                {{ block.settings.item_2_price }}
              </h5>
            </div>
            <p class="mb-3 mb-lg-4">{{ block.settings.item_2_description }}</p>

            <!-- Third Menu Item -->
            <div class="menu-items d-flex gap-3 gap-lg-4 align-items-center mb-1 mb-lg-2">
              <a href="{{ block.settings.item_3_link }}" class="flex-shrink-0">
                <h5>
                  {{- block.settings.item_3_name -}}
                </h5>
              </a>
              <hr class="w-100">
              <h5 style="color:var(--color-breadcrum)" class="color-quat flex-shrink-0">
                {{ block.settings.item_3_price }}
              </h5>
            </div>
            <p class="mb-3 mb-lg-4">{{ block.settings.item_3_description }}</p>

            <!-- Fourth Menu Item (Crunch Grillhouse) -->
            <div class="menu-items d-flex gap-3 gap-lg-4 align-items-center mb-1 mb-lg-2">
              <a href="{{ block.settings.item_4_link }}" class="flex-shrink-0">
                <h5>
                  {{- block.settings.item_4_name -}}
                </h5>
              </a>
              <hr class="w-100">
              <h5 style="color:var(--color-breadcrum)" class="color-quat flex-shrink-0">
                {{ block.settings.item_4_price }}
              </h5>
            </div>
            <p class="mb-3 mb-lg-4">{{ block.settings.item_4_description }}</p>

            <!-- Fifth Menu Item (Hamburger Cheese) -->
            <div class="menu-items d-flex gap-3 gap-lg-4 align-items-center mb-1 mb-lg-2">
              <a href="{{ block.settings.item_5_link }}" class="flex-shrink-0">
                <h5>
                  {{- block.settings.item_5_name -}}
                </h5>
              </a>
              <hr class="w-100">
              <h5 style="color:var(--color-breadcrum)" class="color-quat flex-shrink-0">
                {{ block.settings.item_5_price }}
              </h5>
            </div>
            <p class="mb-3 mb-lg-4">{{ block.settings.item_5_description }}</p>

          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Our Menu Section",
  "settings": [
    {
      "type": "color",
      "id": "title_bg_color",
      "label": "Sub Title Background Color",
      "default": "#255DCC"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
