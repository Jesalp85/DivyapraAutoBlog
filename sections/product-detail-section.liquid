}
.fd-v-price { font-size: 1em; font-weight: 700; }
.fd-v-compare { font-size: .8em; color: #999; text-decoration: line-through; }
.fd-v-discount { font-size: .78em; color: #c00; font-weight: 600; }
.fd-variant-unit { padding: 0 6px 5px; font-size: .78em; color: #006400; font-weight: 500; }

.fd-action-row {
  display: flex; align-items: center; gap: 10px; margin-bottom: 18px; flex-wrap: wrap;
}
.fd-qty-picker {
  display: flex; align-items: center;
  border: 2px solid var(--fd-primary, #f3a222); border-radius: 8px; overflow: hidden;
  height: 44px;
}
.fd-qty-btn {
  background: #f5f5f5; border: none; width: 36px; height: 100%;
  font-size: 1.2em; font-weight: 700; cursor: pointer;
  transition: background .15s;
}
.fd-qty-btn:hover { background: var(--fd-primary, #f3a222); }
.fd-qty-input {
  width: 48px; text-align: center; font-size: 1em; font-weight: 700;
  border: none; height: 100%; outline: none;
  -moz-appearance: textfield;
}
.fd-qty-input::-webkit-outer-spin-button,
.fd-qty-input::-webkit-inner-spin-button { -webkit-appearance: none; }

.fd-btn {
  flex: 1; min-width: 140px; height: 44px;
  border: none; border-radius: 8px; font-size: .95em; font-weight: 700;
  cursor: pointer; transition: background .2s, transform .1s;
  display: flex; align-items: center; justify-content: center;
  text-transform: uppercase; letter-spacing: .04em;
}
.fd-btn:active { transform: scale(.98); }
.fd-btn:disabled { opacity: .6; cursor: not-allowed; }

.fd-btn--atc {
  background: var(--fd-btn-bg, #cc1226);
  color: var(--fd-btn-text, #fff);
}
.fd-btn--atc:hover:not(:disabled) { background: var(--fd-btn-hover, #a80e1e); }
.fd-btn--buynow {
  background: var(--fd-buynow-bg, #f3a222);
  color: var(--fd-buynow-text, #000);
}
.fd-btn--buynow:hover:not(:disabled) { filter: brightness(1.08); }

@media (max-width: 480px) {
  .fd-action-row { flex-direction: column; }
  .fd-btn, .fd-qty-picker { width: 100%; flex: unset; }
}

.fd-pincode-box {
  border: 1px solid #ebebeb; border-radius: var(--fd-radius);
  overflow: hidden; margin-bottom: 18px;
  box-shadow: 0 1px 8px rgba(0,0,0,.06);
}
.fd-pincode-header {
  display: flex; align-items: center; gap: 8px;
  padding: 9px 14px; color: #fff; font-weight: 700; font-size: .9em;
}
.fd-pincode-body { padding: 14px 16px; background: #fff; }
.fd-pincode-label { font-weight: 700; font-size: .95em; margin: 0 0 12px; }
.fd-pincode-input-row {
  display: flex; gap: 8px; align-items: center;
}
.fd-pin-input {
  flex: 1; height: 38px; border: 1px solid #ccc; border-radius: 6px;
  padding: 0 10px; font-size: .95em; outline: none;
}
.fd-pin-input:focus { border-color: var(--fd-primary); }
.fd-pin-check-btn {
  height: 38px; padding: 0 18px; border: none; border-radius: 6px;
  color: #fff; font-weight: 700; font-size: .9em; cursor: pointer;
  white-space: nowrap;
}
.fd-pin-result { margin: 8px 0 0; font-size: .88em; min-height: 20px; }
.fd-pin-ok { color: #0a6e0a; }
.fd-pin-err { color: #c00; }

.fd-offers {
  background: rgba(248, 167, 27, 0.06);
  border: 2px solid var(--fd-primary, #f3a222);
  border-radius: 20px; padding: 16px; margin-bottom: 18px;
}
.fd-offers-header { font-size: 1em; margin-bottom: 12px; line-height: 1.4; }
.fd-offers-sub { display: block; font-size: .9em; margin-top: 4px; }
.fd-offer-card {
  background: #fff; border-radius: 10px; overflow: hidden;
  margin-bottom: 10px;
  border-bottom: 1px solid var(--fd-primary, #f3a222);
}
.fd-offer-card:last-child { margin-bottom: 0; }
.fd-offer-card-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 9px 12px; font-weight: 600; font-size: .88em;
}
.fd-offer-badge {
  font-size: .78em; font-weight: 500;
  background: rgba(0,0,0,.08); padding: 2px 8px; border-radius: 20px;
}
.fd-offer-desc { padding: 8px 12px; margin: 0; font-size: .88em; font-weight: 500; }

.fd-usp-strip {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 10px; margin-bottom: 16px; text-align: center;
}
.fd-usp-item { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: .78em; font-weight: 600; }
.fd-usp-item img { width: 56px; height: 56px; object-fit: contain; image-rendering: -webkit-optimize-contrast; }
.fd-usp-icon-placeholder { width: 56px; height: 56px; border-radius: 50%; background: var(--fd-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.4em; }

.fd-ingredient-icons {
  display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px;
}
.fd-ingr-item { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: .72em; font-weight: 600; width: 68px; text-align: center; }
.fd-ingr-item img { width: 62px; height: 62px; object-fit: contain; image-rendering: -webkit-optimize-contrast; }

.fd-variant-card:focus-visible,
.fd-thumb:focus-visible,
.fd-btn:focus-visible {
  outline: 3px solid var(--fd-primary);
  outline-offset: 2px;
}

@media (max-width: 1024px) and (min-width: 768px) {
  .fd-product-layout { gap: 24px; }
}

@media (prefers-reduced-motion: reduce) {
  .fd-hero-img, .fd-btn, .fd-thumb, .fd-variant-card { transition: none; }
}

