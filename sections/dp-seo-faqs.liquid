      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom (Desktop)",
        "default": 60,
        "min": 20,
        "max": 120,
        "step": 5,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Padding Top (Mobile)",
        "default": 40,
        "min": 10,
        "max": 80,
        "step": 5,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Padding Bottom (Mobile)",
        "default": 40,
        "min": 10,
        "max": 80,
        "step": 5,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "faq",
        "name": "FAQ Accordion Item",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question",
            "default": "Which oil is used in this Homemade Pickle?"
          },
          {
            "type": "richtext",
            "id": "answer",
