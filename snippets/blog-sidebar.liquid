<!-- /snippets/blog-sidebar.liquid -->
<div id="js-stickySidebar" class="col-xs-12 col-sm-12 col-md-3 col-lg-3 sidebar js-sidebar-mobile-content sidebar-right ps-container dp-sticky-sidebar-wrapper">
  <div class="dp-sticky-sidebar-inner">
    
    <!-- WIDGET 1: OUR DYNAMIC PRODUCTS -->
    <div class="dp-sidebar-widget dp-sidebar-widget--products">
      <div class="dp-widget-title-wrap">
        <span class="dp-widget-icon">🫙</span>
        <h3 class="dp-widget-title">Our Pickles & Products</h3>
      </div>
      <div class="dp-sidebar-products-list">
        {% assign sidebar_collection = collections['all'] %}
        {% if sidebar_collection.products.size > 0 %}
          {% for product in sidebar_collection.products limit: 5 %}
            <div class="dp-product-mini-card">
              <div class="dp-product-mini-card__img">
                <a href="{{ product.url }}">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy">
                  {% else %}
                    <div class="dp-product-mini-card__placeholder">🫙</div>
                  {% endif %}
                </a>
                {% if product.compare_at_price > product.price %}
                  <span class="dp-mini-badge">Sale</span>
                {% elsif forloop.first %}
                  <span class="dp-mini-badge">Bestseller</span>
                {% endif %}
              </div>
              <div class="dp-product-mini-card__info">
                <h4><a href="{{ product.url }}">{{ product.title }}</a></h4>
                <div class="dp-product-price">
                  <span class="dp-price-current">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="dp-price-old">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
                <a href="{{ product.url }}" class="dp-mini-buy-btn">Buy Now →</a>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- FALLBACK PRODUCTS -->
          <div class="dp-product-mini-card">
            <div class="dp-product-mini-card__img">
              <a href="/collections/all">
                <img src="https://images.unsplash.com/photo-1610057099443-fde8c4d50f91?auto=format&fit=crop&w=200&q=80" alt="Rajapuri Raw Mango Pickle">
              </a>
              <span class="dp-mini-badge">Bestseller</span>
            </div>
            <div class="dp-product-mini-card__info">
              <h4><a href="/collections/all">Rajapuri Mango Achar</a></h4>
              <div class="dp-product-price">
                <span class="dp-price-current">₹299</span>
                <span class="dp-price-old">₹350</span>
              </div>
              <a href="/collections/all" class="dp-mini-buy-btn">Buy Now →</a>
            </div>
          </div>

          <div class="dp-product-mini-card">
            <div class="dp-product-mini-card__img">
              <a href="/collections/all">
                <img src="https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=200&q=80" alt="Stuffed Red Chilli Pickle">
              </a>
            </div>
            <div class="dp-product-mini-card__info">
              <h4><a href="/collections/all">Stuffed Red Chilli Achar</a></h4>
              <div class="dp-product-price">
                <span class="dp-price-current">₹349</span>
                <span class="dp-price-old">₹399</span>
              </div>
              <a href="/collections/all" class="dp-mini-buy-btn">Buy Now →</a>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- WIDGET 2: DYNAMIC STORE CATEGORIES -->
    <div class="dp-sidebar-widget dp-sidebar-widget--categories">
      <div class="dp-widget-title-wrap">
        <span class="dp-widget-icon">📂</span>
        <h3 class="dp-widget-title">Categories</h3>
      </div>
      <ul class="dp-category-list">
        {% assign sidebar_core_cats = "Heritage Recipes,Health & Spices,Buying Guides,Pickle Pairings,Artisanal Craft" | split: "," %}
        {% for cat_item in sidebar_core_cats %}
          {% assign cat_clean = cat_item | strip %}
          {% assign cat_lower = cat_clean | downcase %}
          {% assign cat_count = 0 %}
          {% for art in blog.articles %}
            {% if art.tags contains cat_clean %}
              {% assign cat_count = cat_count | plus: 1 %}
            {% endif %}
          {% endfor %}
          <li>
            <a href="{{ blog.url }}/tagged/{{ cat_clean | handle }}">
              <span>{% if cat_lower contains 'heritage' %}🥭{% elsif cat_lower contains 'health' %}🌶️{% elsif cat_lower contains 'buy' %}🛒{% elsif cat_lower contains 'pair' %}🍱{% else %}🫙{% endif %} {{ cat_clean }}</span>
              <span class="dp-cat-count">({{ cat_count }})</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <!-- WIDGET 3: BLOG POST TOPICS -->
    <div class="dp-sidebar-widget dp-sidebar-widget--topics">
      <div class="dp-widget-title-wrap">
        <span class="dp-widget-icon">📝</span>
        <h3 class="dp-widget-title">Blog Topics</h3>
      </div>
      <ul class="dp-recent-topics-list">
        {% if blog.articles.size > 0 %}
          {% for article in blog.articles limit: 6 %}
            <li>
              <span class="dp-topic-tag">{{ article.tags.first | default: "Recipe" }}</span>
              <a href="{{ article.url }}">{{ article.title }}</a>
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>

    <!-- WIDGET 4: POPULAR KEYWORDS / TAG CLOUD -->
    <div class="dp-sidebar-widget dp-sidebar-widget--tags">
      <div class="dp-widget-title-wrap">
        <span class="dp-widget-icon">🏷️</span>
        <h3 class="dp-widget-title">Focus Keywords</h3>
      </div>
      <div class="dp-keywords-cloud dp-keywords-cloud--collapsed">
        {% if blog.all_tags.size > 0 %}
          {% assign categories_filter = "Heritage Recipes,Health & Spices,Buying Guides,Pickle Pairings,Artisanal Craft" %}
          {% for tag in blog.all_tags %}
            {% assign tag_clean = tag | strip %}
            {% unless categories_filter contains tag_clean %}
              {% assign is_current_tag = false %}
              {% if article.tags contains tag_clean %}
                {% assign is_current_tag = true %}
              {% endif %}
              <a href="{{ blog.url }}/tagged/{{ tag_clean | handle }}" class="dp-tag-pill {% if is_current_tag %}active{% endif %}">#{{ tag_clean }}</a>
            {% endunless %}
          {% endfor %}
        {% endif %}
      </div>
      <button type="button" class="dp-show-more-tags-btn" onclick="toggleDpKeywords()">
        <span class="dp-btn-text">+ Show More Keywords</span>
        <span class="dp-btn-arrow">↓</span>
      </button>
    </div>

  </div>
</div>

