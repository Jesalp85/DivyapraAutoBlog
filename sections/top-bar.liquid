<style>
.topbar {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-bottom: 1px solid;
}

.announcement-bar {
  position: relative;
  width: 100%;
}

.announcement-marquee {
  overflow: hidden;
  white-space: nowrap;
  width: 100%;
}

.announcement-marquee__track {
  display: inline-block;
  white-space: nowrap;
  animation: scrollTop var(--scroll-speed, 15s) linear infinite;
}

.announcement-item {
  display: inline-block;
  padding: 10px 20px;
  font-size: 14px;
}

.announcement-link {
  color: inherit;
  text-decoration: none;
  margin-left: 5px;
  padding: 3px 8px;
  border-radius: 3px;
  background: rgba(255,255,255,0.1);
}

.announcement-link:hover {
  text-decoration: underline;
}

.announcement-separator {
  display: inline-block;
  padding: 0 5px;
}

.btn-close {
  position: absolute;
  right: 15px;
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 5px;
  background: rgba(0,0,0,0.5);
  padding: 2px 8px;
  border-radius: 20px;
  font-size: 12px;
}

.parent-close {
  position: relative;
}

@keyframes scrollTop {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* Double the content for seamless scroll */
.announcement-marquee__track {
  animation: scrollTop var(--scroll-speed, 15s) linear infinite;
}

/* Hover pause */
.announcement-marquee:hover .announcement-marquee__track {
  animation-play-state: paused;
}

/* Mobile */
@media (max-width: 767px) {
  .topbar.hide-mobile {
    display: none;
  }
  
  .announcement-item {
    font-size: 11px;
    padding: 8px 12px;
  }
  
  .btn-close {
    right: 5px;
    padding: 2px 5px;
    font-size: 10px;
  }
}

.banner-top {
  width: 100%;
  overflow: hidden;
}

.banner-top img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.placeholder-svg {
  width: 100%;
  height: auto;
  background: #f5f5f5;
}
</style>

{% javascript %}
(function() {
  // Set scroll speed
  var marquee = document.querySelector('.announcement-marquee');
  if (marquee) {
    var speed = marquee.getAttribute('data-scroll-speed');
    if (speed) {
      marquee.style.setProperty('--scroll-speed', speed + 's');
    } else {
      marquee.style.setProperty('--scroll-speed', '15s');
    }
  }
  
  // Double the content for seamless scroll
  var track = document.querySelector('.announcement-marquee__track');
  if (track) {
    var content = track.innerHTML;
    track.innerHTML = content + content;
  }
  
  // Close button
  var closeBtn = document.querySelector('.btn-close');
  if (closeBtn) {
    closeBtn.addEventListener('click', function() {
      var topbar = this.closest('.topbar');
      if (topbar) {
        topbar.style.display = 'none';
      }
    });
  }
})();
{% endjavascript %}