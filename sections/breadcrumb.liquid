{% comment %} {% include 'breadcrumb' %}
{% style %}
  .breadcrumbs{
         {% if section.settings.bg_breadcrumb_blog != blank %}
         	background-image: url('{{ section.settings.bg_breadcrumb_blog | img_url:"1920x"}}');
         {% endif %}
         margin-bottom:{{section.settings.mg_bottom}}px !important;
         background-color:{{section.settings.bg}};
  }
  .breadcrumbs .outline-breadcrum .wrap-breadcrum{
  	height:{{section.settings.b_height}}px !important;
  }
  
  /* Desktop Title Styles - Sab pe !important lagaya gaya hai */
  .breadcrumbs .outline-breadcrum .wrap-breadcrum h1,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum h2,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum h3,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .page-title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .section-title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .breadcrumb-title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum [class*="title"],
  .breadcrumbs .outline-breadcrum .wrap-breadcrum span,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum div,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum p,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum strong,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum b {
    font-size: {{ section.settings.title_font_size }}px !important;
    font-weight: {{ section.settings.title_font_weight_value }} !important;
    text-transform: {{ section.settings.title_text_transform }} !important;
    letter-spacing: {{ section.settings.title_letter_spacing }}px !important;
    line-height: 1.3 !important;
  }
  
  /* Title Color with !important */
  .breadcrumbs .outline-breadcrum .wrap-breadcrum h1,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum h2,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum h3,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .page-title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .section-title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum .breadcrumb-title,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum [class*="title"],
  .breadcrumbs .outline-breadcrum .wrap-breadcrum span,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum div,
  .breadcrumbs .outline-breadcrum .wrap-breadcrum p {
    color: {{ section.settings.title_color }} !important;
  }
  
  /* Mobile Title Styles with !important */
  @media (max-width: 768px) {
    .breadcrumbs .outline-breadcrum .wrap-breadcrum h1,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum h2,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum h3,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum .page-title,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum .title,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum .section-title,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum .breadcrumb-title,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum [class*="title"],
    .breadcrumbs .outline-breadcrum .wrap-breadcrum span,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum div,
    .breadcrumbs .outline-breadcrum .wrap-breadcrum p {
      font-size: {{ section.settings.mobile_title_font_size }}px !important;
    }
  }
  
  @media (max-width: 1024px) {
    .breadcrumbs{
      background: {{section.settings.mobile_bg}} !important;
      margin-bottom:{{section.settings.mobile_mg_bottom}}px !important;
    }
    .breadcrumbs .outline-breadcrum .wrap-breadcrum{
      height:{{section.settings.mobile_ht}}px !important;
    }
