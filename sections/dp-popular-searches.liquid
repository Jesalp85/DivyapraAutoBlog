{%- assign sid = section.id -%}

<section id="laber_{{ sid }}" class="dp-popular-searches-section">
  <div class="container">
    <div class="dp-ps-header-wrap">
      <div class="dp-ps-heading align-{{ section.settings.title_alignment }}">
        <span class="dp-ps-tag-label">SEO SEARCH HUB</span>
        <h3 class="dp-ps-title">{{ section.settings.title | default: "POPULAR SEARCHES" | escape }}</h3>
      </div>
      <span class="dp-ps-badge">85+ Topics</span>
    </div>

    <!-- Category Filter Tabs -->
    <div class="dp-ps-tabs">
      <button type="button" class="dp-ps-tab active" data-category="all">🔥 All Topics</button>
      <button type="button" class="dp-ps-tab" data-category="mango">🥭 Raw Mango Achar</button>
      <button type="button" class="dp-ps-tab" data-category="sweet">🍯 Sweet & Jaggery</button>
      <button type="button" class="dp-ps-tab" data-category="gujarati">🫙 Gujarati Heritage</button>
      <button type="button" class="dp-ps-tab" data-category="regional">📍 Regional Buyers</button>
      <button type="button" class="dp-ps-tab" data-category="general">🛒 All Collections</button>
    </div>

    <!-- Tags Cloud Grid -->
    <div class="dp-ps-tags-container style-pills" id="dp_ps_tags_grid_{{ sid }}">
      {%- liquid
        assign hide_inactive = section.settings.hide_inactive_products | default: true
        assign hide_out_of_stock = section.settings.hide_out_of_stock | default: false
      -%}

      {%- comment -%} Editor Blocks (linking ONLY to verified products or collections) {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.keyword != blank -%}
            {%- liquid
              assign show_tag = true
              assign tag_link = block.settings.link
              assign tag_cat = block.settings.category | default: 'all'
              
              # Safeguard: Never allow /blogs/ links
              assign link_str = tag_link | downcase
              if link_str contains 'blogs/'
                assign show_tag = false
              endif
            -%}
            
            {%- if show_tag -%}
              <div class="dp-ps-tag-item" data-category="{{ tag_cat }}" {{ block.shopify_attributes }}>
                <a href="{{ tag_link | default: '/collections/all-products' }}" class="dp-ps-tag-link">
                  {{ block.settings.keyword | escape }}
                </a>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Toggle Show All Button -->
    <div class="dp-ps-toggle-wrap">
      <button type="button" id="dp_ps_toggle_btn_{{ sid }}" class="dp-ps-toggle-btn">
        <span class="dp-btn-text">Show All 85+ Keywords</span>
        <span class="dp-btn-icon">👇</span>
      </button>
    </div>
  </div>
</section>

{%- style -%}
/* ========================================================
   DIVYA PRABHA FOODS — ELEGANT POPULAR SEARCHES SECTION
   ======================================================== */

#laber_{{ sid }} {
  background: #fdf8f3;
  padding: 42px 0 38px;
  margin: 24px 0;
  border-top: 1px solid #ebd9c8;
  border-bottom: 1px solid #ebd9c8;
  font-family: inherit;
}

.dp-popular-searches-section .container {
  max-width: 1320px;
  margin: 0 auto;
  padding: 0 24px;
}

.dp-ps-header-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  flex-wrap: wrap;
  gap: 12px;
}

.dp-ps-tag-label {
  display: block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  color: #b01215;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.dp-ps-title {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 0.5px;
  color: #2d1206;
  margin: 0;
}

.dp-ps-badge {
  background: #3d1f0f;
  color: #e5a842;
  font-size: 12px;
  font-weight: 800;
  padding: 6px 14px;
  border-radius: 50px;
  border: 1px solid rgba(229, 168, 66, 0.4);
  letter-spacing: 0.5px;
}

/* Category Tabs */
.dp-ps-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 22px;
  padding-bottom: 14px;
  border-bottom: 1px dashed #e6d2c1;
}

.dp-ps-tab {
  background: #ffffff;
  color: #5c3e2e;
  border: 1px solid #e2d1c0;
  padding: 7px 16px;
  border-radius: 30px;
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
}

.dp-ps-tab:hover,
.dp-ps-tab.active {
  background: #3d1f0f;
  color: #ffffff;
  border-color: #3d1f0f;
  box-shadow: 0 4px 10px rgba(61, 31, 15, 0.15);
}

/* Tags Container */
.dp-ps-tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  max-height: 142px; /* Default collapsed height */
  overflow: hidden;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.dp-ps-tags-container.expanded {
  max-height: 2500px;
}

.dp-ps-tag-item {
  display: inline-block;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.dp-ps-tag-item.hidden {
  display: none !important;
}

.dp-ps-tag-link {
  background: #ffffff;
  color: #4a2e1e;
  border: 1px solid #e5d4c3;
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  display: inline-block;
  line-height: 1.3;
  transition: all 0.2s ease;
}

.dp-ps-tag-link:hover {
  background: #b01215;
  color: #ffffff;
  border-color: #b01215;
  transform: translateY(-2px);
  box-shadow: 0 6px 14px rgba(176, 18, 21, 0.18);
}

/* Toggle Expand Button */
.dp-ps-toggle-wrap {
  text-align: center;
  margin-top: 24px;
}

.dp-ps-toggle-btn {
  background: #ffffff;
  color: #b01215;
  border: 1.5px solid #b01215;
  padding: 10px 24px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.25s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.dp-ps-toggle-btn:hover {
  background: #b01215;
  color: #ffffff;
  box-shadow: 0 6px 16px rgba(176, 18, 21, 0.2);
}

@media (max-width: 768px) {
  #laber_{{ sid }} { padding: 24px 0 20px; overflow-x: hidden; }
  .dp-ps-header-wrap { flex-direction: column; align-items: flex-start; gap: 6px; }
  .dp-ps-title { font-size: 17px; }
  .dp-ps-tabs { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 10px; -webkit-overflow-scrolling: touch; scrollbar-width: none; width: 100%; }
  .dp-ps-tabs::-webkit-scrollbar { display: none; }
  .dp-ps-tab { flex-shrink: 0; font-size: 11.5px; padding: 6px 12px; }
  .dp-ps-tag-link { font-size: 12px; padding: 6px 12px; white-space: normal; word-break: break-word; }
  .dp-ps-tags-container { max-height: 180px; gap: 8px; }
}
{%- endstyle -%}

<script>
document.addEventListener("DOMContentLoaded", function() {
  var sid = "{{ sid }}";
  var grid = document.getElementById("dp_ps_tags_grid_" + sid);
  var toggleBtn = document.getElementById("dp_ps_toggle_btn_" + sid);
  var tabs = document.querySelectorAll("#laber_" + sid + " .dp-ps-tab");

  if (toggleBtn && grid) {
    toggleBtn.addEventListener("click", function() {
      if (grid.classList.contains("expanded")) {
        grid.classList.remove("expanded");
        toggleBtn.querySelector(".dp-btn-text").textContent = "Show All 85+ Keywords";
        toggleBtn.querySelector(".dp-btn-icon").textContent = "👇";
      } else {
        grid.classList.add("expanded");
        toggleBtn.querySelector(".dp-btn-text").textContent = "Show Less";
        toggleBtn.querySelector(".dp-btn-icon").textContent = "👆";
      }
    });
  }

  if (tabs.length > 0 && grid) {
    tabs.forEach(function(tab) {
      tab.addEventListener("click", function() {
        tabs.forEach(function(t) { t.classList.remove("active"); });
        tab.classList.add("active");
        var cat = tab.getAttribute("data-category");
        var items = grid.querySelectorAll(".dp-ps-tag-item");
        items.forEach(function(item) {
          if (cat === "all" || item.getAttribute("data-category") === cat) {
            item.classList.remove("hidden");
          } else {
            item.classList.add("hidden");
          }
        });
        // Auto expand grid when filtering
        grid.classList.add("expanded");
        if (toggleBtn) {
          toggleBtn.querySelector(".dp-btn-text").textContent = "Show Less";
          toggleBtn.querySelector(".dp-btn-icon").textContent = "👆";
        }
      });
    });
  }
});
</script>

{% schema %}
{
  "name": "DP Popular Searches",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "POPULAR SEARCHES"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "keyword_link",
      "name": "Keyword Tag",
      "settings": [
        {
          "type": "text",
          "id": "keyword",
          "label": "Keyword Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Store Product/Collection URL (NO blogs)"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category Filter",
          "options": [
            { "value": "mango", "label": "Raw Mango Achar" },
            { "value": "sweet", "label": "Sweet & Jaggery" },
            { "value": "gujarati", "label": "Gujarati Heritage" },
            { "value": "regional", "label": "Regional Buyers" },
            { "value": "spices", "label": "Spices & Masala" },
            { "value": "general", "label": "All Collections" }
          ],
          "default": "mango"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DP Popular Searches"
    }
  ]
}
{% endschema %}
